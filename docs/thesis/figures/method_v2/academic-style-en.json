{
  "version": 3,
  "geometry": {
    "single_column_width_mm": 85.0,
    "double_column_width_mm": 178.0,
    "single_column_range_mm": [
      82.0,
      90.0
    ],
    "double_column_range_mm": [
      170.0,
      180.0
    ],
    "require_canvas_boundary": true,
    "default_canvas": {
      "single": [
        560.0,
        420.0
      ],
      "double": [
        1080.0,
        480.0
      ]
    }
  },
  "typography": {
    "primary_family": "Arial",
    "allowed_families": [
      "Arial",
      "Helvetica",
      "sans-serif"
    ],
    "monospace_families": [
      "SFMono-Regular",
      "Menlo",
      "Consolas",
      "monospace"
    ],
    "minimum_final_text_pt": 7.0,
    "minimum_panel_label_pt": 8.0,
    "minimum_text_contrast_ratio": 4.5,
    "preferred_body_pt": [
      8.0,
      9.0
    ],
    "preferred_panel_label_pt": [
      9.0,
      10.0
    ],
    "maximum_visible_type_sizes": 3,
    "monospace_only_for_code": true
  },
  "stroke": {
    "minimum_supporting_pt": 0.8,
    "primary_range_pt": [
      1.0,
      1.4
    ],
    "maximum_emphasis_pt": 1.6
  },
  "color": {
    "maximum_semantic_hues": 5,
    "require_rrggbb_notation": true,
    "paper_palette_schema_version": 1,
    "require_frozen_paper_palette_for_multi_figure_work": true,
    "forbid_per_figure_drift_when_paper_palette_is_bound": true,
    "require_palette_id_and_sha256_when_bound": true,
    "palette": {
      "canvas": "#FFFFFF",
      "ink": "#172033",
      "muted": "#5B6472",
      "stroke": "#CBD5E1",
      "neutral": "#64748B",
      "accent": "#2563EB",
      "secondary": "#7C3AED",
      "success": "#15803D",
      "warning": "#B45309",
      "danger": "#B91C1C"
    }
  },
  "icons": {
    "maximum_families": 1,
    "maximum_per_node": 1,
    "require_square_geometry": true,
    "size_fraction_of_node_height": [
      0.2,
      0.32
    ],
    "require_vector": true,
    "require_embedded_drawio_data_uri": true,
    "require_source_manifest": true
  },
  "effects": {
    "allow_gradient": false,
    "allow_shadow": false,
    "allow_glass": false,
    "allow_comic": false,
    "allow_three_dimensional": false,
    "allow_animation_in_submission": false,
    "allow_dark_background": false,
    "allow_emoji": false,
    "allow_raster_image_cells": false
  },
  "export": {
    "vector_masters": [
      "svg",
      "pdf"
    ],
    "review_raster": "png",
    "minimum_png_dpi": 300,
    "final_border_px": 0,
    "require_accessible_svg_metadata": true
  }
}
