{
  "name": "hetsa_lora_depth_v1",
  "stage": "capability_and_serving",
  "dataset": {
    "name": "AG_NEWS",
    "format": "named_tsv",
    "train_file": "data/AG_NEWS/train.tsv",
    "dev_file": "data/AG_NEWS/dev.tsv",
    "text_columns": [
      "title",
      "description"
    ],
    "label_column": "label",
    "model": "bert-base-uncased",
    "local_files_only": true,
    "num_labels": 4,
    "max_length": 96,
    "eval_samples": 7600,
    "proxy_source": "train",
    "proxy_split_seed": 20260728,
    "round_eval_samples": 1024,
    "eval_monitor_seed": 20260728,
    "metric": "accuracy",
    "secondary_metric": "macro_f1"
  },
  "data_heterogeneity": {
    "mode": "constrained_dirichlet_label_skew",
    "alpha": 0.3,
    "samples_per_client_fixed": true,
