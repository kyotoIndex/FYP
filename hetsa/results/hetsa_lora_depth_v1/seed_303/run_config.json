    "rounds": 30,
    "local_epochs": 1,
    "batch_size": 16,
    "eval_batch_size": 32,
    "learning_rate": 0.001,
    "client_selection": "uniform_random_without_replacement",
    "local_holdout_fraction": 0.2
  },
  "lora": {
    "target_modules": [
      "query",
      "value"
    ],
    "rank": 16,
    "alpha": 16.0,
    "dropout": 0.1,
    "num_encoder_layers": 12
  },
  "resource_heterogeneity": {
    "capability_names": [
      "low",
      "medium",
      "high"
