{
  "name": "pcla_formal_v2_sst2_bert_base_alpha_0_3",
  "stage": "development_check",
  "protocol_version": "formal_v2_explicit_sync",
  "dataset": {
    "name": "SST-2",
    "format": "sst2_tsv",
    "train_file": "data/SST-2/train.tsv",
    "dev_file": "data/SST-2/dev.tsv",
    "num_labels": 2,
    "max_length": 64,
    "eval_samples": 256,
    "model": "bert-base-uncased",
    "local_files_only": true,
    "proxy_source": "train",
    "proxy_split_seed": 20260728,
    "metric": "accuracy",
    "secondary_metric": "macro_f1"
  },
  "data_heterogeneity": {
    "mode": "constrained_dirichlet_label_skew",
    "alpha": 0.3,
    "samples_per_client_fixed": true,
    "preserve_global_label_distribution": true,
    "sample_reuse": false
  },
  "federated": {
    "seeds": [
      7
    ],
    "total_clients": 10,
    "selected_clients": 5,
    "samples_per_client": 64,
    "rounds": 2,
    "local_epochs": 1,
    "batch_size": 16,
    "eval_batch_size": 64,
    "learning_rate": 0.001,
    "client_selection": "uniform_random_without_replacement"
  },
  "lora": {
    "target_modules": [
      "query",
      "value"
    ],
    "rank": 16,
    "alpha": 16.0,
    "dropout": 0.1,
    "num_encoder_layers": 12,
    "total_rank_budget": 192
  },
  "resource_heterogeneity": {
    "capability_names": [
      "low",
      "medium",
      "high"
    ],
    "layer_fractions": [
      0.5,
      0.75,
      1.0
    ],
    "client_ratio": [
      0.6,
      0.3,
      0.1
    ],
    "compute_factors": [
      1.8,
      1.2,
      0.7
    ],
    "communication_factors": [
      1.3,
      1.0,
      0.8
    ],
    "communication_time_per_mb": 1.5
  },
  "communication_protocol": {
    "version": "explicit_component_sync_v2",
    "backbone_cached_on_client": true,
    "layer_method_download": "active_lora_and_classifier",
    "layer_method_upload": "active_lora_and_classifier",
    "component_method_download": "selected_A_and_B_components_and_classifier",
    "component_method_upload": "trained_factor_components_and_classifier",
    "importance_refresh_download": "full_current_lora_adapter_and_classifier"
  },
  "fedhello": {
    "importance_score": "fim_gradient_norm",
    "importance_source": "server_proxy",
    "proxy_samples": 128,
    "proxy_batch_size": 16,
    "proxy_batches": 1,
    "allocation": "probability_clustered_sampling_without_replacement",
    "random_seeded_allocation": true,
    "resource_levels_sorted_ascending": true,
    "rgd_pattern": "bottleneck",
    "rgd_hla_rounds": 1,
    "fim_update_interval": 1,
    "combined_schedule": "rgd_then_periodic_fim"
  },
  "pcla_component": {
    "components_per_layer": 8,
    "importance_refresh_interval": 3,
    "importance_ema": 0.8,
    "importance_batch_size": 16,
    "importance_batches_per_client": 1,
    "exploration_beta": 0.5,
    "freshness_gamma": 0.05,
    "stability_delta": 0.0,
    "importance_overhead_in_time": true,
    "frozen_factor_cached_on_client": false
  },
  "baselines": [
    "fedlora",
    "fedhello",
    "random_component_alternating",
    "pcla_component_alternating"
  ],
  "full_layer_methods": [
    "fedlora"
  ],
  "metrics": [
    "accuracy",
    "macro_f1",
    "round_time",
    "cumulative_time",
    "round_comm_mb",
    "cumulative_comm_mb",
    "avg_waiting_time",
    "trainable_parameters_per_client",
    "download_parameters",
    "upload_parameters",
    "importance_sync_parameters",
    "importance_overhead_seconds",
    "selection_coverage",
    "selection_stability"
  ],
  "target_accuracy": 0.8,
  "output_dir": "results/_development/formal_v2_sst2_bert_base",
