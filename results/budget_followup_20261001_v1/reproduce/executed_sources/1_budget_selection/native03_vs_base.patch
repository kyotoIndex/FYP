+def test_failure_after_upload_retries_without_refunding_wire(tmp_path, monkeypatch):
+    import json
+    import pcla_research_v7.runtime as runtime
+    model, _, clients, capacities, evaluation = fixture(53)
+    actual_evaluate = runtime.evaluate
+    calls = 0
+    def fail_after_upload(*args, **kwargs):
+        nonlocal calls
+        calls += 1
+        if calls == 2:
+            raise RuntimeError("injected evaluation failure")
+        return actual_evaluate(*args, **kwargs)
+    monkeypatch.setattr(runtime, "evaluate", fail_after_upload)
+    with pytest.raises(RuntimeError, match="injected evaluation failure"):
+        run_experiment(model, clients, evaluation, capacities, _job(), _config(),
+                       tmp_path, {"evaluation_role": "synthetic"})
+    pending = json.loads((tmp_path / "communication_journal.json").read_text())["entries"][0]
+    assert pending["phase"] == "upload_started_conservative"
+    sent = sum(event["bytes"] for event in pending["sent_events"])
+    assert sent > 0 and any(e["direction"] == "upload" for e in pending["sent_events"])
+
+    monkeypatch.setattr(runtime, "evaluate", actual_evaluate)
+    model2, _, clients2, capacities2, evaluation2 = fixture(53)
+    run_experiment(model2, clients2, evaluation2, capacities2, _job(), _config(),
+                   tmp_path, {"evaluation_role": "synthetic"})
+    ck = _load_checkpoint(tmp_path / "latest.pt")
+    events = ck["cache"]["events"]
+    assert sum(e["bytes"] for e in events if e["event_id"].startswith("failed:")) == sent
+    assert len({e["event_id"] for e in events}) == len(events)
+    assert ck["deployed_bytes"] == sum(e["bytes"] for e in events)
