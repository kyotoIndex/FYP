+def test_checkpoint_then_journal_close_failure_does_not_charge_twice(tmp_path, monkeypatch):
+    import json
+    import pcla_research_v7.runtime as runtime
+    model, _, clients, capacities, evaluation = fixture(59)
+    actual_json = runtime.atomic_json
+    failed = False
+    def fail_close(path, value):
+        nonlocal failed
+        if (path.name == "communication_journal.json" and not failed and
+                value["entries"] and value["entries"][-1]["status"] == "committed"):
+            failed = True
+            raise RuntimeError("injected journal close failure")
+        return actual_json(path, value)
+    monkeypatch.setattr(runtime, "atomic_json", fail_close)
+    with pytest.raises(RuntimeError, match="injected journal close failure"):
+        run_experiment(model, clients, evaluation, capacities, _job(), _config(),
+                       tmp_path, {"evaluation_role": "synthetic"})
+    first = _load_checkpoint(tmp_path / "latest.pt")
+    assert first["round"] == 1
+    monkeypatch.setattr(runtime, "atomic_json", actual_json)
+    model2, _, clients2, capacities2, evaluation2 = fixture(59)
+    run_experiment(model2, clients2, evaluation2, capacities2, _job(), _config(),
+                   tmp_path, {"evaluation_role": "synthetic"})
+    ck = _load_checkpoint(tmp_path / "latest.pt")
+    journal = json.loads((tmp_path / "communication_journal.json").read_text())
+    assert journal["entries"][0]["status"] == "committed"
+    assert not any(e["event_id"].startswith("failed:") for e in ck["cache"]["events"])
+    assert ck["deployed_bytes"] == sum(e["bytes"] for e in ck["cache"]["events"])
