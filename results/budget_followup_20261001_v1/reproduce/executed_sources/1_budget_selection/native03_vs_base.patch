+class FedSBLinear(nn.Module):
+    """Frozen base/A/B with one r×r trainable latent map."""
+    def __init__(self, base: nn.Linear, a: Tensor, b: Tensor, r: Tensor,
+                 *, scaling=1.0, dropout=0.1):
