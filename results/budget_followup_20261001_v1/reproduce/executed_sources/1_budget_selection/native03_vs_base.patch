+        representation="N", period=1, factor="b", cache={})
+    config = {**_config(bound), "probe_batch_size": 8}
+    real_probe = bridge.probe_full_gradients
+    def failed_probe(*args, **kwargs):
+        raise RuntimeError("injected probe failure")
+    monkeypatch.setattr(bridge, "probe_full_gradients", failed_probe)
+    with pytest.raises(RuntimeError, match="injected probe failure"):
