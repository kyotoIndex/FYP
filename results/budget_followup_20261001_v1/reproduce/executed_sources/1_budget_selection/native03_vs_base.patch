+def test_probe_failure_after_j_broadcast_is_charged_on_resume(tmp_path, monkeypatch):
+    import json
+    import random
+    import pcla_research_v7.cohort_runtime as bridge
+    model, _, clients, capacities, evaluation = fixture(47)
