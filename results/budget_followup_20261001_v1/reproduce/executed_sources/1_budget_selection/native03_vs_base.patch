+    assert all(event["event_id"].endswith(":coord_parent") for event in pending["sent_events"])
+    sent = sum(event["bytes"] for event in pending["sent_events"])
+
+    monkeypatch.setattr(bridge, "probe_full_gradients", real_probe)
+    model2, _, clients2, capacities2, evaluation2 = fixture(47)
+    clients2 = {cid: TinyDataset(300 + cid, 32) for cid in clients2}
+    run_experiment(model2, clients2, evaluation2, capacities2, job, config,
+                   tmp_path, {"evaluation_role": "synthetic"})
+    ck = _load_checkpoint(tmp_path / "latest.pt")
+    events = ck["cache"]["events"]
+    assert sum(e["bytes"] for e in events if e["event_id"].startswith("failed:")) == sent
+    assert sum(e["bytes"] for e in events if e["bucket"] == "deployed_prefix") == ck["deployed_bytes"]
+    assert ck["deployed_bytes"] == sent
+    assert ck["budget_stop_round"] == 0  # recovered charge forces fresh admission denial
+    assert ck["diagnostic_bytes"] > 0
+    assert len({e["event_id"] for e in events}) == len(events)
