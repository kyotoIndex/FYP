+#!/usr/bin/env python3
+"""Audit completed D0 executions and atomically attach audit receipts to the queue."""
+import argparse,json,subprocess,sys,time
+from pathlib import Path
+from dispatch_pcla_v7 import lock,read,write,sha
+p=argparse.ArgumentParser();p.add_argument('--root',type=Path,required=True);p.add_argument('--ids',nargs='*');p.add_argument('--limit',type=int,default=24)
+a=p.parse_args();auditor=Path(__file__).with_name('audit_pcla_v7_run.py');code_sha=sha(auditor)
+with lock(a.root/'queue'):
+ items=[(p,read(p)) for p in sorted((a.root/'queue/jobs').glob('*.json'))]
+items=[(p,v) for p,v in items if v['state']=='executed_pending_audit' and v['job'].get('phase')=='D0' and (not a.ids or v['job']['job_id'] in a.ids)][:a.limit]
+for path,v in items:
+ jid=v['job']['job_id'];out=a.root/'checks/audits'/f'{jid}.{code_sha[:12]}.{time.time_ns()}.json'
+ argv=[sys.executable,str(auditor),'--run',v['out'],'--config',v['config'],'--source',v['source'],'--out',str(out)]
+ proc=subprocess.run(argv,capture_output=True,text=True)
