+        raise ValueError("invalid frozen role source identities")
+    wanted = set(ids)
+    selected = {}
+    with train_file.open(encoding="utf-8", newline="") as handle:
+        reader = csv.DictReader(handle, delimiter="\t")
+        for i, row in enumerate(reader):
+            key = f"train:{i}"
+            if key in wanted:
