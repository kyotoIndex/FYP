+    temporary.replace(output)
+    meta = {"identity": identity, "identity_sha256": identity_sha,
+            "cache_sha256": hashlib.sha256(output.read_bytes()).hexdigest(),
+            "rows": len(ids), "shape": [len(ids), max_length],
+            "source_ids_sha256": digest(ids)}
