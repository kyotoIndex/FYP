+        atomic_json(out_dir / "evaluation_labels.json", zero.pop("labels"))
+        atomic_json(out_dir / "logits_round_000.json", zero.pop("logits"))
+        atomic_json(out_dir / "evaluation_round_000.json", zero)
+        half_readout = zero
