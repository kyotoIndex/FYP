+                   ("group", "group"), ("method", "method"),
+                   ("representation", "representation"), ("lr", "lr"),
+                   ("period", "period"), ("rank", "rank"), ("xi", "xi"),
+                   ("min_rounds", "min_rounds"), ("max_rounds", "max_rounds"),
+                   ("budget_id", "budget_id"), ("eval_role", "evaluation_role")):
