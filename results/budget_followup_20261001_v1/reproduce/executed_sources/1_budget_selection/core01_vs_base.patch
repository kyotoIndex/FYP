+def test_d_zero_direction_preserves_partner():
+    a = torch.eye(3)
+    b = torch.diag(torch.tensor([2., 0., 0.]))
+    result = balance_d(b, a)
+    assert result.a[1:].norm() > 0
+    torch.testing.assert_close(result.b @ result.a, b @ a)
