+    total = sum(counts.values())
+    wanted = {y: counts[y] * capacity / total for y in (0, 1)}
+    target = {y: int(wanted[y]) for y in (0, 1)}
+    for _ in range(capacity - sum(target.values())):
+        y = max((0, 1), key=lambda v: (wanted[v] - target[v], -v))
+        target[y] += 1
+    return target
