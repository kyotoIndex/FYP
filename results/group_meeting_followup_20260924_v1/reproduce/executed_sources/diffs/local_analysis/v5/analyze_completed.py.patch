+def analyze_job(root, queue, job, inv, train, verify_hash):
+    status = {"queue": queue, "id": job["id"], "stage": job["stage"], "seed": job["seed"],
+              "kind": job["kind"], "cell": cell_name(job), "state": "missing", "problems": []}
+    out = root / job["id"]
+    if not out.is_dir():
+        status["problems"].append("materialized directory absent")
+        return status, []
+    try:
+        if inv is not None:
+            require(job["id"] in inv, "inventory entry missing")
+            require(inv[job["id"]].get("state") == "completed", "inventory state is not completed")
+        for name in ("job.json", "receipt.json", "audit.json", "run/study.json", "run/status.json"):
+            require((out / name).is_file(), f"{name} absent")
+        recorded = read(out / "job.json")
+        require(recorded == job, "materialized job differs from plan")
+        receipt = read(out / "receipt.json")
+        require(receipt.get("job") == job and receipt.get("state") == "completed"
+                and receipt.get("exit_code") == 0, "receipt does not establish successful completion")
+        require(receipt.get("job_sha256") == fingerprint(job), "receipt job fingerprint differs")
+        if inv is not None:
+            require(inv[job["id"]].get("attempt") == receipt.get("attempt"), "inventory attempt differs")
+        audit = read(out / "audit.json")
+        require(audit.get("audited") is True, "audit not verified")
+        require(audit.get("audit_sources") == receipt.get("source_files"), "audit source lock differs")
+        run = out / "run"
+        raw_status = read(run / "status.json")
+        formal = job["stage"] != "S0"
+        if formal:
+            require(audit.get("complete") is True and raw_status.get("state") == "completed", "formal run incomplete")
+        else:
+            require(raw_status.get("state") in ("completed", "paused"), "technical run status invalid")
+        study = read(run / "study.json")
+        identity_checks(job, audit, study)
+        checkpoint = run / "run" / "checkpoint.pt" if job["kind"] in ("runtime_policy", "online") else run / "checkpoint.pt"
+        require(checkpoint.is_file(), "checkpoint.pt absent")
+        if verify_hash:
+            require(sha(checkpoint) == audit.get("checkpoint_sha256"), "checkpoint SHA256 differs")
+        rows = endpoint_rows(job, queue, audit, run, train) if formal else []
+        status["state"] = "validated" if formal else "technical_validated"
+        status["endpoint_count"] = len(rows)
+        status["audit_sha256"] = sha(out / "audit.json")
+        status["receipt_sha256"] = sha(out / "receipt.json")
+        if (out / "EXTRACTION_RECEIPT.json").is_file():
+            status["archive_sha256"] = read(out / "EXTRACTION_RECEIPT.json").get("archive_sha256")
+        return status, rows
+    except (OSError, KeyError, TypeError, ValueError, IndexError, ZeroDivisionError) as e:
+        status["state"] = "invalid"
+        status["problems"].append(str(e))
+        return status, []
+
