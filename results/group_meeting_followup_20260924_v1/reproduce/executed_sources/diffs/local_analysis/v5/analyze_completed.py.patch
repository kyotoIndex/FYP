+def cell_name(j):
+    jid = j["id"]
+    if j["kind"] == "personal_eval":
+        return j["source"] + ("_ft" if j.get("finetune") else "")
+    if j["kind"] == "fedex_ref":
+        return f"R_{j['partition']}_{j['agg']}"
+    if jid.startswith("D_agnews_"):
+        return jid.rsplit("_s", 1)[0]
+    if jid.startswith("L2_") or jid.startswith("V4_"):
+        return jid.rsplit("_s", 1)[0]
+    if j.get("cell"):
+        return j["cell"] if j["cell"] in ("L1", "L3", "T1", "T2", "V1", "V2", "V3", "P3", "P4") else j["mode"]
+    return jid.rsplit("_s", 1)[0]
