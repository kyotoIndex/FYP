+#!/usr/bin/env python3
+"""Read-only V5a/b/c materialization audit and paired endpoint extraction.
+
+Run on the HPC through stdin with --stdout-tar to keep the remote tree untouched:
+  ssh hpc-bnbu 'python - --base $HPC_HOME/pcla_v5_20260924 --stdout-tar' \
+    < analyze_completed.py | tar -xf - -C LOCAL_OUTPUT_DIRECTORY
+
+No scientific conclusion is made here. Missing or invalid jobs never contribute values.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import io
+import json
+import math
+import re
+import statistics
+import sys
+import tarfile
+from collections import Counter, defaultdict
+from pathlib import Path
+
+SEEDS = (7, 13, 21, 42, 87)
+EXPECTED = {"a": 73, "b": 54, "c": 70}
+TRAIN_DEFAULT = "$HPC_HOME/pcla_repair_20260918/repo/data/SST-2/train.tsv"
+V41_DEFAULT = "$HPC_HOME/pcla_aggregation_20260923_v41"
+V3_SUPPORT_DEFAULT = "$HPC_HOME/pcla_repair_20260918"
+T95 = {1: 12.7062047364, 2: 4.30265272975, 3: 3.18244630528, 4: 2.7764451052}
+FIELDS = ("queue", "job_id", "stage", "seed", "kind", "cell", "metric", "scope",
+          "round_start", "round_end", "value", "unit", "sample_identity_sha256", "status")
+
+
+def read(path):
+    with path.open(encoding="utf-8") as f:
+        return json.load(f)
+
+
+def sha(path):
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def fingerprint(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False,
+                                   separators=(",", ":"), allow_nan=False).encode()).hexdigest()
+
+
+def equal_num(a, b, atol=1e-10):
+    return isinstance(a, (int, float)) and not isinstance(a, bool) and math.isfinite(a) and math.isclose(a, b, abs_tol=atol, rel_tol=0)
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def plan_jobs(base, queue):
+    root = base / f"materialized_v5{queue}"
+    p = root / "plan.json"
+    origin = "materialized"
+    if not p.is_file():
+        p = base / f"handoff_v5{queue}" / "JOB_PLAN.json"
+        origin = "handoff_fallback"
+    require(p.is_file(), f"plan missing for v5{queue}")
+    data = read(p)
+    jobs = data["jobs"] if isinstance(data, dict) else data
+    require(isinstance(jobs, list) and len(jobs) == EXPECTED[queue], f"v5{queue} plan count differs")
+    require(len({j["id"] for j in jobs}) == EXPECTED[queue], f"v5{queue} duplicate IDs")
+    return jobs, {"path": str(p), "sha256": sha(p), "origin": origin, "count": len(jobs)}
+
+
+def inventory_entries(path):
+    if not path.is_file():
+        return None, {"path": str(path), "present": False}
+    obj = read(path)
+    if isinstance(obj, dict):
+        records = obj.get("entries", obj.get("jobs", obj.get("items", obj.get("inventory"))))
+    else:
+        records = obj
+    if isinstance(records, dict):
+        entries = records
+    elif isinstance(records, list):
+        entries = {e.get("id", e.get("job_id", e.get("job"))): e for e in records if isinstance(e, dict)}
+    else:
+        entries = None
+    return entries, {"path": str(path), "present": True, "sha256": sha(path),
+                     "entries": len(entries) if entries is not None else None,
+                     "schema": "recognized" if entries is not None else "unrecognized"}
+
+
+def identity_checks(job, audit, study):
+    ident = study.get("identity", {})
+    expected_kind = {"control": "lora_control", "online": "aggregation"}.get(job["kind"], job["kind"])
+    require(study.get("kind") == expected_kind == audit.get("kind"), "kind disagreement")
+    require(ident.get("seed") == job["seed"] == audit.get("seed"), "seed disagreement")
+    require(study.get("identity_hash") == audit.get("identity_hash"), "identity hash disagreement")
+    keys = ("mode", "policy", "dataset", "source", "rule", "refactor", "agg", "partition", "finetune")
+    for key in keys:
+        if key in job:
+            if key in audit:
+                audit_value = audit[key].get("method") if key == "refactor" and isinstance(audit[key], dict) else audit[key]
+                require(audit_value == job[key], f"{key} audit/plan disagreement")
+            if key in ident:
+                require(ident[key] == job[key], f"{key} raw identity/plan disagreement")
+    if job["kind"] == "control":
+        params = audit.get("params", ident.get("params", {}))
+        for key in ("rounds", "server_lr", "cohort", "ema_readout"):
+            if key in job and key in params:
+                require(params[key] == job[key], f"{key} disagreement")
+    if job["kind"] == "runtime_policy":
+        if "rounds" in job:
+            require(audit.get("rounds") == job["rounds"], "runtime rounds disagreement")
+
+
+def eval_labels(run):
+    ev = read(run / "evaluation_identity.json")
+    require(ev.get("role") == "benchmark_dev", "evaluation role differs")
+    labels = ev.get("labels")
+    require(isinstance(labels, list) and labels, "evaluation labels missing")
+    return labels, ev
+
+
+def raw_round(job, run, round_number):
+    kind = job["kind"]
+    if kind in ("runtime_policy", "online"):
+        native = run / "run"
+        pred = read(native / f"predictions_round_{round_number:03d}.json")
+        metrics = read(native / "metrics.json")
+        require(metrics[round_number - 1]["round"] == round_number, "native metrics round differs")
+        return pred, metrics[round_number - 1]["accuracy"], native
+    record = read(run / "rounds" / f"{round_number:03d}" / "record.json")
+    require(record["round"] == round_number, "raw record round differs")
+    for key in ("mode", "agg", "partition"):
+        if key in job and key in record:
+            require(job[key] == record[key], f"raw record {key} differs")
+    ev = record["evaluation"]
+    return ev["predictions"], ev["accuracy"], None
+
+
+def verify_curve(job, audit, run):
+    rows = audit.get("rows")
+    require(isinstance(rows, list) and rows, "audit rows absent")
+    horizon = 100 if job.get("rounds") == 100 else 30
+    if job.get("stage") == "S0":
+        horizon = job.get("stop_after", job.get("rounds", 30))
+    require(len(rows) == horizon, f"audit has {len(rows)} rather than {horizon} rounds")
+    require([r["round"] for r in rows] == list(range(1, horizon + 1)), "audit round sequence differs")
+    labels, ev = eval_labels(run)
+    require(len(labels) == (7600 if job.get("dataset") == "ag_news" else 872), "benchmark dev size differs")
+    require(audit.get("labels_sha256"), "audit labels hash absent")
+    for r, row in enumerate(rows, 1):
+        pred, stored_accuracy, _ = raw_round(job, run, r)
+        require(len(pred) == len(labels), f"round {r} prediction count differs")
+        accuracy = sum(a == b for a, b in zip(pred, labels)) / len(labels)
+        require(equal_num(accuracy, row["accuracy"]) and equal_num(accuracy, stored_accuracy),
+                f"round {r} raw/audit accuracy differs")
+        require(row.get("samples") == len(labels), f"round {r} sample count differs")
+    return rows, ev
+
+
+def fourgrams(text):
+    toks = re.findall(r"[\w']+", text.casefold())
+    return set(zip(toks, toks[1:], toks[2:], toks[3:]))
+
+
+def train_rows(path):
+    with path.open(encoding="utf-8-sig", newline="") as f:
+        return [(r["sentence"], int(r["label"])) for r in csv.DictReader(f, delimiter="\t")]
+
+
+def filtered_masks(local, partition, train):
+    used = {int(x.split(":")[1]) for ids in partition["clients"].values() for x in ids}
+    chunks = set()
+    for i in used:
+        chunks.update(fourgrams(train[i][0]))
+    masks = {}
+    for client, ids in local["ids"].items():
+        masks[client] = [not bool(fourgrams(train[int(x.split(":")[1])][0]) & chunks) for x in ids]
+    return masks
+
+
+def score_binary(pred, labels, mask):
+    pairs = [(p, y) for p, y, keep in zip(pred, labels, mask) if keep]
+    if not pairs:
+        return None
+    acc = sum(p == y for p, y in pairs) / len(pairs)
+    counts = Counter(y for _, y in pairs)
+    bal = None
+    if counts[0] >= 5 and counts[1] >= 5:
+        bal = sum(sum(p == c for p, y in pairs if y == c) / counts[c] for c in (0, 1)) / 2
+    return {"accuracy": acc, "balanced_accuracy": bal, "n": len(pairs), "n0": counts[0], "n1": counts[1]}
+
+
+def personal_values(job, audit, run, train):
+    local = read(run / "local_tests.json")
+    part = read(run / "partition_ids.json")
+    summary = read(run / "personal_evaluation.json")
+    require(summary.get("complete") is True and audit.get("complete") is True, "personal summary incomplete")
+    require(summary.get("seed") == job["seed"], "personal summary seed differs")
+    if "source" in job:
+        require(summary.get("source") == job["source"], "personal summary source differs")
+    require(set(local["ids"]) == set(local["labels"]) == {str(i) for i in range(50)}, "local test clients differ")
+    masks = filtered_masks(local, part, train) if train is not None else None
+    result = {}
+    for scope in ("all", "deduplicated"):
+        if scope == "deduplicated" and masks is None:
+            continue
+        values = defaultdict(list)
+        eligible = defaultdict(int)
+        n_examples = defaultdict(int)
+        for client in sorted(local["ids"], key=int):
+            labels = local["labels"][client]
+            require(len(labels) == len(local["ids"][client]) == 128, "local test length differs")
+            mask = [True] * len(labels) if scope == "all" else masks[client]
+            cdir = run / "clients" / f"{int(client):03d}"
+            for phase, filename in (("P0", None), ("P1", "p1.json"), ("P2", "p2.json")):
+                if phase == "P2" and not job.get("finetune"):
+                    continue
+                if phase == "P0":
+                    guess = local["baseline"][client]["guess"]
+                    pred = [guess] * len(labels)
+                else:
+                    item = read(cdir / filename)
+                    require(item["phase"].lower() == phase.lower(), "personal phase differs")
+                    pred = item["evaluation"]["predictions"]
+                    require(len(pred) == len(labels), "personal prediction length differs")
+                    if scope == "all":
+                        original = item["evaluation"]["accuracy"]
+                        require(equal_num(sum(p == y for p, y in zip(pred, labels)) / len(labels), original),
+                                "personal raw accuracy differs")
+                sc = score_binary(pred, labels, mask)
+                if sc is None:
+                    continue
+                values[(phase, "accuracy")].append(sc["accuracy"])
+                n_examples[phase] += sc["n"]
+                if sc["balanced_accuracy"] is not None:
+                    values[(phase, "balanced_accuracy")].append(sc["balanced_accuracy"])
+                    eligible[phase] += 1
+        for (phase, metric), nums in values.items():
+            result[(phase, scope, metric)] = {"value": statistics.mean(nums), "eligible_clients": len(nums),
+                                               "examples": n_examples[phase]}
+        if scope == "all":
+            for phase in ("P0", "P1", "P2"):
+                for metric in ("accuracy", "balanced_accuracy"):
+                    expected = summary.get("macro", {}).get(phase)
+                    if expected is not None and metric in expected and (phase, scope, metric) in result:
+                        if metric == "accuracy":
+                            require(equal_num(result[(phase, scope, metric)]["value"], expected[metric]),
+                                    f"personal macro {phase} differs")
+    return result
+
+
+def trained_personal_values(job, audit, run, train):
+    """P3/P4 store client predictions in personal_evaluation.json."""
+    pe = read(run / "personal_evaluation.json")
+    part = read(run / "partition_ids.json")
+    require(pe.get("seed") == job["seed"] and pe.get("mode") == job["mode"], "trained personal identity differs")
+    clients = pe.get("clients")
+    require(isinstance(clients, dict) and set(clients) == {str(i) for i in range(50)}, "trained personal clients differ")
+    pseudo_local = {"ids": {k: v["source_ids"] for k, v in clients.items()}}
+    masks = filtered_masks(pseudo_local, part, train) if train is not None else None
+    result = {}
+    for scope in ("all", "deduplicated"):
+        if scope == "deduplicated" and masks is None:
+            continue
+        values = defaultdict(list)
+        examples = defaultdict(int)
+        for client, entry in clients.items():
+            ev = entry["evaluation"]
+            labels, pred = ev["labels"], ev["predictions"]
+            require(len(labels) == len(pred) == len(entry["source_ids"]) == 128,
+                    "trained personal prediction length differs")
+            if scope == "all":
+                require(equal_num(sum(a == b for a,b in zip(pred,labels)) / 128, entry["accuracy"]),
+                        "trained personal raw accuracy differs")
+            mask = [True] * 128 if scope == "all" else masks[client]
+            for phase, p in ((job["cell"], pred), ("P0", [entry["majority"]["guess"]] * 128)):
+                sc = score_binary(p, labels, mask)
+                if sc is None:
+                    continue
+                values[(phase, "accuracy")].append(sc["accuracy"])
+                examples[phase] += sc["n"]
+                if sc["balanced_accuracy"] is not None:
+                    values[(phase, "balanced_accuracy")].append(sc["balanced_accuracy"])
+        for (phase, metric), nums in values.items():
+            result[(phase, scope, metric)] = {"value": statistics.mean(nums), "eligible_clients": len(nums),
+                                               "examples": examples[phase]}
+    summary = pe.get("summary", {})
+    actual = result.get((job["cell"], "all", "accuracy"), {}).get("value")
+    require(equal_num(actual, summary.get("mean_accuracy")), "trained personal macro differs")
+    return result
+
+
+def endpoint_rows(job, queue, audit, run, train):
+    if job["kind"] == "personal_eval":
+        ids = read(run / "local_tests.json")["ids"]
+        sample_identity = fingerprint(ids)
+    elif job.get("mode") in ("fed_sa", "local_only"):
+        clients = read(run / "personal_evaluation.json")["clients"]
+        sample_identity = fingerprint({k: v["source_ids"] for k,v in clients.items()})
+    else:
+        sample_identity = audit["evaluation_ids_sha256"]
+    base = {"queue": queue, "job_id": job["id"], "stage": job["stage"], "seed": job["seed"],
+            "kind": job["kind"], "cell": cell_name(job), "sample_identity_sha256": sample_identity,
+            "status": "validated"}
+    result = []
+    def add(metric, scope, lo, hi, value, unit="fraction"):
+        if value is not None:
+            result.append({**base, "metric": metric, "scope": scope, "round_start": lo, "round_end": hi,
+                           "value": value, "unit": unit})
+    if job["kind"] == "personal_eval":
+        values = personal_values(job, audit, run, train)
+        for (phase, scope, metric), detail in values.items():
+            add(f"{phase}_{metric}", scope, "", "", detail["value"])
+            add(f"{phase}_{metric}_eligible_clients", scope, "", "", detail["eligible_clients"], "count")
+            add(f"{phase}_examples", scope, "", "", detail["examples"], "count")
+    elif job.get("mode") in ("fed_sa", "local_only"):
+        values = trained_personal_values(job, audit, run, train)
+        for (phase, scope, metric), detail in values.items():
+            add(f"{phase}_{metric}", scope, "", "", detail["value"])
+            add(f"{phase}_{metric}_eligible_clients", scope, "", "", detail["eligible_clients"], "count")
+            add(f"{phase}_examples", scope, "", "", detail["examples"], "count")
+        if job.get("mode") == "fed_sa":
+            verify_curve(job, audit, run)
+    else:
+        rows, _ = verify_curve(job, audit, run)
+        n = len(rows)
+        for lo, hi in ((26, 30), (96, 100)):
+            if hi <= n:
+                add("accuracy", "benchmark_dev", lo, hi, statistics.mean(r["accuracy"] for r in rows[lo-1:hi]))
+                if all("ema_accuracy" in r for r in rows[lo-1:hi]):
+                    add("ema_accuracy", "benchmark_dev", lo, hi,
+                        statistics.mean(r["ema_accuracy"] for r in rows[lo-1:hi]))
+        add("peak_accuracy", "benchmark_dev", 1, n, max(r["accuracy"] for r in rows))
+        if n >= 30:
+            add("peak_minus_last5", "benchmark_dev", 1, n,
+                max(r["accuracy"] for r in rows) - statistics.mean(r["accuracy"] for r in rows[-5:]))
+        add("one_class_rounds", "benchmark_dev", 1, n,
+            sum(bool(r.get("one_class_prediction")) for r in rows), "count")
+    return result
+
