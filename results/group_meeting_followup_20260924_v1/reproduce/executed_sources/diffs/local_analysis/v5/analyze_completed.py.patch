+def pairing(rows, left, right, metric="accuracy", right_metric=None, scope="benchmark_dev", lo=26, hi=30,
+            right_lo=None, right_hi=None, label=None):
+    def one(cell, met, first, last):
+        d = {}
+        for r in rows:
+            if (r["stage"] != "S0" and r["cell"] == cell and r["metric"] == met and
+                r["scope"] == scope and r["round_start"] == first and r["round_end"] == last):
+                d[r["seed"]] = (r["value"], r["sample_identity_sha256"])
+        return d
+    right_metric = right_metric or metric
+    right_lo = lo if right_lo is None else right_lo
+    right_hi = hi if right_hi is None else right_hi
+    a, b = one(left, metric, lo, hi), one(right, right_metric, right_lo, right_hi)
+    candidates = sorted(set(a) & set(b))
+    mismatch = [s for s in candidates if a[s][1] != b[s][1]]
+    seeds = [s for s in candidates if s not in mismatch]
+    diffs = [a[s][0] - b[s][0] for s in seeds]
+    n = len(diffs)
+    mean = statistics.mean(diffs) if diffs else None
+    sd = statistics.stdev(diffs) if n > 1 else None
+    radius = T95[n-1] * sd / math.sqrt(n) if n-1 in T95 and sd is not None else None
+    return {"comparison": label or f"{left}:{metric} - {right}:{right_metric}", "left": left, "right": right,
+            "metric": metric, "right_metric": right_metric, "scope": scope, "round_start": lo, "round_end": hi,
+            "right_round_start": right_lo, "right_round_end": right_hi,
+            "paired_seeds": seeds, "missing_seeds": sorted(set(SEEDS) - set(seeds)),
+            "identity_mismatch_seeds": mismatch,
+            "n": n, "differences": {str(s): a[s][0] - b[s][0] for s in seeds},
+            "mean_difference": mean, "ci95_descriptive": [mean-radius, mean+radius] if radius is not None else None,
+            "status": "complete" if n == 5 else "partial_or_missing"}
+
+
+def comparisons(rows):
+    specs = []
+    def add(a, b, **kw): specs.append((a,b,kw))
+    for source in ("old_pcla", "old_full_alt", "fed_both_mean"):
+        for scope in ("all", "deduplicated"):
+            for met in ("accuracy", "balanced_accuracy"):
+                for reference in ("P1", "P0"):
+                    add(source+"_ft", source+"_ft", metric="P2_"+met,
+                        right_metric=reference+"_"+met, scope=scope, lo="", hi="")
+    for scope in ("all", "deduplicated"):
+        for met in ("accuracy", "balanced_accuracy"):
+            for source in ("old_pcla", "old_full_alt", "fed_both_mean", "fed_ffa_b", "central_iid_both"):
+                reference = source+"_ft" if source in ("old_pcla", "old_full_alt", "fed_both_mean") else source
+                add(reference, reference, metric="P1_"+met, right_metric="P0_"+met,
+                    scope=scope, lo="", hi="")
+            for source in ("old_pcla", "old_full_alt", "fed_both_mean", "fed_ffa_b", "central_iid_both"):
+                reference = source+"_ft" if source in ("old_pcla", "old_full_alt", "fed_both_mean") else source
+                add("P3", reference, metric="P3_"+met, right_metric="P1_"+met,
+                    scope=scope, lo="", hi="")
+            for method in ("P3", "P4"):
+                add(method, method, metric=method+"_"+met, right_metric="P0_"+met,
+                    scope=scope, lo="", hi="")
+            add("P3", "P4", metric="P3_"+met, right_metric="P4_"+met, scope=scope, lo="", hi="")
+            for source in ("old_pcla", "old_full_alt", "fed_both_mean"):
+                add("P4", source+"_ft", metric="P4_"+met, right_metric="P2_"+met,
+                    scope=scope, lo="", hi="")
+    for a,b in (("D_agnews_fed_both_exact","D_agnews_fed_both_mean"),
+                ("D_agnews_online_C","D_agnews_pcla"),
+                ("D_agnews_pcla","D_agnews_replay")):
+        add(a,b)
+    for method in ("full_alt", "fed_both_mean", "fed_both_exact", "pcla", "replay", "online_C"):
+        add("D_agnews_central_iid_both", "D_agnews_"+method)
+    # V controls exist outside these three new queues; their absence is explicit.
+    for a,b in (("V1","fed_both_exact"),("V2","full_alt"),("V3","fed_ffa_b"),
+                ("V4_pcla_svd","pcla"),("V5_replay_svd","replay_random_rank")):
+        add(a,b)
+    for a,b in (("L2_pcla_r100","L1"),("L1","L3"),("T1","L1"),("T2","L1")):
+        for lo,hi in ((26,30),(96,100)):
+            add(a,b,lo=lo,hi=hi)
+    for a in ("L1", "L2_pcla_r100", "L3", "T1", "T2"):
+        add(a,a,lo=96,hi=100,right_lo=26,right_hi=30,label=f"{a} rounds 96-100 - rounds 26-30")
+    for a in ("T1", "T2"):
+        for met in ("peak_minus_last5", "one_class_rounds"):
+            add(a,"L1",metric=met,lo=1,hi=100)
+    for a in ("L1", "L2_pcla_r100", "L3", "T1", "T2"):
+        for lo,hi in ((26,30),(96,100)):
+            add(a,a,metric="ema_accuracy",right_metric="accuracy",lo=lo,hi=hi,
+                label=f"{a} EMA - base")
+    for a,b in (("central_pcla","central_random_rank"),
+                ("central_pcla","central_full_alt"),
+                ("central_pcla","central_replay_random_rank")):
+        add(a,b)
+    for partition in ("noniid", "iid"):
+        modes = ("normal", "ffa", "ours", "ours_fixed")
+        for i, a in enumerate(modes):
+            for b in modes[i+1:]:
+                add(f"R_{partition}_{a}", f"R_{partition}_{b}")
+    for agg in ("normal","ffa","ours","ours_fixed"):
+        add(f"R_iid_{agg}",f"R_noniid_{agg}")
+    return [pairing(rows,a,b,**kw) for a,b,kw in specs]
+
+
+def make_csv(rows, columns):
+    f = io.StringIO(newline="")
+    writer = csv.DictWriter(f, fieldnames=columns, extrasaction="ignore")
+    writer.writeheader()
+    writer.writerows(rows)
+    return f.getvalue().encode("utf-8")
+
+
+def svd_evidence(base, statuses):
+    """Inventory basis availability; singular values alone cannot give subspace overlap."""
+    result = {}
+    for seed in SEEDS:
+        job_id = f"V4_pcla_svd_s{seed}"
+        state = next((s["state"] for s in statuses if s["id"] == job_id and s["queue"] == "b"), "missing")
+        root = base / "materialized_v5b" / job_id
+        audit_path = root / "audit.json"
+        if state != "validated" or not audit_path.is_file():
+            result[str(seed)] = {"status": "job_not_validated", "job_state": state}
+            continue
+        refactor = read(audit_path).get("refactor", {})
+        basis_rounds = [r for r in range(1,31) if
+                        (root / "run" / "evidence" / f"{r:03d}" / "refactor_bank.pt").is_file()]
+        result[str(seed)] = {
+            "status": "adjacent_overlap_unavailable",
+            "basis_rounds": basis_rounds,
+            "adjacent_pairs_with_both_bases": [[r-1,r] for r in basis_rounds if r-1 in basis_rounds],
+            "min_numerical_rank": refactor.get("min_numerical_rank"),
+            "reason": "Per-round refactor.json has singular values and numerical rank but no singular vectors; "
+                      "refactor_bank.pt stores factors only at anchor rounds. Adjacent top-r subspace overlap "
+                      "cannot be reconstructed for all 29 transitions."}
+    return result
+
+
+def materialized_baselines(v41, verify_hash):
+    """Import V4.1 exact FedEx and S1 frozen-A from audited materializations."""
+    statuses, endpoints, manifests = [], [], {}
+    for batch, directory, mode in (("v41_r2", "materialized_r2", "fed_both_exact"),
+                                    ("s1", "materialized_s1", "fed_ffa_b")):
+        root = v41 / directory
+        plan_path = root / "plan.json"
+        if not plan_path.is_file():
+            for seed in SEEDS:
+                statuses.append({"queue": batch, "id": f"{mode}_s{seed}", "state": "missing",
+                                 "problems": ["baseline plan absent"]})
+            continue
+        plan = read(plan_path)
+        lookup = {j["id"]: j for j in plan["jobs"]}
+        require(len(lookup) == len(plan["jobs"]), f"{batch} plan IDs duplicate")
+        inv, inv_info = inventory_entries(root / "inventory.json")
+        manifests[batch] = {"plan": {"path": str(plan_path), "sha256": sha(plan_path), "count": len(lookup)},
+                            "inventory": inv_info}
+        for seed in SEEDS:
+            jid = f"{mode}_s{seed}"
+            job = lookup.get(jid)
+            if job is None:
+                statuses.append({"queue": batch, "id": jid, "state": "missing",
+                                 "problems": ["baseline absent from plan"]})
+                continue
+            require(job.get("mode") == mode and job.get("seed") == seed and job.get("kind") == "control",
+                    f"{jid} baseline plan identity differs")
+            status, rows = analyze_job(root, batch, job, inv, None, verify_hash)
+            if status["state"] == "validated":
+                receipt = read(root / jid / "receipt.json")
+                if receipt.get("source_files") != plan.get("source_files"):
+                    status["state"] = "invalid"
+                    status["problems"].append("baseline receipt and plan source locks differ")
+                    rows = []
+            if not inv_info["present"] and status["state"] == "validated":
+                status["state"] = "provisional"
+                status["problems"].append("baseline inventory absent")
+                rows = []
+            statuses.append(status)
+            endpoints.extend(rows)
+    return statuses, endpoints, manifests
+
+
+def v3_baselines(support, reference_base, verify_hash):
+    """Check v3 original runs against plan, frozen source lock, raw predictions and summary."""
+    root = support / "repo" / "results" / "core_shared_hh_20260918_v3"
+    plan_path = support / "core_v3_execution_plan.json"
+    lock_path = support / "core_handoff_v3" / "SOURCE_AND_CONFIG_IDENTITIES.json"
+    stage1_path = support / "core_v3_stage1_audit.json"
+    replay_path = support / "analysis_core_v3" / "replay_audit.json"
+    summary_path = root / "core_summary.json"
+    files = (plan_path, lock_path, stage1_path, replay_path, summary_path)
+    require(all(p.is_file() for p in files), "v3 plan/source lock/audit/summary missing")
+    plan, lock, stage1, replay, summary = map(read, files)
+    require(stage1.get("pass") is True and summary.get("complete_planned_matrix") is True
+            and summary.get("missing_or_failed") == [], "v3 formal audit or summary incomplete")
+    plan_jobs = {j["id"]: j for j in plan["jobs"]}
+    summary_records = {(r["policy"],r["seed"]): r for r in summary["records"]}
+    stage1_records = {r["id"]: r for r in stage1["records"]}
+    replay_records = {r["seed"]: r for r in replay}
+    locked_sources = {**lock["expected_unchanged_files"], **lock["new_files"]}
+    data_lock = lock["expected_data_files"]
+    repo = support / "repo"
+    dev_path = repo / "data/SST-2/dev.tsv"
+    train_path = repo / "data/SST-2/train.tsv"
+    require(sha(dev_path) == data_lock["data/SST-2/dev.tsv"]
+            and sha(train_path) == data_lock["data/SST-2/train.tsv"], "v3 dataset hashes differ from source lock")
+    with dev_path.open(encoding="utf-8-sig", newline="") as f:
+        labels = [int(row["label"]) for row in csv.DictReader(f, delimiter="\t")]
+    require(len(labels) == 872, "v3 benchmark dev size differs")
+    manifest = {"plan": {"path": str(plan_path), "sha256": sha(plan_path)},
+                "source_lock": {"path": str(lock_path), "sha256": sha(lock_path)},
+                "stage1_audit": {"path": str(stage1_path), "sha256": sha(stage1_path)},
+                "replay_audit": {"path": str(replay_path), "sha256": sha(replay_path)},
+                "summary": {"path": str(summary_path), "sha256": sha(summary_path)}}
+    statuses, endpoints = [], []
+    for seed in SEEDS:
+        reference = read(reference_base / "materialized_v5a" / f"V2_alt_svd_refactor_r30_s{seed}" / "run/study.json")
+        ref_config = reference["identity"]["config"]
+        ref_original_identity = reference["identity"]["source_original_identity"]
+        ref_audit = read(reference_base / "materialized_v5a" / f"V2_alt_svd_refactor_r30_s{seed}" / "audit.json")
+        for policy in ("full_alt", "pcla", "replay_random_rank"):
+            jid = f"core_v3_{policy}_{seed}"
+            out = root / f"seed_{seed}" / policy
+            status = {"queue": "v3", "id": jid, "stage": "baseline", "seed": seed,
+                      "kind": "runtime_policy", "cell": policy, "state": "missing", "problems": []}
+            if not out.is_dir():
+                status["problems"].append("v3 original run directory absent")
+                statuses.append(status)
+                continue
+            try:
+                pj = plan_jobs[jid]
+                require(pj["seed"] == seed and pj["policy"] == policy
+                        and pj["out_dir"] == str(out.relative_to(repo))
+                        and pj["command"][pj["command"].index("--seed")+1] == str(seed)
+                        and pj["command"][pj["command"].index("--policy")+1] == policy,
+                        "v3 execution plan identity differs")
+                identity = read(out / "identity.json")
+                provenance = identity["provenance"]
+                require(identity["seed"] == seed and identity["policy"] == policy
+                        and identity["config"] == ref_config and identity["config"]["rounds"] == 30,
+                        "v3 config/seed/policy differs from V5 reference")
+                require(identity["identity_hash"] == ref_original_identity,
+                        "v3 source identity differs from V5 reference")
+                require(provenance["evaluation_split"] == "benchmark_dev"
+                        and provenance["partition_sha256"] == ref_audit["partition_sha256"]
+                        and provenance["dev_file_sha256"] == data_lock["data/SST-2/dev.tsv"]
+                        and provenance["train_file_sha256"] == data_lock["data/SST-2/train.tsv"],
+                        "v3 data/partition identity differs")
+                source_files = provenance["code_files"]
+                require(source_files and all(locked_sources.get(k) == digest for k,digest in source_files.items()),
+                        "v3 source hashes differ from frozen handoff")
+                require(all(sha(repo / k) == digest for k,digest in source_files.items()),
+                        "current v3 source files differ from run source hashes")
+                partition = read(out / "partition_ids.json")
+                ids = partition["benchmark_dev"]
+                sample_hash = fingerprint(ids)
+                require(ids == [f"dev:{i}" for i in range(872)]
+                        and sample_hash == ref_audit["evaluation_ids_sha256"]
+                        and fingerprint(labels) == ref_audit["labels_sha256"],
+                        "v3 evaluation sample identity differs")
+                require(read(out / "status.json") == {"state": "completed", "completed_round": 30},
+                        "v3 raw completion differs")
+                checkpoint = out / "checkpoint.pt"
+                require(checkpoint.is_file(), "v3 checkpoint absent")
+                checkpoint_hash = sha(checkpoint) if verify_hash or policy in ("pcla", "replay_random_rank") else None
+                if policy == "pcla":
+                    anchor = stage1_records[jid]
+                    require(anchor["identity_hash"] == identity["identity_hash"]
+                            and checkpoint_hash == anchor["checkpoint_sha256"],
+                            "v3 PCLA checkpoint differs from stage1 audit")
+                if policy == "replay_random_rank":
+                    donor = replay_records[seed]
+                    require(donor["all_300_client_layer_quotas_match"] is True
+                            and donor["donor_sha256"] == stage1_records[f"core_v3_pcla_{seed}"]["checkpoint_sha256"],
+                            "v3 replay donor audit differs")
+                metrics = read(out / "metrics.json")
+                require(len(metrics) == 30 and [m["round"] for m in metrics] == list(range(1,31)),
+                        "v3 raw metric horizon differs")
+                for r,m in enumerate(metrics,1):
+                    pred = read(out / f"predictions_round_{r:03d}.json")
+                    require(len(pred) == len(labels) == m["samples"], f"v3 round {r} sample count differs")
+                    acc = sum(p == y for p,y in zip(pred,labels)) / len(labels)
+                    require(equal_num(acc,m["accuracy"]),f"v3 round {r} accuracy differs from predictions")
+                endpoint = statistics.mean(m["accuracy"] for m in metrics[25:30])
+                require(equal_num(endpoint,summary_records[(policy,seed)]["last5_accuracy"]),
+                        "v3 endpoint differs from archived core summary")
+                endpoints.append({"queue": "v3", "job_id": jid, "stage": "baseline", "seed": seed,
+                                  "kind": "runtime_policy", "cell": policy, "metric": "accuracy",
+                                  "scope": "benchmark_dev", "round_start": 26, "round_end": 30,
+                                  "value": endpoint, "unit": "fraction", "sample_identity_sha256": sample_hash,
+                                  "status": "validated_baseline"})
+                status.update({"state": "validated", "endpoint_count": 1,
+                               "identity_hash": identity["identity_hash"],
+                               "source_lock_sha256": manifest["source_lock"]["sha256"],
+                               "checkpoint_sha256": checkpoint_hash})
+            except (OSError, KeyError, TypeError, ValueError, IndexError) as e:
+                status["state"] = "invalid"
+                status["problems"].append(str(e))
+            statuses.append(status)
+    return statuses, endpoints, manifest
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--base", type=Path, required=True)
+    ap.add_argument("--v41-base", type=Path, default=Path(V41_DEFAULT))
+    ap.add_argument("--v3-support", type=Path, default=Path(V3_SUPPORT_DEFAULT))
+    ap.add_argument("--train-tsv", type=Path, default=Path(TRAIN_DEFAULT))
+    ap.add_argument("--out-dir", type=Path)
+    ap.add_argument("--stdout-tar", action="store_true")
+    ap.add_argument("--skip-checkpoint-hash", action="store_true")
+    args = ap.parse_args()
+    require(bool(args.out_dir) != args.stdout_tar, "select exactly one output mode")
+    train = train_rows(args.train_tsv) if args.train_tsv.is_file() else None
+    all_status, all_endpoints, manifests = [], [], {}
+    for queue in "abc":
+        jobs, plan = plan_jobs(args.base, queue)
+        root = args.base / f"materialized_v5{queue}"
+        inv, inv_info = inventory_entries(root / "inventory.json")
+        manifests[queue] = {"plan": plan, "inventory": inv_info}
+        for job in jobs:
+            status, rows = analyze_job(root, queue, job, inv, train, not args.skip_checkpoint_hash)
+            if plan["origin"] != "materialized":
+                status["problems"].append("materialized plan absent; handoff plan used provisionally")
+                if status["state"] == "validated": status["state"] = "provisional"
+            if not inv_info["present"]:
+                status["problems"].append("inventory absent")
+                if status["state"] == "validated": status["state"] = "provisional"
+            all_status.append(status)
+            all_endpoints.extend(rows if status["state"] == "validated" else [])
+    v41_status, v41_rows, v41_manifest = materialized_baselines(args.v41_base, not args.skip_checkpoint_hash)
+    v3_status, v3_rows, v3_manifest = v3_baselines(args.v3_support, args.base, not args.skip_checkpoint_hash)
+    all_endpoints.extend(v41_rows)
+    all_endpoints.extend(v3_rows)
+    baseline_status = v41_status + v3_status
+    counts = {q: dict(Counter(s["state"] for s in all_status if s["queue"] == q)) for q in "abc"}
+    out = {"schema": 1, "expected_jobs": 197, "counts": counts, "manifests": manifests,
+           "checkpoint_sha256_rechecked": not args.skip_checkpoint_hash,
+           "baselines": {"counts": dict(Counter(s["state"] for s in baseline_status)),
+                         "jobs": baseline_status,
+                         "manifests": {**v41_manifest, "v3": v3_manifest}},
+           "train_tsv": {"path": str(args.train_tsv), "sha256": sha(args.train_tsv)} if train is not None else None,
+           "jobs": all_status, "comparison_notes": [
+               "Fractions are unrounded; multiply by 100 for percentage points.",
+               "Paired t intervals are descriptive with df=n-1 and no multiplicity correction.",
+               "Personal balanced accuracy is defined only for clients with at least 5 examples of each class.",
+               "Deduplicated personal estimates exclude a test phrase sharing a contiguous 4-token sequence with any client training phrase. Tokens are Unicode word characters or apostrophes after casefold; clients retain equal macro weight, and balanced accuracy requires at least 5 retained examples of each label.",
+               "R is A100 and cross-code; do not pair it inferentially with 4090 endpoints.",
+               "V5 replay_svd and C central_replay_random_rank are separate v5d tasks and absent from these plans."],
+           "svd_subspace": svd_evidence(args.base, all_status),
+           "difference_in_differences": {
+               "formula": "(V4_pcla_svd - original_PCLA) - (V5_replay_svd - original_replay_random_rank)",
+               "endpoint": "seed-paired mean benchmark dev accuracy over rounds 26-30",
+               "value": None, "status": "unavailable",
+               "reason": "V5 replay_svd is outside v5a/b/c materialization; original PCLA and replay_random_rank baselines are imported separately."},
+           "comparisons": comparisons(all_endpoints)}
+    payload = {
+        "status.json": (json.dumps(out, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode(),
+        "endpoints.csv": make_csv(all_endpoints, FIELDS),
+        "comparisons.csv": make_csv(out["comparisons"],
+            ("comparison","left","right","metric","right_metric","scope","round_start","round_end",
+             "right_round_start","right_round_end","paired_seeds",
+             "missing_seeds","identity_mismatch_seeds","n","mean_difference","ci95_descriptive","status")),
+    }
+    if args.stdout_tar:
+        with tarfile.open(fileobj=sys.stdout.buffer, mode="w|") as tar:
+            for name, data in payload.items():
+                info = tarfile.TarInfo(name)
+                info.size = len(data)
+                info.mode = 0o644
+                tar.addfile(info, io.BytesIO(data))
+    else:
+        args.out_dir.mkdir(parents=True, exist_ok=True)
+        for name, data in payload.items():
+            (args.out_dir / name).write_bytes(data)
+
+
+if __name__ == "__main__":
+    main()
