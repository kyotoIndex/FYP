+                    core.require(0 <= index < len(train), "secondary training index outside TSV")
+                    indices.append(index)
+                pos[client] = sum(train[index][1] for index in indices)
+            same(study["identity"]["provenance"]["partition_sha256"], audit["partition_sha256"],
+                 "secondary partition provenance")
+            ev = core.read(out / "run/evaluation_identity.json")
+            labels = ev["labels"]
+            same(len(labels), 872, "secondary benchmark count")
+            participant, predicted = [], []
+            logit_sum = [[0.0, 0.0] for _ in labels] if job["kind"] == "control" else None
+            for r in range(1, 101):
+                if job["kind"] == "control":
+                    record = core.read(out / "run/rounds" / f"{r:03d}" / "record.json")
+                    selected = record["selected_clients"]
+                    evaluation = record["evaluation"]
+                    predictions = evaluation["predictions"]
+                    if "participant_positive_fraction" in record:
+                        declared_fraction = record["participant_positive_fraction"]
+                    else:
+                        declared_fraction = None
+                else:
+                    metrics = core.read(out / "run/run/metrics.json") if r == 1 else metrics
+                    selected = metrics[r-1]["selected_clients"]
+                    predictions = core.read(out / "run/run" / f"predictions_round_{r:03d}.json")
+                    evaluation = None
+                    declared_fraction = None
+                same(len(selected), 10, f"secondary round {r} selected count")
+                same(len(set(selected)), 10, f"secondary round {r} selected uniqueness")
+                core.require(all(str(x) in pos for x in selected), f"secondary round {r} unknown client")
+                same(len(predictions), len(labels), f"secondary round {r} predictions count")
+                core.require(all(x in (0, 1) for x in predictions), f"secondary round {r} prediction label")
+                participant_fraction = sum(pos[str(x)] for x in selected) / (10 * 256)
+                predicted_fraction = sum(x == 1 for x in predictions) / len(predictions)
+                if declared_fraction is not None:
+                    same(len(declared_fraction), len(selected),
+                         f"secondary round {r} declared client proportions count")
+                    core.require(all(core.equal_num(pos[str(client)] / 256, fraction)
+                                     for client, fraction in zip(selected, declared_fraction)),
+                                 f"secondary round {r} declared client proportions differ")
+                participant.append(participant_fraction)
+                predicted.append(predicted_fraction)
+                result["rounds"].append({"cell": cell, "seed": seed, "job_id": jid, "round": r,
+                                         "participant_positive_fraction": participant_fraction,
+                                         "predicted_positive_fraction": predicted_fraction})
+                if r >= 96 and logit_sum is not None:
+                    logits = evaluation.get("logits")
+                    same(len(logits), len(labels), f"secondary round {r} logits count")
+                    for i, pair in enumerate(logits):
