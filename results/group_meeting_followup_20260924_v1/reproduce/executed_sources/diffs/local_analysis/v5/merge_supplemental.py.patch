+def audit_v5f_local(folder, remote_refs, secondary):
+    """Import read-only V5f global logits after hash and raw-prediction checks."""
+    state = {"path": str(folder), "status": "unavailable", "jobs": []}
+    summary_path = folder / "l2_last5_mean_logits_summary.json"
+    if not summary_path.is_file():
+        state["reason"] = "V5f summary absent"
+        return state
+    top = core.read(summary_path)
+    same(top["seeds"], list(core.SEEDS), "V5f seed inventory")
+    same(top["window"], [96, 97, 98, 99, 100], "V5f window")
+    same(top["samples_per_seed"], 872, "V5f benchmark size")
+    same(top["evaluation_source_sha256"], core.sha(folder / "evaluate_l2_logits.py"),
+         "V5f evaluation source hash")
+    same(top["summary_source_sha256"], core.sha(folder / "summarize_l2_logits.py"),
+         "V5f summary source hash")
+    csv_path = folder / "l2_last5_mean_logits.csv"
+    same(top["csv_sha256"], core.sha(csv_path), "V5f CSV hash")
+    csv_by_seed = {int(x["seed"]): x for x in csv_rows(csv_path)}
+    refs_by_seed = {x["seed"]: x for x in remote_refs}
+    same((len(csv_by_seed), len(refs_by_seed), len(top["per_seed"])), (5, 5, 5), "V5f seed rows")
+    summaries = []
+    for seed in core.SEEDS:
+        item = {"seed": seed, "state": "invalid", "problems": []}
+        try:
+            ref = refs_by_seed[seed]
+            source = core.read(folder / f"L2_s{seed}_summary.json")
+            same(source, top["per_seed"][list(core.SEEDS).index(seed)], "V5f top/seed summary")
+            same((source["seed"], source["rounds"], source["samples"], source["evaluation_role"]),
+                 (seed, [96, 97, 98, 99, 100], 872, "benchmark_dev"), "V5f summary identity")
+            for key in ("partition_sha256", "evaluation_identity_sha256", "v5e_parity_sha256",
+                        "v5e_archive_sha256", "original_l2_archive_sha256",
+                        "original_l2_checkpoint_sha256", "dev_file_sha256"):
+                same(source[key], ref[key], "V5f " + key)
+            same(len(source["logit_files"]), 5, "V5f logit files")
+            scores = [[0.0, 0.0] for _ in range(872)]
+            round_accuracies = []
+            labels = None
+            for r, declared, remote_round in zip(range(96, 101), source["logit_files"], ref["rounds"]):
+                same(remote_round["round"], r, "V5f remote round")
+                filename = f"L2_s{seed}_r{r:03d}.json"
+                same(declared["path"], filename, "V5f file name")
+                path = folder / filename
+                same(core.sha(path), declared["sha256"], "V5f per-round file hash")
+                detail = core.read(path)
+                same((detail["seed"], detail["round"], detail["samples"]),
+                     (seed, r, 872), "V5f per-round identity")
+                same(core.fingerprint(detail["labels"]), ref["labels_sha256"], "V5f labels/order")
+                same(core.fingerprint(detail["predictions"]), remote_round["replay_prediction_fingerprint"],
+                     "V5f predictions/replay parity")
+                if labels is None:
+                    labels = detail["labels"]
+                else:
+                    same(detail["labels"], labels, "V5f labels across rounds")
+                for key in ("bank_global_sha256", "bank_file_sha256"):
+                    same(detail[key], declared[key], "V5f declared " + key)
+                    same(detail[key], remote_round[key], "V5f remote " + key)
+                same(detail["replay_prediction_sha256"], remote_round["replay_prediction_sha256"],
+                     "V5f replay prediction file hash")
+                logits = detail["logits"]
+                same(len(logits), 872, "V5f logits count")
+                same(len(detail["predictions"]), 872, "V5f predictions count")
+                for i, pair in enumerate(logits):
+                    core.require(len(pair) == 2 and all(math.isfinite(v) for v in pair),
+                                 "V5f logits nonfinite/dimension mismatch")
+                    same(int(pair[1] > pair[0]), detail["predictions"][i],
+                         "V5f logits/prediction mismatch")
+                    scores[i][0] += pair[0]
+                    scores[i][1] += pair[1]
+                accuracy = sum(p == y for p, y in zip(detail["predictions"], labels)) / 872
+                core.require(core.equal_num(accuracy, detail["accuracy"]), "V5f round accuracy differs")
+                round_accuracies.append(accuracy)
+            mean_prediction = [int(pair[1] > pair[0]) for pair in scores]
+            correct = sum(p == y for p, y in zip(mean_prediction, labels))
+            accuracy = correct / 872
+            core.require(core.equal_num(accuracy, source["mean_logits_accuracy"]),
+                         "V5f mean-logits accuracy differs")
+            core.require(core.equal_num(statistics.mean(round_accuracies), source["mean_round_accuracy"]),
+                         "V5f mean-round accuracy differs")
+            same(correct, source["correct"], "V5f correct count")
+            csv_row = csv_by_seed[seed]
+            same((int(csv_row["samples"]), int(csv_row["correct"]), csv_row["partition_sha256"]),
+                 (872, correct, ref["partition_sha256"]), "V5f CSV identity")
+            core.require(core.equal_num(accuracy, float(csv_row["mean_logits_accuracy"])) and
+                         core.equal_num(statistics.mean(round_accuracies), float(csv_row["mean_round_accuracy"])),
+                         "V5f CSV accuracy differs")
+            original_seed = next(x for x in secondary["per_seed"] if x["cell"] == "L2_pcla_r100" and x["seed"] == seed)
+            same(original_seed["logits_status"], "awaiting_v5f", "V5f import target state")
+            original_seed["last_five_logits_accuracy"] = accuracy
+            original_seed["logits_status"] = "validated_v5f"
+            item.update({"state": "validated", "summary_sha256": core.sha(folder / f"L2_s{seed}_summary.json"),
+                         "mean_logits_accuracy": accuracy})
+            summaries.append(source)
+        except (OSError, KeyError, TypeError, ValueError, IndexError, ZeroDivisionError, StopIteration) as exc:
+            item["problems"].append(str(exc))
+        state["jobs"].append(item)
+    state["counts"] = dict(Counter(x["state"] for x in state["jobs"]))
+    state["status"] = "validated" if state["counts"] == {"validated": 5} else "partial_or_invalid"
+    if state["status"] == "validated":
+        core.require(core.equal_num(statistics.mean(x["mean_logits_accuracy"] for x in summaries),
+                                    top["mean_logits_accuracy_across_seeds"]),
+                     "V5f cross-seed mean differs")
+        state["mean_logits_accuracy_across_seeds"] = top["mean_logits_accuracy_across_seeds"]
+    state["summary_sha256"] = core.sha(summary_path)
+    state["csv_sha256"] = core.sha(csv_path)
+    return state
+
