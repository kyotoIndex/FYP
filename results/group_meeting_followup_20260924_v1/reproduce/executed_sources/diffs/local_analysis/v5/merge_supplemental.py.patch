+def audit_subspace(job, out, official):
+    previous = None
+    summaries = []
+    seed = job["seed"]
+    for r in range(1, 31):
+        bank = tensor_load(out / "run/v5e_factors" / f"round_{r:03d}.pt")
+        record = core.read(out / "run/evidence" / f"{r:03d}" / "refactor.json")
+        same(bank["round"], r, f"factor round {r}")
+        digest = tensor_digest(bank["post"])
+        same(bank["post_lora_sha256"], digest, f"factor round {r} bank digest")
+        same(record["post_lora_sha256"], digest, f"factor round {r} refactor digest")
+        modules = {x["module"]: x for x in record["modules"]}
+        same(len(modules), 24, f"factor round {r} module count")
+        if previous is not None:
+            old_bank, old_modules = previous
+            same(set(old_modules), set(modules), f"factor round {r} module inventory")
+            for module in sorted(modules):
+                ra, rb = old_modules[module]["numerical_rank"], modules[module]["numerical_rank"]
+                ea, eb = effective_rank(old_modules[module]), effective_rank(modules[module])
+                for k in (1, 4, 8, 16):
+                    ga, gb = boundary_gap(old_modules[module], k), boundary_gap(modules[module], k)
+                    if min(ea, eb) < k:
+                        validity = "effective_rank_below_k"
+                    elif (ga is not None and ga <= 1e-5) or (gb is not None and gb <= 1e-5):
+                        validity = "boundary_near_tie"
+                    else:
+                        validity = "valid"
+                    pair = overlap(old_bank["post"], bank["post"], module, k, ra, rb) if validity == "valid" else None
+                    key = (seed, r-1, r, module, k)
+                    core.require(key in official, f"official subspace {key} absent")
+                    row = official[key]
+                    for field, value in (("rank_before", ra), ("rank_after", rb),
+                                         ("effective_rank_before", ea), ("effective_rank_after", eb),
+                                         ("validity", validity)):
+                        same(row[field] if field == "validity" else int(row[field]), value,
+                             f"subspace {key} {field}")
+                    for field, value in (("boundary_gap_relative_before", ga),
+                                         ("boundary_gap_relative_after", gb),
+                                         ("left_overlap", None if pair is None else pair[0]),
+                                         ("right_overlap", None if pair is None else pair[1])):
+                        check_float_csv(value, row[field], f"subspace {key} {field}")
+                    summaries.append((k, validity, pair))
+        previous = (bank, modules)
+    same(len(summaries), 29 * 24 * 4, "subspace row count")
+    result = []
+    for k in (1, 4, 8, 16):
+        selected = [x for x in summaries if x[0] == k]
+        valid = [x[2] for x in selected if x[2] is not None]
+        result.append({"seed": seed, "k": k, "transitions_modules": len(selected),
+                       "available": len(valid),
+                       "effective_rank_below_k": sum(x[1] == "effective_rank_below_k" for x in selected),
+                       "boundary_near_tie": sum(x[1] == "boundary_near_tie" for x in selected),
+                       "mean_left_overlap": statistics.mean(x[0] for x in valid) if valid else None,
+                       "mean_right_overlap": statistics.mean(x[1] for x in valid) if valid else None})
+    return result
+
