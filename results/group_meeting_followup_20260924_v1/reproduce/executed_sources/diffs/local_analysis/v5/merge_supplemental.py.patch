+            try:
+                core.require(seed in core.SEEDS and jid == EXPECTED[side] + str(seed), "ID/seed mismatch")
+                same(job["stage"], "S1", "stage")
+                if side == "central":
+                    same((job["kind"], job["mode"], job["rounds"], job["server_lr"], job["cohort"], job["ema_readout"]),
+                         ("control", "central_replay_random_rank", 30, 1.0, "uniform", 0.8), "central job config")
+                else:
