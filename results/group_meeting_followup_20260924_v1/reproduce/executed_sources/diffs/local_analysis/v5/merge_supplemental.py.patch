+def run_remote(host, remote_base, v5e_queue, v5e_materialized, remote_python):
+    # Bootstrap both local sources in memory; remote Python imports no local files and writes none.
+    here = Path(__file__).resolve().parent
+    base_source = (here / "analyze_completed.py").read_text(encoding="utf-8")
+    merge_source = Path(__file__).read_text(encoding="utf-8")
+    bootstrap = ("import sys,types\n"
+                 "m=types.ModuleType('analyze_completed')\n"
+                 "m.__file__='analyze_completed.py'\n"
+                 "sys.modules['analyze_completed']=m\n"
+                 f"exec(compile({base_source!r},m.__file__,'exec'),m.__dict__)\n"
+                 f"exec(compile({merge_source!r},'merge_supplemental.py','exec'),"
+                 "{'__name__':'__main__','__file__':'merge_supplemental.py'})\n")
+    command = ["ssh", host, remote_python, "-", "--remote-audit", "--remote-base", remote_base]
+    if v5e_queue:
+        command += ["--v5e-queue", v5e_queue]
+    if v5e_materialized:
+        command += ["--v5e-materialized", v5e_materialized]
+    completed = subprocess.run(command,
+                               input=bootstrap, text=True, capture_output=True, check=False)
+    core.require(completed.returncode == 0, "remote audit failed: " + completed.stderr[-3000:])
+    return json.loads(completed.stdout)
+
