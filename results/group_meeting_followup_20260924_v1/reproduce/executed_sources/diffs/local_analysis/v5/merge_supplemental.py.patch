+    state["frozen_sha256"] = core.sha(queue / "FROZEN.json")
+    if not (materialized / "plan.json").is_file() or not (materialized / "inventory.json").is_file():
+        state["status"] = "pending_materialization"
+        state["reason"] = "formal materialized plan/inventory absent"
+        return state
+    same(core.read(materialized / "plan.json"), frozen, "V5e materialized plan")
+    inv, inv_info = core.inventory_entries(materialized / "inventory.json")
+    same(set(inv), {j["id"] for j in jobs}, "V5e inventory IDs")
+    state["inventory"] = inv_info
+    analysis = base / "analysis_v5e"
+    report = core.read(analysis / "status.json")
+    same((report.get("passed"), report.get("seeds"), report.get("ema_endpoint_rows"),
+          report.get("subspace_rows"), report.get("k")),
+         (True, list(core.SEEDS), 10, 13920, [1, 4, 8, 16]), "V5e analysis status")
+    ema_rows = csv_rows(analysis / "ema_endpoints.csv")
+    sub_rows = csv_rows(analysis / "adjacent_subspace.csv")
+    official_ema = {(int(x["seed"]), int(x["round_start"]), int(x["round_end"])): x for x in ema_rows}
+    official_sub = {(int(x["seed"]), int(x["round_before"]), int(x["round_after"]),
+                     x["module"], int(x["k"])): x for x in sub_rows}
+    summary_rows = csv_rows(analysis / "subspace_summary_by_seed.csv")
+    official_summary = {(int(x["seed"]), int(x["k"])): x for x in summary_rows}
+    same((len(ema_rows), len(official_ema), len(sub_rows), len(official_sub)),
+         (10, 10, 13920, 13920), "V5e analysis row identity")
+    same((len(summary_rows), len(official_summary)), (20, 20), "V5e subspace summary identity")
+    state["analysis_ref"] = {"status_sha256": core.sha(analysis / "status.json"),
+                             "ema_sha256": core.sha(analysis / "ema_endpoints.csv"),
+                             "adjacent_subspace_sha256": core.sha(analysis / "adjacent_subspace.csv"),
+                             "subspace_summary_sha256": core.sha(analysis / "subspace_summary_by_seed.csv")}
+    for job in jobs:
+        if job["stage"] == "S0":
+            continue
+        jid, seed = job["id"], job["seed"]
+        row = {"id": jid, "seed": seed, "state": "invalid", "problems": []}
+        try:
+            core.require(seed in core.SEEDS, "V5e seed invalid")
+            is_ema = jid == f"L2_ema_s{seed}"
+            is_svd = jid == f"V4_factors_s{seed}"
+            core.require(is_ema != is_svd, "V5e job ID/family mismatch")
+            same(job["reference_job"], ("L2_pcla_r100_s" if is_ema else "V4_pcla_svd_s") + str(seed),
+                 "V5e reference job")
+            if is_ema:
+                same((job["kind"], job["policy"], job["dataset"], job["rounds"], job["v5e_ema"]),
+                     ("runtime_policy", "pcla", "sst2", 100, 0.8), "V5e EMA config")
+            else:
+                same((job["kind"], job["source"], job["rule"], job["refactor"], job["v5e_factors"]),
+                     ("online", "pcla", "fixed", "svd", True), "V5e SVD config")
+            out = materialized / jid
+            queue_proof = queue_lock(base, "", job, frozen, out, queue_root=queue)
+            for path in frozen["job_inputs"][jid]:
+                same(core.sha(Path(path)), frozen["input_sha256"][path], "V5e frozen input " + path)
+            donor = Path(frozen["site"]["v5b_materialized"]) / job["reference_job"]
+            analyzed, _ = core.analyze_job(materialized, "e", job, inv, None, True)
