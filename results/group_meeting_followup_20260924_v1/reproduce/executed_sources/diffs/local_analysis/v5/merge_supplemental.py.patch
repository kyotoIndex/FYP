+def audit_ema(job, out, donor, audit, official):
+    """Recompute EMA state recurrence, stored hashes, and every raw evaluation."""
+    import torch
+    rows = core.read(out / "run/v5e_ema_rows.json")
+    same([x["round"] for x in rows], list(range(1, 101)), "V5e EMA rounds")
+    labels = core.read(out / "run/evaluation_identity.json")["labels"]
+    previous = None
+    v5f_rounds = []
+    for r, row in enumerate(rows, 1):
+        bank = tensor_load(out / "run/v5e_ema" / f"round_{r:03d}.pt")
+        ev = core.read(out / "run/v5e_ema" / f"evaluation_{r:03d}.json")
+        same((bank["round"], bank["beta"]), (r, 0.8), f"EMA round {r} metadata")
+        same(bank["global_sha256"], tensor_digest(bank["global"]), f"EMA round {r} global digest")
+        same(bank["previous_ema_sha256"], None if previous is None else tensor_digest(previous),
+             f"EMA round {r} previous digest")
+        expected = ({name: value.double() for name, value in bank["global"].items()}
+                    if previous is None else
+                    {name: 0.8 * previous[name] + (1 - 0.8) * value.double()
+                     for name, value in bank["global"].items()})
+        same(set(expected), set(bank["ema"]), f"EMA round {r} tensor names")
+        core.require(all(torch.equal(expected[name], bank["ema"][name]) for name in expected),
+                     f"EMA round {r} recurrence differs")
+        same(bank["ema_sha256"], tensor_digest(expected), f"EMA round {r} state digest")
+        previous = expected
+        same(ev["labels"], labels, f"EMA round {r} evaluation labels")
+        same(ev["samples"], len(labels), f"EMA round {r} evaluation count")
+        same(len(ev["predictions"]), len(labels), f"EMA round {r} predictions count")
+        accuracy = sum(p == y for p, y in zip(ev["predictions"], labels)) / len(labels)
+        core.require(core.equal_num(accuracy, ev["accuracy"]) and core.equal_num(accuracy, row["accuracy"]),
+                     f"EMA round {r} prediction accuracy differs")
+        same(row["global_sha256"], bank["global_sha256"], f"EMA round {r} row global hash")
+        same(row["ema_sha256"], bank["ema_sha256"], f"EMA round {r} row EMA hash")
+        if r >= 96:
+            prediction_path = out / "run/run" / f"predictions_round_{r:03d}.json"
+            v5f_rounds.append({"round": r, "bank_global_sha256": bank["global_sha256"],
