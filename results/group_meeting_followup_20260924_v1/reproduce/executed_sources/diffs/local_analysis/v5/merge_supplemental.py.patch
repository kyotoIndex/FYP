+        state["reason"] = "frozen plan absent"
+        return state
+    frozen = core.read(queue / "FROZEN.json")
+    jobs = frozen["jobs"]
+    same(len(jobs), 12, "V5e frozen count")
+    same({j["id"] for j in jobs}, {f"{prefix}_s{s}" for prefix in ("L2_ema", "V4_factors") for s in core.SEEDS}
+         | {"smoke_l2_ema_s7", "smoke_v4_factors_s7"}, "V5e frozen IDs")
+    same(core.read(queue / "FROZEN_SHA256.json")["sha256"], core.sha(queue / "FROZEN.json"),
+         "V5e frozen SHA256")
+    same(core.sha(Path(frozen["site"]["python_pcla"])), frozen["python_executable_sha256"],
