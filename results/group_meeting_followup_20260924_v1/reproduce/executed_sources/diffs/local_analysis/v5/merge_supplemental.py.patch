+                        logit_sum[i][0] += pair[0]
+                        logit_sum[i][1] += pair[1]
+            p_sd, y_sd = statistics.pstdev(participant), statistics.pstdev(predicted)
+            defined = p_sd > 1e-12 and y_sd > 1e-12
+            corr = statistics.correlation(participant, predicted) if defined else None
+            logits_accuracy = None
+            if logit_sum is not None:
+                voted = [int(pair[1] > pair[0]) for pair in logit_sum]
+                logits_accuracy = sum(p == y for p, y in zip(voted, labels)) / len(labels)
+            result["per_seed"].append({"cell": cell, "seed": seed, "job_id": jid,
+                                       "participant_fraction_sd": p_sd,
+                                       "participant_fraction_range": max(participant) - min(participant),
+                                       "predicted_fraction_sd": y_sd,
+                                       "positive_fraction_pearson_r": corr,
+                                       "correlation_status": "defined" if defined else "undefined_zero_variance",
+                                       "stratified_low_spread": cell == "T2",
+                                       "last_five_logits_accuracy": logits_accuracy,
+                                       "logits_status": "validated" if logits_accuracy is not None else "awaiting_v5f"})
+            status.update({"state": "validated", "audit_sha256": analyzed["audit_sha256"],
+                           "partition_ids_sha256": core.sha(out / "run/partition_ids.json")})
+        except (OSError, KeyError, TypeError, ValueError, IndexError, ZeroDivisionError) as exc:
+            status["problems"].append(str(exc))
+            result["rounds"] = [x for x in result["rounds"] if x["job_id"] != jid]
+        result["jobs"].append(status)
+    for cell in ("L1", "L2_pcla_r100", "L3", "T1", "T2"):
+        selected = [x for x in result["per_seed"] if x["cell"] == cell]
+        logit_values = [x["last_five_logits_accuracy"] for x in selected if x["last_five_logits_accuracy"] is not None]
+        corr_values = [x["positive_fraction_pearson_r"] for x in selected if x["positive_fraction_pearson_r"] is not None]
+        result["summary"].append({"cell": cell, "seeds": [x["seed"] for x in selected],
+                                  "n_correlation": len(corr_values),
+                                  "mean_positive_fraction_pearson_r": statistics.mean(corr_values) if corr_values else None,
+                                  "mean_participant_fraction_sd": statistics.mean(x["participant_fraction_sd"] for x in selected) if selected else None,
+                                  "n_logits": len(logit_values),
+                                  "mean_last_five_logits_accuracy": statistics.mean(logit_values) if logit_values else None,
+                                  "status": "complete" if len(selected) == 5 and len(logit_values) == 5 else "partial_or_missing"})
+    result["counts"] = dict(Counter(x["state"] for x in result["jobs"]))
+    return result
