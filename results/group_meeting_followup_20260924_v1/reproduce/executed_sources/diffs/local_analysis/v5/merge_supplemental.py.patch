+    train_hash = core.sha(train_path)
+    result = {"definition": {
+        "participant_positive_fraction": "positive labels among all selected clients' 256 training IDs each round",
+        "predicted_positive_fraction": "positive predictions among all 872 benchmark dev examples each round",
+        "correlation": "Pearson correlation over 100 paired rounds; null only when an input has zero numerical variance",
+        "last_five_logits_accuracy": "argmax of per-example, per-class arithmetic mean logits over rounds 96-100",
+        "train_tsv_sha256": train_hash}, "jobs": [], "rounds": [], "per_seed": [], "summary": []}
+    jobs = []
+    for queue in "ab":
+        plan = core.read(base / f"materialized_v5{queue}" / "plan.json")
+        inv, _ = core.inventory_entries(base / f"materialized_v5{queue}" / "inventory.json")
+        for job in plan["jobs"]:
+            if job.get("stage") != "S1" or job.get("rounds") != 100:
+                continue
+            cell = core.cell_name(job)
+            if cell in ("L1", "L2_pcla_r100", "L3", "T1", "T2"):
+                jobs.append((queue, job, inv, cell))
+    same({cell: sum(x[3] == cell for x in jobs) for cell in ("L1", "L2_pcla_r100", "L3", "T1", "T2")},
+         {cell: 5 for cell in ("L1", "L2_pcla_r100", "L3", "T1", "T2")},
+         "100-round secondary job inventory")
+    for queue, job, inv, cell in jobs:
+        seed, jid = job["seed"], job["id"]
+        status = {"queue": queue, "job_id": jid, "cell": cell, "seed": seed,
+                  "state": "invalid", "problems": []}
+        try:
+            root = base / f"materialized_v5{queue}"
+            out = root / jid
+            analyzed, _ = core.analyze_job(root, queue, job, inv, None, True)
+            core.require(analyzed["state"] == "validated", "secondary raw job invalid: " +
+                         "; ".join(analyzed["problems"]))
+            study, audit = core.read(out / "run/study.json"), core.read(out / "audit.json")
+            same(study["identity"]["provenance"]["train_file_sha256"], train_hash,
+                 "secondary train TSV hash")
+            partition = core.read(out / "run/partition_ids.json")
+            ids = partition["clients"]
+            same(len(ids), 50, "secondary client count")
+            all_ids = [item for client_ids in ids.values() for item in client_ids]
+            same(len(all_ids), 12800, "secondary training ID count")
+            same(len(set(all_ids)), 12800, "secondary training ID uniqueness")
+            pos = {}
+            for client, values in ids.items():
+                same(len(values), 256, "secondary client sample count")
+                indices = []
+                for item in values:
