+def local_merge(args):
+    base_dir = args.base_dir.resolve()
+    base_status_path = base_dir / "status.json"
+    base_endpoints_path = base_dir / "endpoints.csv"
+    status = core.read(base_status_path)
+    core.require(status["expected_jobs"] == 197 and status["checkpoint_sha256_rechecked"] is True,
+                 "base analysis not a full hash-verified 197-job run")
+    same(status["counts"], {"a": {"validated": 60, "technical_validated": 13},
+                            "b": {"validated": 45, "technical_validated": 9},
+                            "c": {"validated": 65, "technical_validated": 5}}, "base status counts")
+    same(status["baselines"]["counts"], {"validated": 25}, "base baseline counts")
+    rows = read_endpoints(base_endpoints_path)
+    core.require(len(rows) == 1695, "base endpoint row count differs")
+    same(core.comparisons(rows), status["comparisons"], "base comparison recomputation")
+    supplement = run_remote(args.host, args.remote_base, args.v5e_queue, args.v5e_materialized, args.remote_python)
+    core.require(len(supplement["jobs"]) == 10, "V5d ten-job status absent")
+    for row in supplement["endpoints"]:
+        core.require(row["status"] == "validated", "invalid supplemental endpoint")
+    supplement["v5f"] = audit_v5f_local(args.v5f_dir, supplement["v5e"].get("v5f_refs", []),
+                                       supplement["secondary"])
+    l2 = next(x for x in supplement["secondary"]["summary"] if x["cell"] == "L2_pcla_r100")
+    l2_values = [x["last_five_logits_accuracy"] for x in supplement["secondary"]["per_seed"]
+                 if x["cell"] == "L2_pcla_r100" and x["last_five_logits_accuracy"] is not None]
+    l2["n_logits"] = len(l2_values)
+    l2["mean_last_five_logits_accuracy"] = statistics.mean(l2_values) if l2_values else None
+    l2["status"] = "complete" if len(l2_values) == 5 and len(l2["seeds"]) == 5 else "partial_or_missing"
+    rows.extend(supplement["endpoints"])
+    paired = core.comparisons(rows)
+    did = difference_in_differences(rows)
+    secondary_rounds = supplement.pop("secondary_rounds")
+    merged = {"schema": 1, "base_status_sha256": core.sha(base_status_path),
+              "base_endpoints_sha256": core.sha(base_endpoints_path),
+              "base_expected_jobs": 197, "supplemental": {k: v for k, v in supplement.items() if k != "endpoints"},
+              "endpoint_count": len(rows), "comparisons": paired, "difference_in_differences": did,
+              "notes": ["Only validated supplemental jobs contribute endpoints; failures remain in supplemental jobs.",
+                        "V5e EMA endpoints require raw recurrence, parity, identity, and archived-source audit.",
+                        "Paired t intervals are descriptive, unadjusted, and use df=n-1."]}
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+    (args.out_dir / "status.json").write_text(json.dumps(merged, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
+    (args.out_dir / "endpoints.csv").write_bytes(core.make_csv(rows, core.FIELDS))
+    (args.out_dir / "comparisons.csv").write_bytes(core.make_csv(paired,
+        ("comparison","left","right","metric","right_metric","scope","round_start","round_end",
+         "right_round_start","right_round_end","paired_seeds","missing_seeds","identity_mismatch_seeds",
+         "n","mean_difference","ci95_descriptive","status")))
+    (args.out_dir / "secondary_rounds.csv").write_bytes(core.make_csv(secondary_rounds,
+        ("cell", "seed", "job_id", "round", "participant_positive_fraction", "predicted_positive_fraction")))
+    (args.out_dir / "secondary_per_seed.csv").write_bytes(core.make_csv(supplement["secondary"]["per_seed"],
+        ("cell", "seed", "job_id", "participant_fraction_sd", "participant_fraction_range",
+         "predicted_fraction_sd", "positive_fraction_pearson_r", "correlation_status",
+         "stratified_low_spread", "last_five_logits_accuracy", "logits_status")))
+    (args.out_dir / "secondary_summary.json").write_text(json.dumps(
+        {"definition": supplement["secondary"]["definition"],
+         "counts": supplement["secondary"]["counts"], "summary": supplement["secondary"]["summary"]},
+        ensure_ascii=False, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"v5d_counts": supplement["counts"], "v5e_counts": supplement["v5e"].get("counts"),
+                      "secondary_counts": supplement["secondary"]["counts"],
+                      "v5f_counts": supplement["v5f"].get("counts"),
+                      "comparisons_complete": sum(x["status"] == "complete" for x in paired),
+                      "comparisons_total": len(paired), "did": did, "out_dir": str(args.out_dir)}, ensure_ascii=False))
+
