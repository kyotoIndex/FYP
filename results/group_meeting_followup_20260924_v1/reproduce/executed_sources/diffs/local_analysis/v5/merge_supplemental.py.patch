+def overlap(x, y, module, k, ra, rb):
+    import torch
+    if min(ra, rb) < k:
+        return None
+    values = []
+    for suffix, columns in (("b", True), ("a", False)):
+        a, b = x[module + ".lora_" + suffix].double(), y[module + ".lora_" + suffix].double()
+        if not columns:
+            a, b = a.T, b.T
+        a, b = a[:, :k], b[:, :k]
+        na, nb = a.norm(dim=0), b.norm(dim=0)
+        core.require(bool((na > 0).all() and (nb > 0).all()), "zero vector in numerical rank")
+        a, b = a / na, b / nb
+        identity = torch.eye(k, dtype=torch.float64)
+        core.require(float((a.T @ a - identity).abs().max()) < 2e-3 and
+                     float((b.T @ b - identity).abs().max()) < 2e-3, "SVD vectors not orthogonal")
+        v = float(((a.T @ b)**2).sum() / k)
+        core.require(-1e-8 <= v <= 1 + 2e-3, "overlap outside range")
+        values.append(min(1., max(0., v)))
+    return values
+
+
+def boundary_gap(record, k):
+    singular = record["singular_values"]
+    if k >= len(singular):
+        return None
+    core.require(singular and singular[0] >= 0, "invalid singular values")
+    return (singular[k-1] - singular[k]) / singular[0] if singular[0] > 0 else 0.
+
+
+def effective_rank(record):
+    singular = record["singular_values"]
+    if not singular or singular[0] <= 0:
+        return 0
+    threshold = max(record["tolerance"], 1e-5 * singular[0])
+    return min(record["numerical_rank"], sum(value > threshold for value in singular))
+
+
+def check_float_csv(value, text, what):
+    if value is None:
+        same(text, "", what)
+    else:
+        core.require(core.equal_num(value, float(text), 1e-10), what + " differs")
+
