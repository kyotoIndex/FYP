+def difference_in_differences(rows):
+    cells = ("V4_pcla_svd", "pcla", "V5_replay_svd", "replay_random_rank")
+    index = {}
+    for row in rows:
+        if (row["cell"] in cells and row["metric"] == "accuracy" and
+                row["scope"] == "benchmark_dev" and row["round_start"] == 26 and row["round_end"] == 30):
+            key = (row["cell"], row["seed"])
+            core.require(key not in index, "duplicate DiD endpoint " + str(key))
+            index[key] = row
+    diffs, mismatches = {}, []
+    for seed in core.SEEDS:
+        four = [index.get((cell, seed)) for cell in cells]
+        if any(x is None for x in four):
+            continue
+        if len({x["sample_identity_sha256"] for x in four}) != 1:
+            mismatches.append(seed)
+            continue
+        diffs[str(seed)] = (four[0]["value"] - four[1]["value"]) - (four[2]["value"] - four[3]["value"])
+    n = len(diffs)
+    mean = statistics.mean(diffs.values()) if n else None
+    sd = statistics.stdev(diffs.values()) if n > 1 else None
+    radius = core.T95[n-1] * sd / math.sqrt(n) if n-1 in core.T95 and sd is not None else None
+    return {"formula": "(V4_pcla_svd - original_PCLA) - (V5_replay_svd - original_replay_random_rank)",
+            "endpoint": "seed-paired mean benchmark dev accuracy over rounds 26-30",
+            "paired_seeds": [int(s) for s in diffs], "missing_seeds": sorted(set(core.SEEDS) - {int(s) for s in diffs}),
+            "identity_mismatch_seeds": mismatches, "n": n, "differences": diffs,
+            "value": mean, "ci95_descriptive": [mean-radius, mean+radius] if radius is not None else None,
+            "status": "complete" if n == 5 else "partial_or_missing"}
+
