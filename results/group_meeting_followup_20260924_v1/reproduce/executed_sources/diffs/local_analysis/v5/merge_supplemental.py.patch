+        same(set(inv), {j["id"] for j in jobs}, side + " inventory IDs")
+        result["v5d"][side] = {"plan_sha256": core.sha(mat / "plan.json"),
+                               "frozen_sha256": core.sha(q / "FROZEN.json"), "inventory": inv_info}
+        for job in jobs:
+            seed, jid = job["seed"], job["id"]
