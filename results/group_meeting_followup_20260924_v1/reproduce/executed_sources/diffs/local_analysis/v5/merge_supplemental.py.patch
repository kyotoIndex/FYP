+    for side in ("central", "svd"):
+        mat = base / "materialized_v5d" / side
+        q = base / "queue_v5d" / side
+        plan = core.read(mat / "plan.json")
+        same(plan, core.read(q / "FROZEN.json"), side + " frozen plan")
+        frozen = core.read(q / "FROZEN_SHA256.json")
+        # FROZEN_SHA256.json is a manifest, rather than the payload itself.
+        core.require(core.sha(q / "FROZEN.json") in json.dumps(frozen), side + " frozen hash absent")
+        jobs = plan["jobs"]
+        same(len(jobs), 5, side + " planned count")
+        same({j["id"] for j in jobs}, {EXPECTED[side] + str(s) for s in core.SEEDS},
+             side + " planned IDs")
+        inv, inv_info = core.inventory_entries(mat / "inventory.json")
