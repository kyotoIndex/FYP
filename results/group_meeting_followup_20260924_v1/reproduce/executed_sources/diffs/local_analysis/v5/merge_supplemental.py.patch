+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--base-dir", type=Path, default=Path(__file__).resolve().parent / "check")
+    ap.add_argument("--out-dir", type=Path, default=Path(__file__).resolve().parent / "merged")
+    ap.add_argument("--host", default="hpc-bnbu")
+    ap.add_argument("--remote-base", default=REMOTE_DEFAULT)
+    ap.add_argument("--remote-python", default="$HPC_HOME/pcla_repair_20260918/venv/bin/python")
+    ap.add_argument("--v5e-queue", help="Optional frozen V5e queue path on the remote host")
+    ap.add_argument("--v5e-materialized", help="Optional V5e materialized path on the remote host")
+    ap.add_argument("--v5f-dir", type=Path, default=Path(__file__).resolve().parent.parent / "v5f")
+    ap.add_argument("--remote-audit", action="store_true", help=argparse.SUPPRESS)
+    args = ap.parse_args()
+    if args.remote_audit:
+        print(json.dumps(audit_remote(Path(args.remote_base), Path(args.v5e_queue) if args.v5e_queue else None,
+                                      Path(args.v5e_materialized) if args.v5e_materialized else None),
+                         ensure_ascii=False, allow_nan=False))
+    else:
+        local_merge(args)
+
