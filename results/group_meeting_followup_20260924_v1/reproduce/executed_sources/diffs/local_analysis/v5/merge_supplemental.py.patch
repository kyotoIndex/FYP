+                         ("online", "pcla", "fixed", "svd", True), "SVD job config")
+                out = mat / jid
+                queue_proof = queue_lock(base, side, job, plan, out)
+                donor = base / f"materialized_v5{DONOR[side][0]}" / (DONOR[side][1] + str(seed))
+                donor_proof = donor_lock(base, side, seed, plan, jid, out, donor)
+                analyzed, endpoints = core.analyze_job(mat, "d_" + side, job, inv, None, True)
+                core.require(analyzed["state"] == "validated", "materialized audit: " + "; ".join(analyzed["problems"]))
+                same(len([e for e in endpoints if e["metric"] == "accuracy" and e["round_start"] == 26]),
