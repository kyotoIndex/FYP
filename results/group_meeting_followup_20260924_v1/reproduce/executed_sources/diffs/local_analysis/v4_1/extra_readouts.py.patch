--- /dev/null
+++ b/local_analysis/v4_1/extra_readouts.py
@@ -0,0 +1,155 @@
+"""Pre-registered extra comparisons and trajectory readouts (EXECUTION.md section 5.2).
+
+Inputs: one or more materialized queue directories (dispatch.py materialize) and the v3 per-round
+table for the reused old F / full_alt trajectories. Only rounds of completed full-length jobs are
+used; smokes and G0 diagnostics are skipped. Nothing here changes the V4.1 primary analysis.
+"""
+import argparse
+import csv
+import json
+import math
+import hashlib
+import re
+import statistics
+from pathlib import Path
+
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+PCLA = HERE.parents[2]
+V3_ROUNDS = PCLA / 'runs/20260918_core_shared_hh_v3/analysis/per_round.csv'
+COHORT = HERE / 'cohort_label_share.csv'
+SEEDS = (7, 13, 21, 42, 87)
+GROUPS = {'all_five': SEEDS, 'prior_LR_development': (7, 13), 'not_used_for_prior_LR_ranking': (21, 42, 87)}
+T975 = {1: 12.706, 2: 4.303, 3: 3.182, 4: 2.776}
+COMPARISONS = [
+    ('central_pooled_both - full_alt(old)', 'central_pooled_both', 'old_full_alt'),
+    ('central_pooled_both - PCLA F(old)', 'central_pooled_both', 'old_pcla'),
+    ('online PCLA+C - PCLA F(old)', 'online_pcla_contributors', 'old_pcla'),
+    ('fed_both_exact - full_alt(old)', 'fed_both_exact', 'old_full_alt'),
+    ('central_iid_both - central_pooled_both', 'central_iid_both', 'central_pooled_both'),
+    ('central_iid_both - full_alt(old)', 'central_iid_both', 'old_full_alt'),
+    ('fed_ffa_b - full_alt(old)', 'fed_ffa_b', 'old_full_alt'),
+    ('fed_ffa_b - fed_both_mean', 'fed_ffa_b', 'fed_both_mean'),
+    ('fed_ffa_b - fed_both_exact', 'fed_ffa_b', 'fed_both_exact'),
+]
+
+
+def cohort_share():
+    rows = csv.DictReader(COHORT.open())
+    return {(int(r['seed']), int(r['round'])): float(r['cohort_positive_share']) for r in rows}
+
+
+def evaluations(run):
+    """Per-round evaluation dicts of a materialized job directory, keyed by round."""
+    out = {}
+    for p in run.glob('run/rounds/*/record.json'):
+        out[int(p.parent.name)] = json.loads(p.read_text())['evaluation']
+    for p in run.glob('run/evidence/*/evaluation.json'):
+        out[int(p.parent.name)] = json.loads(p.read_text())
+    return out
+
+
+def readout(acc, pos_share, seed, logits=None, labels=None):
+    share = cohort_share()
+    rounds = sorted(acc)
+    last5 = [acc[r] for r in range(26, 31)]
+    mid = [r for r in rounds if r >= 11]
+    single = sum(1 for r in mid if pos_share[r] < .05 or pos_share[r] > .95)
+    x = [share[(seed, r)] for r in mid]; y = [pos_share[r] for r in mid]
+    corr = float(np.corrcoef(x, y)[0, 1]) if np.std(y) > 0 else None
+    row = {'last5_accuracy': statistics.mean(last5), 'peak_accuracy': max(acc.values()),
+           'peak_round': max(rounds, key=lambda r: acc[r]),
+           'peak_minus_last5_pp': 100 * (max(acc.values()) - statistics.mean(last5)),
+           'near_single_class_rounds_11_30': single, 'corr_cohort_vs_predicted_positive_11_30': corr}
+    if logits is not None:
+        avg = np.mean([np.asarray(logits[r], dtype=np.float64) for r in range(26, 31)], axis=0)
+        row['last5_logit_average_accuracy'] = float((avg.argmax(1) == np.asarray(labels)).mean())
+    return row
+
+
+def new_rows(roots):
+    rows = []
+    seen = {}  # seed -> (partition sha256, evaluation label sha256), shared by every paired run
+    for root in roots:
+        inventory = json.loads((root / 'inventory.json').read_text())
+        jobs = {j['id']: j for j in json.loads((root / 'plan.json').read_text())['jobs']}
+        for item in inventory:
+            job = jobs[item['job']]
+            if item['state'] != 'completed' or job.get('stop_after') or job['kind'] == 'diagnostic' or job.get('parity'):
+                continue
+            ev = evaluations(root / item['job'])
+            if sorted(ev) != list(range(1, 31)):
+                continue
+            cell = re.sub(r'_s\d+$', '', item['job'])
+            acc = {r: e['accuracy'] for r, e in ev.items()}
+            pos = {r: e['predicted_class_counts'][1] / e['samples'] for r, e in ev.items()}
+            labels = ev[30]['labels']
+            part = json.loads((root / item['job'] / 'run/partition_ids.json').read_text())
+            ident = (hashlib.sha256(json.dumps(part, sort_keys=True).encode()).hexdigest(),
+                     hashlib.sha256(json.dumps(labels).encode()).hexdigest())
+            if seen.setdefault(job['seed'], ident) != ident:
+                raise SystemExit(f"paired identity differs for seed {job['seed']}: {item['job']} in {root}")
+            if any(e['labels'] != labels for e in ev.values()):
+                raise SystemExit(f"evaluation labels change across rounds: {item['job']}")
+            rows.append({'cell': cell, 'seed': job['seed'], 'source': str(root.name),
+                         'last5_balanced_accuracy': statistics.mean(ev[r]['balanced_accuracy'] for r in range(26, 31)),
+                         'last5_nll_float64': statistics.mean(ev[r]['nll_recomputed_float64'] for r in range(26, 31)),
+                         **readout(acc, pos, job['seed'], {r: e['logits'] for r, e in ev.items()}, labels)})
+    return rows
+
+
+def old_rows():
+    table = {}
+    for r in csv.DictReader(Path(V3_ROUNDS).open()):
+        if r['policy'] in ('pcla', 'full_alt', 'replay_random_rank', 'random'):
+            table.setdefault((r['policy'], int(r['seed'])), {})[int(r['round'])] = r
+    rows = []
+    for (policy, seed), rr in sorted(table.items()):
+        acc = {k: float(v['accuracy']) for k, v in rr.items()}
+        pos = {k: int(v['predicted_positive_count']) / 872 for k, v in rr.items()}
+        rows.append({'cell': 'old_' + policy, 'seed': seed, 'source': 'v3_core_per_round',
+                     'last5_balanced_accuracy': statistics.mean(float(rr[k]['balanced_accuracy']) for k in range(26, 31)),
+                     'last5_nll_float64': None, **readout(acc, pos, seed)})
+    return rows
+
+
+def paired(values, seeds):
+    diffs = [values[s] for s in seeds if s in values]
+    row = {'n_seeds': len(diffs), 'seeds_present': [s for s in seeds if s in values]}
+    if diffs:
+        row['mean_difference_pp'] = statistics.mean(diffs)
+        row['per_seed_pp'] = {s: round(values[s], 4) for s in seeds if s in values}
+    if len(diffs) >= 2:
+        half = T975[len(diffs) - 1] * statistics.stdev(diffs) / math.sqrt(len(diffs))
+        row['descriptive_t_95_pp'] = [row['mean_difference_pp'] - half, row['mean_difference_pp'] + half]
+    return row
+
+
+def main():
+    global V3_ROUNDS, COHORT
+    p = argparse.ArgumentParser()
+    p.add_argument('--materialized', nargs='+', required=True)
+    p.add_argument('--out', required=True)
+    p.add_argument('--v3-rounds', default=str(V3_ROUNDS))
+    p.add_argument('--cohort', default=str(COHORT))
+    a = p.parse_args()
+    V3_ROUNDS, COHORT = Path(a.v3_rounds), Path(a.cohort)
+    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
+    rows = new_rows([Path(x) for x in a.materialized]) + old_rows()
+    with (out / 'trajectory_readouts.csv').open('w', newline='') as f:
+        keys = sorted({k for r in rows for k in r}, key=lambda k: (k not in ('cell', 'seed', 'source'), k))
+        w = csv.DictWriter(f, fieldnames=keys); w.writeheader(); w.writerows(rows)
+    end = {(r['cell'], r['seed']): 100 * r['last5_accuracy'] for r in rows}
+    result = {}
+    for group, seeds in GROUPS.items():
+        result[group] = []
+        for name, a_cell, b_cell in COMPARISONS:
+            values = {s: end[(a_cell, s)] - end[(b_cell, s)] for s in seeds if (a_cell, s) in end and (b_cell, s) in end}
+            result[group].append({'comparison': name, **paired(values, seeds)})
+    (out / 'extra_comparisons.json').write_text(json.dumps(result, indent=2, ensure_ascii=False) + '\n')
+    print(json.dumps({'trajectories': len(rows), 'comparisons': len(COMPARISONS)}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
