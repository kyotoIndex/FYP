--- /dev/null
+++ b/local_analysis/v4_1/cohort_label_share.py
@@ -0,0 +1,39 @@
+"""Per-seed, per-round positive-label share of the participating cohort.
+
+The cohort sequence depends only on the seed (keyed participant sampling) and V4.1 enforces the
+same partition as the v3 core run, so the v3 client records define the cohorts of every job.
+Labels are resolved from repo/data/SST-2/train.tsv row indices ('train:i' = i-th data row).
+"""
+import csv
+import json
+from pathlib import Path
+
+PCLA = Path(__file__).resolve().parents[3]
+V3 = PCLA / 'runs/20260918_core_shared_hh_v3/results'
+SEEDS = (7, 13, 21, 42, 87)
+
+
+def main():
+    with (PCLA / 'repo/data/SST-2/train.tsv').open(encoding='utf-8-sig', newline='') as f:
+        label = {f'train:{i}': int(r['label']) for i, r in enumerate(csv.DictReader(f, delimiter='\t'))}
+    rows = []
+    for seed in SEEDS:
+        run = V3 / f'seed_{seed}/full_alt'
+        part = json.loads((run / 'partition_ids.json').read_text())
+        client_pos = {int(c): sum(label[s] for s in ids) / len(ids) for c, ids in part['clients'].items()}
+        for r in range(1, 31):
+            chosen = [x['client'] for x in json.loads((run / f'clients_round_{r:03d}.json').read_text())]
+            n = sum(len(part['clients'][str(c)]) for c in chosen)
+            pos = sum(label[s] for c in chosen for s in part['clients'][str(c)])
+            rows.append({'seed': seed, 'round': r, 'clients': ' '.join(map(str, chosen)),
+                         'cohort_samples': n, 'cohort_positive_share': pos / n,
+                         'single_class_clients': sum(client_pos[c] in (0.0, 1.0) for c in chosen)})
+    out = Path(__file__).with_name('cohort_label_share.csv')
+    with out.open('w', newline='') as f:
+        w = csv.DictWriter(f, fieldnames=list(rows[0]))
+        w.writeheader(); w.writerows(rows)
+    print(out, len(rows))
+
+
+if __name__ == '__main__':
+    main()
