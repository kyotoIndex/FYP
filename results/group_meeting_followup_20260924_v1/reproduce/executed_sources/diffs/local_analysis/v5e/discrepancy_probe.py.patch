--- /dev/null
+++ b/local_analysis/v5e/discrepancy_probe.py
@@ -0,0 +1,42 @@
+"""Exact-float and SVD validity examples for independent V5e audit alignment."""
+from pathlib import Path
+import csv,json,sys,torch
+ROOT=Path('$HPC_HOME/pcla_v5_20260924')
+sys.path.insert(0,str(ROOT/'handoff_v5e'))
+sys.path.insert(0,str(ROOT))
+from common import tensor_load,read,bind_repo
+import analyze_v5e
+_,core,_,_=bind_repo()
+M=ROOT/'materialized_v5e';out={'ema':{},'subspace':{}}
+for seed in (7,13,21,42,87):
+    d=M/f'L2_ema_s{seed}'/'run/v5e_ema'
+    b1=tensor_load(d/'round_001.pt');b2=tensor_load(d/'round_002.pt')
+    exact={n:b2['beta']*b1['ema'][n]+(1-b2['beta'])*v.double() for n,v in b2['global'].items()}
+    literal={n:b2['beta']*b1['ema'][n]+0.2*v.double() for n,v in b2['global'].items()}
+    bad=next((n for n in sorted(exact) if not torch.equal(literal[n],b2['ema'][n])),None)
+    out['ema'][str(seed)]={'beta':b2['beta'],'one_minus_beta':1-b2['beta'],
+        'literal_0_2':0.2,'exact_recurrence_all_tensors_equal':all(torch.equal(exact[n],b2['ema'][n]) for n in exact),
+        'literal_0_2_all_tensors_equal':all(torch.equal(literal[n],b2['ema'][n]) for n in exact),
+        'actual_ema_sha256':core.tensor_digest(b2['ema']),
+        'one_minus_beta_sha256':core.tensor_digest(exact),
+        'literal_0_2_sha256':core.tensor_digest(literal),
+        'first_literal_mismatch_tensor':bad,
+        'first_literal_mismatch_max_abs':float((literal[bad]-b2['ema'][bad]).abs().max()) if bad else 0.}
+rows=list(csv.DictReader((ROOT/'analysis_v5e/adjacent_subspace.csv').open(newline='')))
+for seed,k,module in ((7,1,'bert.encoder.layer.0.attention.self.query'),
+                      (13,16,'bert.encoder.layer.0.attention.self.query')):
+    job=M/f'V4_factors_s{seed}'/'run'
+    a,b=[{x['module']:x for x in read(job/'evidence'/f'{r:03d}'/'refactor.json')['modules']} for r in (1,2)]
+    row=next(x for x in rows if int(x['seed'])==seed and int(x['round_before'])==1 and x['module']==module and int(x['k'])==k)
+    x,y=a[module],b[module]
+    out['subspace'][f'{seed}/{k}/{module}']={'official_row':row,
+        'numerical_ranks':[x['numerical_rank'],y['numerical_rank']],
+        'effective_ranks':[analyze_v5e.effective_rank(x),analyze_v5e.effective_rank(y)],
+        'relative_boundary_gaps':[analyze_v5e.boundary_gap(x,k),analyze_v5e.boundary_gap(y,k)],
+        'singular_values_before':x['singular_values'],
+        'singular_values_after':y['singular_values'],
+        'original_tolerances':[x['tolerance'],y['tolerance']]}
+(ROOT/'analysis_v5e/discrepancy_reproduction.json').write_text(json.dumps(out,indent=2)+'\n')
+print(json.dumps({'ema_exact':[out['ema'][str(s)]['exact_recurrence_all_tensors_equal'] for s in (7,13,21,42,87)],
+                  'ema_literal':[out['ema'][str(s)]['literal_0_2_all_tensors_equal'] for s in (7,13,21,42,87)],
+                  'subspace_validity':{k:v['official_row']['validity'] for k,v in out['subspace'].items()}},indent=2))
