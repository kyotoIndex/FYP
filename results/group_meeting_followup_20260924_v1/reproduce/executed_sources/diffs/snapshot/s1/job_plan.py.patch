--- /dev/null
+++ b/job_plan.py
@@ -0,0 +1,48 @@
+"""S1 supplement cells, a queue separate from the V4.1 81-job plan; technical stages do not select favorable results."""
+from __future__ import annotations
+import argparse
+from common import BATCH,SEEDS,atomic_json,require
+
+
+def build():
+    jobs=[]
+    for mode,pool in (('bridge_full_alt','4090'),('central_iid_both','technical'),('fed_ffa_b','technical')):
+        jobs.append(dict(id=f'smoke_{mode}_s7',family='lora_control',kind='control',mode=mode,seed=7,
+            stop_after=5,stage='S0',pool=pool,depends=[],priority=2))
+    depends={'central_iid_both':['smoke_central_iid_both_s7'],
+             'fed_ffa_b':['smoke_fed_ffa_b_s7','smoke_bridge_full_alt_s7']}
+    for seed in SEEDS:
+        for mode in ('central_iid_both','fed_ffa_b'):
+            jobs.append(dict(id=f'{mode}_s{seed}',family='lora_control',kind='control',mode=mode,seed=seed,
+                stage='S1',pool='4090',depends=depends[mode],priority=4))
+    require(len(jobs)==13 and len({j['id'] for j in jobs})==13,'job inventory differs')
+    return jobs
+
+
+STAGE_DEPENDENCIES={'S0':[],'S1':[]}
+
+
+def validate(jobs):
+    ids={j['id'] for j in jobs};require(len(ids)==len(jobs),'duplicate job IDs')
+    for j in jobs:
+        require(j['stage'] in STAGE_DEPENDENCIES and set(j['depends'])<=ids,'invalid dependencies')
+    visiting,done=set(),set()
+    lookup={j['id']:j for j in jobs}
+    def visit(key):
+        require(key not in visiting,'dependency cycle')
+        if key in done:return
+        visiting.add(key)
+        j=lookup[key]
+        deps=set(j['depends'])|{x['id'] for x in jobs if x['stage'] in STAGE_DEPENDENCIES[j['stage']]}
+        for dep in deps:visit(dep)
+        visiting.remove(key);done.add(key)
+    for key in ids:visit(key)
+    return True
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--out',required=True);a=p.parse_args();jobs=build();validate(jobs)
+    atomic_json(a.out,{'batch':BATCH,'jobs':jobs,'count':len(jobs),'stage_dependencies':STAGE_DEPENDENCIES,
+        'gate_type':'technical_and_integrity_only; no accuracy-threshold selection'})
+
+if __name__=='__main__':main()
