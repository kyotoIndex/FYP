--- /dev/null
+++ b/scripts/audit_pcla_results.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Read-only inventory of all legacy metric CSVs; never upgrades unknown runs."""
+import argparse,csv,json,math
+from pathlib import Path
+
+
+def audit_file(path, expected_config=None):
+    rows=list(csv.DictReader(path.open(encoding="utf-8-sig",newline="")))
+    config_path=path.parent/"run_config.json"
+    config=json.loads(config_path.read_text(encoding="utf-8")) if config_path.exists() else {}
+    declared=expected_config or config
+    expected=declared.get("federated",{}).get("rounds")
+    methods=set(declared.get("executed_methods",declared.get("baselines",[])))|{r["method"] for r in rows}
+    summary_path=path.parent/"summary_to_target.csv"
+    summary={r["method"]:r for r in csv.DictReader(summary_path.open(encoding="utf-8-sig",newline=""))} if summary_path.exists() else {}
+    result=[]
+    for method in sorted(methods):
+        mr=[r for r in rows if r["method"]==method]
+        ids=[int(r["round"]) for r in mr]
+        problems=[]
+        if len(set(ids))!=len(ids): problems.append("duplicate round")
+        if any(not math.isfinite(float(r["accuracy"])) or not 0<=float(r["accuracy"])<=1 for r in mr):
+            problems.append("invalid accuracy")
+        complete=expected is not None and sorted(ids)==list(range(1,expected+1)) and not problems
+        ordered=sorted(mr,key=lambda x:int(x["round"]))
+        if ordered and method in summary and abs(float(summary[method]["final_accuracy"])-float(ordered[-1]["accuracy"]))>1e-12:
+            problems.append("stored summary differs from metric endpoint");complete=False
+        scopes={(r.get("evaluation_scope"),r.get("evaluation_samples")) for r in ordered[-5:]}
+        result.append({"file":str(path),"method":method,"expected_rounds":expected,"observed_rounds":len(ids),
+                       "status":"complete" if complete else ("unknown_expected_rounds" if expected is None else "incomplete_or_invalid"),
+                       "final_accuracy":None if not ordered else float(ordered[-1]["accuracy"]),
+                       "last5_same_scope":len(scopes)<=1,"problems":problems,
+                       "model":config.get("dataset",{}).get("model"),"stage":config.get("stage"),
+                       "protocol":config.get("protocol_version"),"model_checkpoint_present":any(path.parent.glob("*.pt"))})
+    return result
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument("--root",type=Path,required=True);p.add_argument("--out",type=Path,required=True)
+    p.add_argument("--expected-config",type=Path,help="For one protocol root only; supplies missing-run expectations")
+    args=p.parse_args();records=[]
+    expected_config=json.loads(args.expected_config.read_text()) if args.expected_config else None
+    for path in sorted(args.root.rglob("fedhello_metrics.csv")):
+        try: records.extend(audit_file(path,expected_config))
+        except Exception as exc: records.append({"file":str(path),"status":"unreadable","error":str(exc)})
+    args.out.parent.mkdir(parents=True,exist_ok=True)
+    missing_seeds=[] if expected_config is None else [seed for seed in expected_config.get("federated",{}).get("seeds",[]) if not (args.root/f"seed_{seed}/fedhello_metrics.csv").exists()]
+    args.out.write_text(json.dumps({"metric_files":len(list(args.root.rglob('fedhello_metrics.csv'))),"missing_seed_metrics":missing_seeds,"records":records},ensure_ascii=False,indent=2),encoding="utf-8")
+    print(f"Read {len(records)} method records. Unknown/failed runs remain in the inventory.")
+if __name__=="__main__":main()
