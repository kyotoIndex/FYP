+def main():
+    p=argparse.ArgumentParser();sub=p.add_subparsers(dest='cmd',required=True)
+    q=sub.add_parser('init');q.add_argument('--site',required=True);q.add_argument('--queue',required=True);q.add_argument('--test-report',required=True)
+    q=sub.add_parser('worker');q.add_argument('--queue',required=True);q.add_argument('--pool',choices=('4090','A100'),required=True)
+    q.add_argument('--max-jobs',type=int,default=100);q.add_argument('--test-cpu',action='store_true')
+    for name in ('doctor','ready'):
+        q=sub.add_parser(name);q.add_argument('--queue',required=True)
+        if name=='ready':q.add_argument('--pool',choices=('4090','A100'),default='4090')
+    q=sub.add_parser('recover');q.add_argument('--queue',required=True);q.add_argument('--job',required=True);q.add_argument('--evidence',required=True)
+    q=sub.add_parser('materialize');q.add_argument('--queue',required=True);q.add_argument('--out',required=True)
+    q=sub.add_parser('release-lease');q.add_argument('--queue',required=True);q.add_argument('--gpu-uuid',required=True);q.add_argument('--evidence',required=True)
+    q=sub.add_parser('cleanup');q.add_argument('--queue',required=True);q.add_argument('--job',required=True);q.add_argument('--verified-only',action='store_true')
