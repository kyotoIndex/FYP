+def process_dead(pid):
+    if not pid:return True
+    try:os.kill(int(pid),0)
+    except ProcessLookupError:return True
+    except PermissionError:return False
+    return False
+
+
+def recover(queue,job_id,evidence_path):
+    queue=Path(queue);plan=frozen(queue);e=read(evidence_path)
+    with transaction(queue):
+        s=read(queue/'status'/f'{job_id}.json')
+        require(s['state'] in ('running','interrupted','failed'),'job cannot be recovered')
+        require(s['attempt']==1,'recovery already used')
+        require(e['job']==job_id and e['token']==s['token'] and e['classification']=='external_interruption',
+                'recovery evidence does not identify this external interruption')
+        require(e.get('reason'),'reason required')
+        if s['worker']['host']==socket.gethostname():
+            require(process_dead(s.get('child_pid')) and process_dead(s['worker']['pid']), 'previous process still alive')
+        else:
+            require(e.get('slurm_step')==s['worker']['slurm_step'] and e.get('verified_dead') is True,
+                    'remote recovery needs verified Slurm accounting')
+            require(sha256(e['accounting_file'])==e['accounting_sha256'],'accounting evidence missing')
+        require(Path(s['work']).exists(),'old scratch must be recovered first')
+        cp=Path(s['work'])/'run'/'checkpoint.pt'
+        if not cp.exists():cp=Path(s['work'])/'run'/'run'/'checkpoint.pt'
+        require(cp.exists(),'no resumable checkpoint; request a separately documented restart')
+        atomic_json(queue/'recovery'/f'{job_id}_{time.time_ns()}.json',{'previous':s,'evidence':e})
+        (queue/'claims'/f'{job_id}.json').unlink(missing_ok=True)
+        atomic_json(queue/'status'/f'{job_id}.json',{'job':job_id,'state':'planned','attempt':1,
+                    'resume_from':s['work'],'recovery_reason':e['reason']})
+        # Reopen only descendants previously blocked by a technical dependency.
+        for j in plan['jobs']:
+            p=queue/'status'/f"{j['id']}.json";x=read(p)
+            if x['state']=='blocked' and x.get('reason')=='dependency_failed':
+                atomic_json(p,{'job':j['id'],'state':'planned','attempt':x['attempt']})
+
+
+def doctor(queue):
+    plan=frozen(queue);statuses=all_status(queue,plan)
+    return {'counts':{state:sum(s['state']==state for s in statuses.values())
+                      for state in sorted({s['state'] for s in statuses.values()})},
+            'nonterminal':[s for s in statuses.values() if s['state'] in ('running','interrupted')],
+            'leases':[read(p) for p in (Path(queue)/'leases').glob('*.json')],
+            'outcome_based_gates':False}
+
+
+def materialize(queue,out):
+    queue=Path(queue);plan=frozen(queue);out=Path(out);out.mkdir(parents=True,exist_ok=False)
+    records=[]
+    for j in plan['jobs']:
+        s=read(queue/'status'/f"{j['id']}.json")
+        if s.get('receipt'):
+            require(sha256(s['receipt'])==s['receipt_sha256'],'receipt integrity failed')
+            rec=read(s['receipt']);a=rec['archive']
+            extract_archive(a['path'],a['sha256'],out/j['id'])
+        records.append({'job':j['id'],'state':s['state'],'attempt':s['attempt']})
+    atomic_json(out/'inventory.json',records);atomic_json(out/'plan.json',plan)
+
+
+def release_lease(queue,gpu_uuid,evidence):
+    queue=Path(queue);frozen(queue);p=queue/'leases'/(gpu_uuid+'.json')
+    require(p.exists(),'lease missing');lease=read(p);e=read(evidence)
+    require(e.get('token')==lease['token'] and e.get('reason'),'lease release evidence differs')
+    if lease['host']==socket.gethostname():require(process_dead(lease['pid']),'lease process still active')
+    else:
+        require(e.get('verified_dead') is True and e.get('slurm_step')==lease.get('slurm_step'),
+                'remote lease needs verified Slurm accounting')
+        require(sha256(e['accounting_file'])==e['accounting_sha256'],'accounting evidence missing')
+    atomic_json(queue/'recovery'/('lease_'+str(time.time_ns())+'.json'),{'lease':lease,'evidence':e})
+    p.unlink()
+
+
+def cleanup(queue,job_id,verified_only):
+    import shutil
+    queue=Path(queue);plan=frozen(queue);s=read(queue/'status'/f'{job_id}.json')
+    require(verified_only and s['state']=='completed','cleanup requires verified completed job')
+    require(sha256(s['receipt'])==s['receipt_sha256'],'receipt changed')
+    record=read(s['receipt']);archive=record['archive'];verify_archive(archive['path'],archive['sha256'])
+    work=Path(s['work']).resolve();base=(Path(plan['site']['scratch_root'])/BATCH).resolve()
+    require(base in work.parents and work.name.startswith('attempt_'),'cleanup target outside new run scratch')
+    require(not (work/'run/.run.lock').exists(),'active run lock')
+    if work.exists():
+        from common import file_manifest
+        require(file_manifest(work)==verify_archive(archive['path'],archive['sha256']),'scratch changed after archival')
+        shutil.rmtree(work)
+    atomic_json(queue/'recovery'/('cleanup_'+job_id+'.json'),{'archive':archive,'work':str(work)})
+
