+def worker(queue,pool,max_jobs=100,test_cpu=False):
+    queue=Path(queue).resolve();plan=frozen(queue);site=plan['site'];testing=site.get('testing',False)
+    require(testing==test_cpu,'CPU worker mode must match explicit test site')
+    if not testing:
+        require(os.environ.get('SLURM_JOB_ID') and os.environ.get('SLURM_STEP_ID'),'use an existing Slurm job step')
+        import json
+        script = ('import json; from context import original_environment,visible_gpu; '
+                  f"original_environment('cuda',{site['threads_per_gpu']}); print(json.dumps(visible_gpu()))")
+        env = os.environ.copy(); env['PYTHONPATH'] = str(ROOT)+os.pathsep+env.get('PYTHONPATH','')
+        check = subprocess.run([site['python_pcla'],'-c',script],env=env,text=True,
+                               capture_output=True,check=True,timeout=180)
+        gpu=json.loads(check.stdout.splitlines()[-1])
+        # The preflight process exits here: it does not keep a second CUDA context resident.
+        if pool=='4090':require('4090' in gpu['name'],'scientific pool must use RTX4090 family')
+        elif pool=='A100':require('A100' in gpu['name'],'A100 pool device differs')
+    else:gpu={'uuid':'CPU-TEST-'+str(os.getpid()),'name':'synthetic CPU'}
+    meta={'host':socket.gethostname(),'pid':os.getpid(),'pool':pool,'gpu':gpu,
+          'slurm_step':str(os.environ.get('SLURM_JOB_ID'))+'.'+str(os.environ.get('SLURM_STEP_ID')),
+          'cpu_affinity':sorted(os.sched_getaffinity(0))}
+    with exclusive(queue/'leases'/(gpu['uuid']+'.json'),meta):
+        finished=0
+        while finished<max_jobs:
+            ready=ready_jobs(queue,pool)
+            if not ready:
+                statuses=all_status(queue,plan)
+                if all(s['state'] in ('completed','failed','blocked','interrupted') for s in statuses.values()):break
+                if testing:break
+                compatible = [j for j in plan['jobs'] if (j['pool']=='technical' or j['pool']==pool)
+                              and statuses[j['id']]['state'] in ('planned','running')]
+                if not compatible:break
+                if compatible and all((queue/'pauses'/f"{j['stage']}.json").exists() for j in compatible):break
+                # Closed work on the other GPU family does not justify a busy loop.
+                time.sleep(site['idle_seconds']);continue
+            job=ready[0]
+            try:c=claim(queue,job['id'],meta)
+            except ValueError:continue  # another worker won the atomic transaction
+            attempt=c['attempt']
+            work=Path(site['scratch_root'])/BATCH/socket.gethostname()/job['id']/f'attempt_{attempt}'
+            try:
+                work.mkdir(parents=True,exist_ok=False)
+                update_running(queue,job['id'],c['token'],work=str(work),child_pid=None)
+            except BaseException:
+                # Do not overwrite an existing scratch tree or leave an unexplained running claim.
+                with transaction(queue):
+                    state=read(queue/'status'/f"{job['id']}.json")
+                    atomic_json(queue/'status'/f"{job['id']}.json",{**state,'state':'interrupted',
+                        'reason':'scratch_setup_failed','requested_work':str(work),
+                        'error':traceback.format_exc()})
+                raise
+            returncode=-1;error=None;proc=None
+            try:
+                if not testing:
+                    for path,digest in plan['input_sha256'].items():
+                        if f"seed_{job['seed']}/" in path:
+                            require(sha256(path)==digest,'frozen input checkpoint changed')
+                deps={}
+                for dep in job.get('depends',[]):
+                    if dep!=job.get('donor'):continue
+                    s=read(queue/'status'/f'{dep}.json');receipt=read(s['receipt'])
+                    require(sha256(s['receipt'])==s['receipt_sha256'],'dependency receipt changed')
+                    a=receipt['archive'];cache=Path(site['scratch_root'])/BATCH/'cache'/a['sha256']
+                    if not cache.exists():extract_archive(a['path'],a['sha256'],cache)
+                    else:require(read(cache/'EXTRACTION_RECEIPT.json')['archive_sha256']==a['sha256'],'bad dependency cache')
+                    deps[dep]=str(cache)
+                if c.get('resume_from'):
+                    import shutil
+                    old=Path(c['resume_from'])
+                    require(old.exists(),'old scratch missing; materialize the prior attempt before recovery')
+                    shutil.copytree(old/'run',work/'run')
+                    # A dead process can leave a run lock. Preserve it before removal.
+                    lock=work/'run/.run.lock'
+                    if lock.exists():lock.rename(work/'previous_dead_run_lock.json')
+                atomic_json(work/'job.json',job)
+                dependency_path=work.parent/('dependencies_'+c['token']+'.json');atomic_json(dependency_path,deps)
+                cmd=[site['python_pcla'],str(ROOT/'execute_job.py'),'--site',str(queue/'frozen_site.json'),
+                     '--job',str(work/'job.json'),'--out',str(work/'run'),'--dependencies',str(dependency_path)]
+                if c.get('resume_from'):cmd+=['--resume','--reason',c['recovery_reason']]
+                env=os.environ.copy();env['PYTHONDONTWRITEBYTECODE']='1'
+                if not testing:env['PCLA_EXPECTED_GPU_UUID']=gpu['uuid']
+                atomic_json(work/'command.json',{'argv':cmd,'environment_device':env.get('CUDA_VISIBLE_DEVICES')})
+                with (work/'console.log').open('w',encoding='utf-8') as log:
+                    proc=subprocess.Popen(cmd,stdout=log,stderr=subprocess.STDOUT,env=env,start_new_session=True)
+                    update_running(queue,job['id'],c['token'],child_pid=proc.pid)
+                    start=time.monotonic()
+                    while proc.poll() is None:
+                        if time.monotonic()-start>site['timeout_seconds']:
+                            os.killpg(proc.pid,signal.SIGTERM)
+                            try:proc.wait(timeout=20)
+                            except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL);proc.wait()
+                            raise RuntimeError('fixed technical wall-time cap exceeded; retain checkpoint')
+                        if not testing:update_running(queue,job['id'],c['token'])
+                        time.sleep(.05 if testing else 5)
+                    returncode=proc.returncode
+                if returncode:raise RuntimeError('job process failed; see console.log')
+            except BaseException:
+                if proc is not None and proc.poll() is None:
+                    os.killpg(proc.pid,signal.SIGTERM)
+                    try:proc.wait(timeout=20)
+                    except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL);proc.wait()
+                error=traceback.format_exc();(work/'worker_error.txt').write_text(error,encoding='utf-8')
+            try:finish(queue,job,c,work,returncode,error)
+            except BaseException:
+                # Retain a failed publication/audit rather than a false 'complete' flag.
+                (work/'publication_error.txt').write_text(traceback.format_exc(),encoding='utf-8')
+                with transaction(queue):
+                    s=read(queue/'status'/f"{job['id']}.json")
+                    atomic_json(queue/'status'/f"{job['id']}.json",{**s,'state':'interrupted','work':str(work),
+                        'reason':'audit_or_archive_publication_failed'})
+                raise
+            finished+=1
+    return finished
