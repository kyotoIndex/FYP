+def runtime_identity(python):
+    command=[python,'-c',"import sys,torch,json; print(json.dumps({'python':sys.version,'torch':str(torch.__version__),'cuda':torch.version.cuda}))"]
+    result=subprocess.run(command,text=True,capture_output=True,check=True,timeout=180)
+    import json
+    return json.loads(result.stdout.splitlines()[-1])
+
+
+def initialize(site_path,queue,test_report,custom_jobs=None):
+    site=read(site_path);queue=Path(queue).resolve()
+    require(not queue.exists(),'new queue directory required')
+    testing=bool(site.get('testing',False))
+    for key in ('repo','source_root','scratch_root'):
+        site[key]=str(Path(site[key]).resolve())
+    # A venv interpreter is a symlink to its base interpreter; resolving it drops the venv
+    # site-packages (V4.1 attempt 1 ran Transformers 4.57.6 from the linked kvaf_tooling env).
+    site['python_pcla']=os.path.abspath(site['python_pcla'])
+    verify_repo(site['repo'])
+    require(Path(site['python_pcla']).is_file(),'Python executable missing')
+    tests=read(test_report)
+    require(tests.get('passed') is True and tests.get('source_files')==source_files(),'CPU tests missing, failed or stale')
+    jobs=custom_jobs or build();require(testing or jobs==build(),'production plan cannot be changed by site config')
+    validate(jobs)
+    site.setdefault('threads_per_gpu',4);site.setdefault('timeout_seconds',3600)
+    site.setdefault('idle_seconds',5);site.setdefault('require_slurm',True)
+    site['queue_root']=str(queue)
+    require(Path(site['source_root'])!=queue and Path(site['repo']) not in queue.parents,
+            'queue must be outside the source repository and source results')
+    sources={}
+    if not testing:
+        from context import load_original
+        for seed in (7,13,21,42,87):
+            for policy in ('pcla','random','replay_random_rank','full_alt'):
+                cp,path=load_original(site['source_root'],seed,policy,site['repo'])
+                sources[str(path)]=sha256(path)
+                if policy=='pcla':
+                    for r in (5,15):
+                        p=path.parent/f'probe_round_{r:03d}.pt';require(p.exists(),'G0 anchor missing');sources[str(p)]=sha256(p)
+        for rel,expected in read(ROOT/'reference_assets/model_files_sha256.json').items():
+            require(sha256(Path(site['repo'])/rel)==expected,'BERT asset hash differs: '+rel)
+    runtime=runtime_identity(site['python_pcla'])
+    if not testing:
+        require(runtime['torch']=='2.5.1+cu121' and runtime['cuda']=='12.1','use original PCLA execution environment')
+        tf=subprocess.run([site['python_pcla'],'-c',"import importlib.metadata as m; print(m.version('transformers'))"],
+                          text=True,capture_output=True,check=True,timeout=180).stdout.split()[-1]
+        require(tf=='4.57.1','interpreter does not import the original Transformers 4.57.1: '+tf)
+        runtime['transformers']=tf
+    manifest={'batch':BATCH,'site':site,'jobs':jobs,'stage_dependencies':STAGE_DEPENDENCIES,
+              'source_files':source_files(),'input_sha256':sources,'runtime':runtime,
+              'python_executable_sha256':sha256(site['python_pcla']),
+              'cpu_test_report_sha256':sha256(test_report),'created':time.time()}
+    queue.mkdir(parents=True)
+    for d in ('status','claims','leases','archives','receipts','recovery','pauses'):(queue/d).mkdir()
+    atomic_json(queue/'FROZEN.json',manifest)
+    atomic_json(queue/'FROZEN_SHA256.json',{'sha256':sha256(queue/'FROZEN.json')})
+    atomic_json(queue/'frozen_site.json',site)
+    for j in jobs:
+        atomic_json(queue/'status'/f"{j['id']}.json",{'job':j['id'],'state':'planned','attempt':0})
+    return manifest
+
+
+def frozen(queue):
+    queue=Path(queue)
+    require(sha256(queue/'FROZEN.json')==read(queue/'FROZEN_SHA256.json')['sha256'],'frozen plan changed')
+    data=read(queue/'FROZEN.json')
+    require(data['source_files']==source_files(),'code changed since queue initialization')
+    require(read(queue/'frozen_site.json')==data['site'],'frozen site changed')
+    require(sha256(data['site']['python_pcla'])==data['python_executable_sha256'],'Python executable changed')
+    return data
+
+
+@contextlib.contextmanager
+def transaction(queue):
+    p=Path(queue)/'.queue.lock';deadline=time.monotonic()+20
+    while True:
+        try:
+            p.mkdir();break
+        except FileExistsError:
+            require(time.monotonic()<deadline,'queue transaction lock stale/busy; doctor required')
+            time.sleep(.03)
+    try:yield
+    finally:p.rmdir()
+
+
+def all_status(queue,plan):
+    return {j['id']:read(Path(queue)/'status'/f"{j['id']}.json") for j in plan['jobs']}
+
+
+def dependencies(job,plan):
+    stages=plan['stage_dependencies'][job['stage']]
+    return set(job['depends'])|{j['id'] for j in plan['jobs'] if j['stage'] in stages}
+
+
+def mark_blocked(queue,plan,statuses):
+    bad={k for k,s in statuses.items() if s['state'] in ('failed','blocked')}
+    changed=True
+    while changed:
+        size=len(bad)
+        for job in plan['jobs']:
+            if statuses[job['id']]['state']=='planned' and dependencies(job,plan)&bad:
+                bad.add(job['id'])
+                value={**statuses[job['id']],'state':'blocked','reason':'dependency_failed',
+                       'blocked_by':sorted(dependencies(job,plan)&bad)}
+                statuses[job['id']]=value
+                atomic_json(Path(queue)/'status'/f"{job['id']}.json",value)
+        changed=len(bad)!=size
+    return statuses
+
+
+def ready_jobs(queue,pool):
+    plan=frozen(queue)
+    with transaction(queue):
+        statuses=mark_blocked(queue,plan,all_status(queue,plan))
+    done={k for k,s in statuses.items() if s['state']=='completed'}
+    return [j for j in sorted(plan['jobs'],key=lambda j:(j['priority'],j['id']))
+        if statuses[j['id']]['state']=='planned' and
+           (j['pool']=='technical' or j['pool']==pool) and
+           not (Path(queue)/'pauses'/f"{j['stage']}.json").exists() and dependencies(j,plan)<=done]
+
+
+def claim(queue,job_id,worker_meta):
+    queue=Path(queue);plan=frozen(queue);jobs={j['id']:j for j in plan['jobs']}
+    require(job_id in jobs,'unknown job')
+    with transaction(queue):
+        statuses=all_status(queue,plan);s=statuses[job_id];j=jobs[job_id]
+        require(s['state']=='planned','job is not claimable')
+        require(all(statuses[d]['state']=='completed' for d in dependencies(j,plan)),'dependency not verified')
+        require(not (queue/'pauses'/f"{j['stage']}.json").exists(),'stage paused')
+        require(j['pool']=='technical' or j['pool']==worker_meta['pool'],'wrong GPU pool')
+        token=uuid.uuid4().hex;attempt=s['attempt']+1
+        require(attempt<=2,'only one external-interruption recovery allowed')
+        cp={'job':job_id,'state':'running','attempt':attempt,'token':token,
+            'worker':worker_meta,'started':time.time(),'heartbeat':time.time(),
+            'resume_from':s.get('resume_from'),'recovery_reason':s.get('recovery_reason')}
+        fd=os.open(queue/'claims'/f'{job_id}.json',os.O_CREAT|os.O_EXCL|os.O_WRONLY,0o600)
+        import json
+        os.write(fd,json.dumps(cp).encode());os.fsync(fd);os.close(fd)
+        atomic_json(queue/'status'/f'{job_id}.json',cp)
+    return cp
+
+
+def update_running(queue,job_id,token,**values):
+    queue=Path(queue)
+    with transaction(queue):
+        s=read(queue/'status'/f'{job_id}.json')
+        require(s['state']=='running' and s['token']==token,'claim owner changed')
+        atomic_json(queue/'status'/f'{job_id}.json',{**s,**values,'heartbeat':time.time()})
+
+
+def finish(queue,job,claim_info,work,returncode,error=None):
+    queue=Path(queue);work=Path(work);plan=frozen(queue)
+    # A process exit alone is not a completed scientific result.
+    status='failed'
+    if returncode==0 and error is None:
+        import torch
+        torch.set_num_threads(plan['site']['threads_per_gpu'])
+        from audit_run import audit
+        report=audit(work/'run',plan['site']['repo'],require_complete=not bool(job.get('stop_after')))
+        require(report['audit_sources']==plan['source_files'],'audit source mismatch')
+        if job.get('parity') or job.get('mode')=='bridge_full_alt':
+            require(read(work/'run/parity.json')['passed'],'missing passing parity')
+        atomic_json(work/'audit.json',report);status='completed'
+    record={'job':job,'job_sha256':fingerprint(job),'attempt':claim_info['attempt'],
+            'token':claim_info['token'],'state':status,'exit_code':returncode,'error':error,
+            'worker':claim_info['worker'],'ended':time.time(),'source_files':source_files()}
+    atomic_json(work/'receipt.json',record)
+    archive=make_archive(work,queue/'archives'/f"{job['id']}_attempt{claim_info['attempt']}.zip")
+    record['archive']=archive
+    receipt_path=queue/'receipts'/f"{job['id']}_attempt{claim_info['attempt']}.json"
+    atomic_json(receipt_path,record)
+    with transaction(queue):
+        current=read(queue/'status'/f"{job['id']}.json")
+        require(current['token']==claim_info['token'],'completion token differs')
+        atomic_json(queue/'status'/f"{job['id']}.json",{**current,'state':status,'ended':time.time(),
+            'receipt':str(receipt_path),'receipt_sha256':sha256(receipt_path),'work':str(work)})
+        (queue/'claims'/f"{job['id']}.json").unlink()
+    return record
+
