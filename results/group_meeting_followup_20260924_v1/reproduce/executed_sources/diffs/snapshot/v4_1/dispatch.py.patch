+"""Frozen plan, atomic task claims, one-GPU workers, verified archives, explicit recovery."""
+from __future__ import annotations
+import argparse
+import contextlib
+import os
+from pathlib import Path
+import signal
+import socket
+import subprocess
+import sys
+import time
+import traceback
+import uuid
+
+from common import (ROOT,BATCH,read,require,atomic_json,sha256,fingerprint,source_files,
+                    verify_repo,exclusive,make_archive,verify_archive,extract_archive)
+from job_plan import build,validate,STAGE_DEPENDENCIES
