+def pooled_step(bundle, selected, r, optimizer, iid=False, factor='both', select=None):
+    from pcla_repair import core, runtime as rt
+    from pcla_repair.optimization_dev import make_optimizer
+    cfg, model = bundle.cfg, bundle.model
+    full = torch.ones(bundle.shape, dtype=torch.bool)
+    if select is None:
+        core.configure(model, bundle.layout, full, 'both', forward_mode=cfg['forward_mode'], head=cfg['train_head'])
+        if optimizer is None:
+            optimizer = make_optimizer(model, cfg)
+    if iid:
+        population, chosen = iid_draw(bundle, selected, r)
+        ds = Subset(ConcatDataset([bundle.clients[c] for c in population]), chosen)
+    else:
+        ds = ConcatDataset([bundle.clients[c] for c in selected])
+    guard, extra = None, {}
+    if select is not None:
+        support, selection = select(ds)
+        masks = core.configure(model, bundle.layout, support, factor, forward_mode=cfg['forward_mode'], head=cfg['train_head'])
+        optimizer = make_optimizer(model, cfg)  # per round, as each PCLA client round
+        guard = core.FrozenSliceGuard(model, masks)
+        extra = {'factor': factor, 'support': support.tolist(), 'selection': selection, 'optimizer_scope': OPTIMIZER_SCOPE}
+    params = [p for p in model.parameters() if p.requires_grad]
+    rt.seed_train(core.keyed_seed(bundle.seed, 'central_train', r))
+    model.train(); count = steps = 0; orders = []
+    for epoch in range(cfg['local_epochs']):
+        order = torch.randperm(len(ds), generator=torch.Generator().manual_seed(
+            core.keyed_seed(bundle.seed, 'central_order', r, epoch))).tolist()
+        orders.append(order)
+        for batch in rt.batches(Subset(ds, order), cfg['batch_size'], 0, shuffle=False):
+            optimizer.zero_grad(set_to_none=True)
+            loss = model(**rt.to_device(batch, bundle.device)).loss
+            require(bool(torch.isfinite(loss)), 'nonfinite pooled loss')
+            loss.backward()
+            require(all(p.grad is None or bool(torch.isfinite(p.grad).all()) for p in params),
+                    'nonfinite pooled gradient')
+            if cfg.get('clip_grad_norm') is not None:
+                torch.nn.utils.clip_grad_norm_(params, cfg['clip_grad_norm'])
+            optimizer.step(); count += batch['labels'].numel(); steps += 1
+            if guard is not None: guard.restore(optimizer)
+    model.zero_grad(set_to_none=True)
+    if guard is not None:
+        for p, mask, original in guard.items:
+            require(torch.equal(p.detach()[~mask], original[~mask]), 'unselected central entries changed')
+            require(all(not bool(v[~mask].any()) for v in optimizer.state.get(p, {}).values()
+                        if torch.is_tensor(v) and v.shape == p.shape), 'unselected optimizer moments are not zero')
+    if iid: extra.update(iid_readout(bundle, selected, population, chosen))
+    return optimizer, {'steps': steps, 'examples': count,
+                       'pooled_order_sha256': fingerprint(orders),
+                       'optimizer_tensor_parameters': sum(p.numel() for p in params), **extra}
+
+
+def default_opts():
+    return SimpleNamespace(server_lr=1.0, strata=None, fractions=None, central_layers=None, utility=None)
+
+
+def train_round(bundle, mode, r, optimizer=None, save_bank=False, frozen_a=None, opts=None):
+    from pcla_repair import core, runtime as rt
+    opts = opts or default_opts()
+    cfg, model = bundle.cfg, bundle.model
+    selected = client_sequence(bundle, r, opts.strata)
+    full = torch.ones(bundle.shape, dtype=torch.bool)
+    before = core.adapter_state(model)
+    base = projection_state(model)
+    before_projection_digest = core.tensor_digest(base)
+    mods = core.lora_modules(model)
+    info = {'round': r, 'mode': mode, 'selected_clients': selected,
+            'base_before_sha256': before_projection_digest,
+            'initial_round_adapter_sha256': core.tensor_digest(before),
+            'sample_multiset_sha256': fingerprint([s for c in selected for s in bundle.partition['clients'][str(c)]]),
+            'download_bytes': 0, 'upload_bytes': 0, 'client_details': []}
+    if opts.strata is not None:
+        info.update({'cohort': 'label_stratified', 'participant_positive_fraction': [opts.fractions[c] for c in selected]})
+    rt.synchronize(bundle.device); started = time.perf_counter()
+    bank, alternative = None, None
+    if mode in FFA:
+        require(frozen_a is not None and all(torch.equal(before[n], v) for n, v in frozen_a.items()),
+                'FFA shared A differs from initial A before round')
+        info['fidelity'] = FFA_FIDELITY if mode == 'fed_ffa_b' else FFA_SVD_FIDELITY
+    if mode in POOLED:
+        if mode in IID: info['cohort_sample_multiset_sha256'] = info['sample_multiset_sha256']
+        factor = ('b' if r % 2 else 'a') if mode in CENTRAL_ALT else 'both'
+        select = central_selector(bundle, mode, r, factor, opts) if mode in CENTRAL_ALT else None
+        optimizer, extra = pooled_step(bundle, selected, r, optimizer, mode in IID, factor, select); info.update(extra)
+        if mode in CENTRAL_ALT:
+            support = torch.tensor(info['support'], dtype=torch.bool); after = core.adapter_state(model)
+            partner = 'a' if factor == 'b' else 'b'
+            for n in mods:
+                keep = support[bundle.layout[n]]; keep = keep[:, None] if factor == 'a' else keep[None, :]
+                key = n+'.lora_'+factor
+                require(torch.equal(after[n+'.lora_'+partner], before[n+'.lora_'+partner]) and
+                        torch.equal(after[key][~keep.expand_as(after[key])], before[key][~keep.expand_as(after[key])]),
+                        'central frozen position changed')
+            info['central_budget'] = {'layers': int(support.any(1).sum()), 'components': int(support.sum())}
+            if save_bank: bank = {'parent_adapter': before, 'support': support, 'factor': factor, 'layout': dict(bundle.layout),
+                                  'round_optimizer_state': copy.deepcopy(optimizer.state_dict()['state']),
+                                  'optimizer_names': optimizer_names(model, optimizer)}
+            optimizer = None
+    else:
+        fed = mode in FED
+        factor = ('b' if r % 2 else 'a') if mode in ALT else 'b' if mode in FFA else 'both'
+        total = sum(len(bundle.clients[c]) for c in selected)
+        accumulator = core.DeltaAccumulator(before, total, 'fixed') if fed else None
+        targets = {n: torch.zeros_like(m.base.weight, dtype=torch.float64, device='cpu') for n,m in mods.items()} if fed else None
+        bank = {'parent_adapter': before, 'parent_projections': base, 'clients': [],
+                'scalings': {n: float(m.scaling) for n,m in mods.items()}, 'factor': factor} if fed and save_bank else None
+        info.update({'steps': 0, 'examples': 0, 'factor': factor})
+        if fed:
+            down = {'round': r, 'adapter': before}
+            if mode in BASE_CHANGING: down['server_projection_weights'] = base
+            per_download = rt.payload_size(down)
+            info['download_bytes'] = per_download*len(selected)
+            if mode in FFA:
+                info['download_bytes_b_head_only'] = rt.payload_size({'round': r, 'adapter': {
+                    n: v for n, v in before.items() if not n.endswith('.lora_a')}})*len(selected)
+        for cid in selected:
+            if fed: core.load_adapter(model, before)
+            local_start = core.adapter_state(model)
+            masks, seconds, allocated = rt.local_train(model, bundle.layout, bundle.clients[cid], full,
+                factor, core.keyed_seed(bundle.seed,'train',r,cid), cfg, bundle.device)
+            local = core.adapter_state(model)
+            if factor in ('a','b'):
+                partner = 'a' if factor == 'b' else 'b'
+                for n in mods:
+                    require(torch.equal(local[n+'.lora_'+partner], local_start[n+'.lora_'+partner]),
+                            'common frozen factor changed')
+            steps = math.ceil(len(bundle.clients[cid])/cfg['batch_size'])*cfg['local_epochs']
+            samples = len(bundle.clients[cid])*cfg['local_epochs']
+            info['steps'] += steps; info['examples'] += samples
+            info['client_details'].append({'client': cid, 'sample_weight': len(bundle.clients[cid]),
+                'steps_derived': steps, 'examples_derived': samples, 'train_seconds': seconds,
+                'optimizer_tensor_parameters': allocated, 'factor': factor})
+            if fed:
+                accumulator.add(local,masks,len(bundle.clients[cid]))
+                for n,m in mods.items():
+                    targets[n] += len(bundle.clients[cid])*float(m.scaling)*(local[n+'.lora_b'].double()@local[n+'.lora_a'].double())
+                info['upload_bytes'] += rt.payload_size(rt.upload_payload(before,local,bundle.layout,full,masks,r,cid,factor))
+                if bank is not None:
+                    bank['clients'].append({'client': cid,'weight': len(bundle.clients[cid]),'adapter': local})
+        require(core.tensor_digest(projection_state(model)) == before_projection_digest,
+                'local training modified frozen projection weights')
+        if fed:
+            mean, new = server_update(accumulator, opts.server_lr)
+            if mode in FFA:
+                require(all(torch.equal(new[n], v) for n, v in frozen_a.items()), 'FFA shared A changed')
+                info['lora_a_sha256'] = core.tensor_digest({n: new[n] for n in frozen_a})
+                info['post_round_adapter_sha256'] = core.tensor_digest(new)
+            corrected, algebra = {}, []
+            for n,m in mods.items():
+                target = targets[n]/total
+                corrected[n], record = exact_server_correction(base[n],mean[n+'.lora_b'],mean[n+'.lora_a'],float(m.scaling),target)
+                algebra.append({'module': n, **record})
+            if mode in SHARED_PARTNER:
+                # Common partner implies exactness up to averaging/cast arithmetic.
+                require(all(x['residual_norm'] < 1e-4*max(1., x['target_norm']) for x in algebra),
+                        'alternating shared-factor algebra does not match')
+            if mode == 'fed_both_exact':
+                load_projections(model, corrected)
+                if save_bank: alternative = {'adapter': mean, 'base': base, 'treatment': 'mean_same_updates'}
+            elif mode == 'fed_both_mean' and save_bank and opts.server_lr == 1:
+                alternative = {'adapter': mean, 'base': corrected, 'treatment': 'exact_same_updates'}
+            if mode in SVD_REFACTOR:
+                new, refactored, info['svd'] = svd_refactor(mean, corrected if mode == 'fed_svd_refactor' else base,
+                                                           {n: float(m.scaling) for n, m in mods.items()})
+                load_projections(model, refactored)
+                info.update({'post_round_adapter_sha256': core.tensor_digest(new),
+                             'post_round_base_sha256': core.tensor_digest(refactored)})
+            if opts.server_lr != 1:
+                info.update({'server_lr': opts.server_lr, 'aggregate_mean_sha256': core.tensor_digest(mean),
+                             'post_round_adapter_sha256': core.tensor_digest(new)})
+            core.load_adapter(model, new)
+            info['algebra'] = algebra
+        else:
+            info['algebra'] = []
+    require((info['steps'],info['examples']) == expected_work(bundle,selected), 'sample/step budget differs')
+    if mode not in BASE_CHANGING:
+        require(core.tensor_digest(projection_state(model)) == before_projection_digest, 'base unexpectedly changed')
+    rt.synchronize(bundle.device)
+    info['training_and_server_seconds'] = time.perf_counter()-started
+    info['steps_measurement'] = 'observed_batches' if mode in POOLED else 'derived_from_fixed_full_local_epoch'
+    return optimizer, info, bank, alternative
+
+
+def fed_sa_round(bundle, r, personal, save_bank=False, opts=None):
+    """FedSA-LoRA style: A and head are averaged with a fixed denominator; B never leaves its client."""
+    from pcla_repair import core, runtime as rt
+    opts = opts or default_opts()
+    cfg, model = bundle.cfg, bundle.model
+    selected = client_sequence(bundle, r, opts.strata)
+    full = torch.ones(bundle.shape, dtype=torch.bool)
+    before = core.adapter_state(model); base = projection_state(model)
+    shared = {n: v for n, v in before.items() if not n.endswith('.lora_b')}
+    total = sum(len(bundle.clients[c]) for c in selected)
+    accumulator = core.DeltaAccumulator(shared, total, 'fixed')
+    info = {'round': r, 'mode': 'fed_sa', 'selected_clients': selected, 'base_before_sha256': core.tensor_digest(base),
+            'initial_round_adapter_sha256': core.tensor_digest(before),
+            'initial_round_shared_sha256': core.tensor_digest(shared),
+            'personal_b_before_sha256': {str(c): core.tensor_digest(personal[c]) for c in selected},
+            'sample_multiset_sha256': fingerprint([s for c in selected for s in bundle.partition['clients'][str(c)]]),
+            'download_bytes': rt.payload_size({'round': r, 'adapter': shared})*len(selected), 'upload_bytes': 0,
+            'client_details': [], 'steps': 0, 'examples': 0, 'factor': 'both', 'algebra': []}
+    if opts.strata is not None:
+        info.update({'cohort': 'label_stratified', 'participant_positive_fraction': [opts.fractions[c] for c in selected]})
+    bank = {'parent_shared': shared, 'parent_personal_b': {str(c): personal[c] for c in selected},
+            'clients': []} if save_bank else None
+    rt.synchronize(bundle.device); started = time.perf_counter()
+    for cid in selected:
+        core.load_adapter(model, {**shared, **personal[cid]})
+        masks, seconds, allocated = rt.local_train(model, bundle.layout, bundle.clients[cid], full, 'both',
+            core.keyed_seed(bundle.seed, 'train', r, cid), cfg, bundle.device)
+        local = core.adapter_state(model); weight = len(bundle.clients[cid])
+        accumulator.add({n: local[n] for n in shared}, {n: masks[n] for n in shared}, weight)
+        personal[cid] = {n: v for n, v in local.items() if n.endswith('.lora_b')}
+        steps = math.ceil(weight/cfg['batch_size'])*cfg['local_epochs']
+        info['steps'] += steps; info['examples'] += weight*cfg['local_epochs']
+        info['upload_bytes'] += rt.payload_size(rt.upload_payload(shared, local, bundle.layout, full,
+                                                {n: masks[n] for n in shared}, r, cid, 'both'))
+        info['client_details'].append({'client': cid, 'sample_weight': weight, 'steps_derived': steps,
+            'examples_derived': weight*cfg['local_epochs'], 'train_seconds': seconds,
+            'optimizer_tensor_parameters': allocated, 'factor': 'both'})
+        if bank is not None: bank['clients'].append({'client': cid, 'weight': weight, 'adapter': local})
+    require(core.tensor_digest(projection_state(model)) == info['base_before_sha256'], 'base unexpectedly changed')
+    new_shared = accumulator.finish(); mean_b = mean_personal_b(personal)
+    core.load_adapter(model, {**new_shared, **mean_b})
+    info.update({'post_round_shared_sha256': core.tensor_digest(new_shared),
+                 'personal_b_after_sha256': {str(c): core.tensor_digest(personal[c]) for c in sorted(personal)},
+                 'mean_personal_b_sha256': core.tensor_digest(mean_b),
+                 'evaluation_state': 'shared A/head + uniform mean of all personal B'})
+    require((info['steps'], info['examples']) == expected_work(bundle, selected), 'sample/step budget differs')
+    rt.synchronize(bundle.device)
+    info['training_and_server_seconds'] = time.perf_counter()-started
+    info['steps_measurement'] = 'derived_from_fixed_full_local_epoch'
+    return info, bank
+
