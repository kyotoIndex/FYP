+def resolve_params(bundle, mode, rounds=None, server_lr=1.0, cohort='uniform', ema_readout=None):
+    rounds = bundle.cfg['rounds'] if rounds is None else rounds
+    server_lr = float(server_lr); ema = None if ema_readout is None else float(ema_readout)
+    require(type(rounds) is int and rounds >= 1, 'rounds must be a positive integer')
+    require(math.isfinite(server_lr) and server_lr > 0, 'server_lr must be finite and positive')
+    require(cohort in COHORTS, 'unknown cohort')
+    require(ema is None or 0 < ema < 1, 'EMA beta must lie in (0,1)')
+    require(server_lr == 1 or mode in SERVER_LR_MODES, 'server_lr needs a base-invariant federated mean')
+    require(ema is None or mode in EMA_MODES, 'EMA readout needs an invariant base and one global state')
+    require(cohort == 'uniform' or mode != 'local_only', 'local_only has no cohort')
+    if mode == 'bridge_full_alt':
+        require((rounds, server_lr, cohort, ema) == (bundle.cfg['rounds'], 1.0, 'uniform', None),
+                'bridge parity requires the source protocol')
+    return {'rounds': rounds, 'server_lr': server_lr, 'cohort': cohort, 'ema_readout': ema}
