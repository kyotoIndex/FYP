+def run_local_only(bundle, out, params, stop_after=None, resume=False, recovery_reason=None):
+    """Each client alone: same initial model, fresh AdamW, LOCAL_ONLY_EPOCHS epochs, own local test set."""
+    from pcla_repair import core, runtime as rt
+    ids, labels, tests = bundle.local_test()
+    model, order = bundle.model, sorted(bundle.clients)
+    initial, base = core.adapter_state(model), projection_state(model)
+    frozen_hash = frozen_other_digest(model)
+    identity = {**base_study(bundle), 'kind': 'lora_control', 'mode': 'local_only', 'config': bundle.cfg,
+                'provenance': bundle.provenance, 'initial_projections_sha256': core.tensor_digest(base),
+                'other_frozen_sha256': frozen_hash, 'params': params, 'local_only_epochs': LOCAL_ONLY_EPOCHS,
+                'client_order': order, 'local_test_sha256': fingerprint([ids, labels])}
+    identifier = fingerprint(identity); checkpoint = out/'checkpoint.pt'; metrics, start = [], 0
+    with exclusive(out/'.run.lock', {'identity_hash': identifier}):
+        if resume:
+            require(recovery_reason and checkpoint.exists(), 'resume requires checkpoint and reason')
+            cp = tensor_load(checkpoint); require(cp['identity_hash'] == identifier, 'resume identity differs')
+            committed = set()
+            for row in cp['metrics']:
+                for rel, h in row['evidence'].items(): require(sha256(out/rel) == h, 'committed record changed'); committed.add(rel)
+            late = [p for p in (out/'clients').glob('*.json') if p.relative_to(out).as_posix() not in committed]
+            recover_uncommitted(out, cp['round'], late+([out/'personal_evaluation.json'] if (out/'personal_evaluation.json').exists() else []))
+            metrics, start = cp['metrics'], cp['round']
+        else:
+            atomic_json(out/'study.json', {'kind': 'lora_control', 'identity': identity, 'identity_hash': identifier})
+            write_evaluation_identity(out, bundle)
+        start_attempt(out, start, recovery_reason)
+        def state(i):
+            return {'format': 'pcla-control-v4.1', 'identity': identity, 'identity_hash': identifier, 'round': i,
+                    'adapter': initial, 'projections': base, 'optimizer': None, 'metrics': copy.deepcopy(metrics)}
+        try:
+            if start == 0: atomic_torch(checkpoint, state(0))
+            cfg = {**bundle.cfg, 'local_epochs': LOCAL_ONLY_EPOCHS}; full = torch.ones(bundle.shape, dtype=torch.bool)
+            for i, cid in enumerate(order[start:], start+1):
+                core.load_adapter(model, initial)
+                masks, seconds, allocated = rt.local_train(model, bundle.layout, bundle.clients[cid], full, 'both',
+                    core.keyed_seed(bundle.seed, 'local_only', cid), cfg, bundle.device)
+                local = core.adapter_state(model); n = len(bundle.clients[cid])
+                require(core.tensor_digest(projection_state(model)) == identity['initial_projections_sha256'], 'base changed')
+                record = {'client': cid, 'ordinal': i, 'mode': 'local_only', 'epochs': LOCAL_ONLY_EPOCHS,
+                          'steps': math.ceil(n/cfg['batch_size'])*LOCAL_ONLY_EPOCHS, 'examples': n*LOCAL_ONLY_EPOCHS,
+                          'train_seconds': seconds, 'optimizer_tensor_parameters': allocated,
+                          'initial_adapter_sha256': core.tensor_digest(initial), 'local_adapter_sha256': core.tensor_digest(local),
