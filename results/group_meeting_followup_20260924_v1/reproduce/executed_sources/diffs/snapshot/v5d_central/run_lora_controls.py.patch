+def label_strata(fractions, k):
+    order = sorted(fractions, key=lambda c: (fractions[c], c))
+    require(0 < k <= len(order), 'invalid stratification')
+    return [order[i*len(order)//k:(i+1)*len(order)//k] for i in range(k)]
