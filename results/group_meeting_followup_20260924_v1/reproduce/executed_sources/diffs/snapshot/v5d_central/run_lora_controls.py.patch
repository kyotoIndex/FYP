+def run_bundle(bundle, out, mode, stop_after=None, resume=False, recovery_reason=None,
+               rounds=None, server_lr=1.0, cohort='uniform', ema_readout=None, donor_dir=None):
+    from pcla_repair import core, runtime as rt
+    from pcla_repair.optimization_dev import make_optimizer
+    require(mode in MODES, 'unknown LoRA control')
+    params = resolve_params(bundle, mode, rounds, server_lr, cohort, ema_readout)
+    bundle.cfg['rounds'] = params['rounds']
+    out = Path(out); require(not out.exists() or resume, 'use new output directory')
+    out.mkdir(parents=True, exist_ok=True)
+    if mode == 'local_only':
+        return run_local_only(bundle, out, params, stop_after, resume, recovery_reason)
+    extra = {'params': params}
+    replay_records = None
+    if mode == 'central_replay_random_rank':
+        require(donor_dir is not None, 'central replay requires a completed central_pcla donor')
+        donor_dir = Path(donor_dir)
+        donor_cp = tensor_load(donor_dir/'checkpoint.pt')
+        donor_identity = donor_cp['identity']
+        require(donor_cp['round'] == params['rounds'] and donor_identity['mode'] == 'central_pcla' and
+                donor_identity['seed'] == bundle.seed and donor_identity['config'] == bundle.cfg and
+                donor_identity['params'] == params and donor_cp['identity_hash'] == fingerprint(donor_identity),
+                'central donor mode, seed, config, horizon or identity differs')
+        common = base_study(bundle)
+        for key in ('source_original_identity', 'source_original_checkpoint_sha256',
+                    'partition_sha256', 'initial_adapter_sha256'):
+            require(donor_identity[key] == common[key], 'central donor initial study differs: '+key)
+        require(len(donor_cp['metrics']) == params['rounds'], 'central donor metrics incomplete')
+        replay_records = {}
+        for r, row in enumerate(donor_cp['metrics'], 1):
+            path = donor_dir/'rounds'/f'{r:03d}'/'record.json'
+            digest = sha256(path)
+            require(row['round'] == r and row['evidence'][f'rounds/{r:03d}/record.json'] == digest,
+                    'central donor record differs from committed checkpoint')
+            record = read(path)
+            require(record['round'] == r and record['mode'] == 'central_pcla' and
+                    record['factor'] == ('b' if r%2 else 'a'), 'central donor round/factor differs')
+            replay_records[r] = {'support': record['support'], 'record_sha256': digest,
+                                 'selected_clients': record['selected_clients'],
+                                 'sample_multiset_sha256': record['sample_multiset_sha256'],
+                                 'pooled_order_sha256': record['pooled_order_sha256']}
+        extra['matched_donor'] = {'checkpoint_sha256': sha256(donor_dir/'checkpoint.pt'),
+                                  'identity_hash': donor_cp['identity_hash'],
+                                  'record_sha256': {str(r): x['record_sha256'] for r,x in replay_records.items()}}
+    if mode == 'ffa_svd_basis':
+        random_adapter = core.adapter_state(bundle.model)
+        extra['svd_basis'] = {'random_initial_adapter_sha256': core.tensor_digest(random_adapter),
+                              'modules': svd_basis(bundle.model)}
+    opts = default_opts(); opts.server_lr = params['server_lr']
+    if params['cohort'] == 'label_stratified':
+        opts.fractions = positive_fractions(bundle)
+        opts.strata = label_strata(opts.fractions, bundle.cfg['selected_clients'])
+        extra.update({'strata': opts.strata, 'client_positive_fraction': {str(c): v for c, v in opts.fractions.items()}})
+    if mode in CENTRAL_ALT:
+        layers, rank = bundle.shape
+        opts.central_layers = layers if mode == 'central_full_alt' else 2 if bundle.synthetic else CENTRAL_LAYERS
+        credits = rank if mode == 'central_full_alt' else bundle.cfg['credits_per_layer']
+        extra['central_budget'] = {'layers': opts.central_layers, 'credits_per_layer': credits,
+                                   'components': opts.central_layers*credits,
+                                   'selection': {'central_full_alt': 'all', 'central_pcla': 'pcla',
+                                                 'central_random_rank': 'random',
+                                                 'central_replay_random_rank': 'matched_replay_random_rank'}[mode]}
+        extra['optimizer_scope'] = OPTIMIZER_SCOPE
+        if mode == 'central_pcla': opts.utility = {'a': core.UtilityState(), 'b': core.UtilityState()}
+        if mode == 'central_replay_random_rank':
+            opts.replay_supports = {r: x['support'] for r,x in replay_records.items()}
+            opts.replay_record_hashes = {r: x['record_sha256'] for r,x in replay_records.items()}
+    personal = tests = None
+    if mode == 'fed_sa':
+        ids, labels, tests = bundle.local_test()
+        initial_b = {n: v for n, v in core.adapter_state(bundle.model).items() if n.endswith('.lora_b')}
+        personal = {c: dict(initial_b) for c in sorted(bundle.clients)}
+        extra.update({'local_test_sha256': fingerprint([ids, labels]), 'initial_personal_b_sha256': core.tensor_digest(initial_b)})
+    original_base = projection_state(bundle.model)
+    frozen_hash = frozen_other_digest(bundle.model)
+    frozen_a = {n: v for n, v in core.adapter_state(bundle.model).items() if n.endswith('.lora_a')} if mode in FFA else None
+    identity = {**base_study(bundle), 'kind': 'lora_control', 'mode': mode,
+                'config': bundle.cfg, 'provenance': bundle.provenance,
+                'initial_projections_sha256': core.tensor_digest(original_base),
+                'other_frozen_sha256': frozen_hash, **extra}
+    identifier = fingerprint(identity)
+    checkpoint = out/'checkpoint.pt'
+    optimizer, metrics, start, ema = None, [], 1, None
+    beta = params['ema_readout']
+    with exclusive(out/'.run.lock', {'identity_hash': identifier}):
+        if resume:
+            require(recovery_reason and checkpoint.exists(), 'resume requires checkpoint and reason')
+            cp = tensor_load(checkpoint)
+            require(cp['identity_hash'] == identifier, 'resume identity differs')
+            for row in cp['metrics']:
+                for rel,h in row['evidence'].items(): require(sha256(out/rel) == h, 'committed record changed')
+            # Save uncommitted round evidence, never silently erase it.
+            late = [out/'personal_evaluation.json'] if (out/'personal_evaluation.json').exists() and cp['round'] < params['rounds'] else []
+            recover_uncommitted(out, cp['round'], late)
+            core.load_adapter(bundle.model,cp['adapter']); load_projections(bundle.model,cp['projections'])
+            metrics, start = cp['metrics'], cp['round']+1
+            if cp['optimizer'] is not None:
+                core.configure(bundle.model,bundle.layout,torch.ones(bundle.shape,dtype=torch.bool),'both',head=True)
+                optimizer=make_optimizer(bundle.model,bundle.cfg); optimizer.load_state_dict(cp['optimizer'])
+            ema = cp.get('ema')
+            if mode == 'fed_sa': personal = {int(c): v for c, v in cp['personal_b'].items()}
+            if mode == 'central_pcla': opts.utility = {k: core.UtilityState(**v) for k, v in cp['utility_states'].items()}
+        else:
+            atomic_json(out/'study.json', {'kind':'lora_control','identity':identity,'identity_hash':identifier})
+            write_evaluation_identity(out,bundle)
+            if replay_records is not None: atomic_json(out/'matched_donor.json', replay_records)
+            if mode == 'ffa_svd_basis': atomic_torch(out/'random_initial_adapter.pt', random_adapter)
+        start_attempt(out, start, recovery_reason)
+        def state(r):
+            value = {'format':'pcla-control-v4.1','identity':identity,'identity_hash':identifier,
+                     'round':r,'adapter':core.adapter_state(bundle.model),'projections':projection_state(bundle.model),
+                     'optimizer':optimizer.state_dict() if optimizer else None,'metrics':copy.deepcopy(metrics)}
+            if beta is not None: value['ema'] = ema
+            if mode == 'fed_sa': value['personal_b'] = {str(c): v for c, v in personal.items()}
+            if mode == 'central_pcla': value['utility_states'] = {k: asdict(v) for k, v in opts.utility.items()}
+            return value
+        try:
+            if start==1:
+                baseline=rt.evaluate(bundle.model,bundle.layout,bundle.evaluation,bundle.cfg['eval_batch_size'],bundle.device,record_logits=True)
+                atomic_json(out/'evaluation_initial.json',baseline)
+                atomic_torch(checkpoint,state(0))
+            anchors=set(bundle.cfg['probe_rounds'])|{1,bundle.cfg['rounds']}
+            for r in range(start,bundle.cfg['rounds']+1):
+                if bundle.device.type=='cuda': torch.cuda.reset_peak_memory_stats(bundle.device)
+                if mode == 'fed_sa':
+                    (record, bank), alternative = fed_sa_round(bundle, r, personal, r in anchors, opts), None
+                else:
+                    optimizer,record,bank,alternative=train_round(bundle,mode,r,optimizer,save_bank=r in anchors,frozen_a=frozen_a,opts=opts)
+                record['evaluation']=rt.evaluate(bundle.model,bundle.layout,bundle.evaluation,
+                    bundle.cfg['eval_batch_size'],bundle.device,record_logits=True)
+                if replay_records is not None:
+                    donor_record = replay_records[r]
+                    require(record['selected_clients'] == donor_record['selected_clients'] and
+                            record['sample_multiset_sha256'] == donor_record['sample_multiset_sha256'] and
+                            record['pooled_order_sha256'] == donor_record['pooled_order_sha256'],
+                            'central replay training exposure/order differs from donor')
+                require(record['evaluation']['labels']==bundle.labels,'evaluation identity changed')
+                record['cuda_peak_allocated']=torch.cuda.max_memory_allocated(bundle.device) if bundle.device.type=='cuda' else 0
+                files=[]; directory=out/'rounds'/f'{r:03d}'; directory.mkdir(parents=True,exist_ok=False)
+                if alternative is not None:
+                    factual_adapter=core.adapter_state(bundle.model); factual_base=projection_state(bundle.model)
+                    load_projections(bundle.model,alternative['base']); core.load_adapter(bundle.model,alternative['adapter'])
+                    counter=rt.evaluate(bundle.model,bundle.layout,bundle.evaluation,bundle.cfg['eval_batch_size'],bundle.device,record_logits=True)
+                    record['same_update_alternative']={'treatment':alternative['treatment'],'evaluation':counter}
+                    load_projections(bundle.model,factual_base);core.load_adapter(bundle.model,factual_adapter)
+                ema_anchor = None
+                if beta is not None:
+                    current = core.adapter_state(bundle.model); factual = core.tensor_digest(current); previous = ema
+                    ema = ({n: v.double() for n, v in current.items()} if previous is None else
+                           {n: beta*previous[n]+(1-beta)*v.double() for n, v in current.items()})
+                    record['ema_readout'] = {'beta': beta, 'initialization': EMA_INIT, 'global_sha256': factual,
+                                             'ema_sha256': core.tensor_digest(ema),
+                                             'previous_ema_sha256': None if previous is None else core.tensor_digest(previous)}
+                    core.load_adapter(bundle.model, {n: v.to(current[n].dtype) for n, v in ema.items()})
+                    record['ema_evaluation'] = rt.evaluate(bundle.model, bundle.layout, bundle.evaluation,
+                        bundle.cfg['eval_batch_size'], bundle.device, record_logits=True)
+                    core.load_adapter(bundle.model, current)
+                    require(core.tensor_digest(core.adapter_state(bundle.model)) == factual, 'EMA readout changed the training state')
+                    if r in anchors: ema_anchor = {'previous': previous, 'current_global': current, 'ema': ema}
+                if mode == 'fed_sa' and r == bundle.cfg['rounds']:
+                    factual = core.adapter_state(bundle.model); shared = {n: v for n, v in factual.items() if not n.endswith('.lora_b')}
+                    readouts = {}
+                    for c in sorted(personal):
+                        core.load_adapter(bundle.model, {**shared, **personal[c]})
+                        readouts[str(c)] = local_readout(bundle, c, tests[c], ids[str(c)], labels[str(c)])
+                    core.load_adapter(bundle.model, factual)
+                    require(core.tensor_digest(core.adapter_state(bundle.model)) == core.tensor_digest(factual),
+                            'personal readout changed the training state')
+                    p=out/'personal_evaluation.json'
+                    atomic_json(p, personal_file(mode, bundle.seed, ids, labels, readouts, 'shared A/head + own personal B'))
+                    files.append(p)
+                p=directory/'record.json';atomic_json(p,record);files.append(p)
+                if bank is not None:
+                    name = 'fed_sa_bank.pt' if mode == 'fed_sa' else 'central_bank.pt' if mode in CENTRAL_ALT else 'local_bank.pt'
+                    p=directory/name;atomic_torch(p,bank);files.append(p)
+                if ema_anchor is not None:
+                    p=directory/'ema_anchor.pt';atomic_torch(p,ema_anchor);files.append(p)
+                metrics.append({'round':r,'accuracy':record['evaluation']['accuracy'],
+                    'gpu_nll':record['evaluation']['loss'],
+                    'evidence':{p.relative_to(out).as_posix():sha256(p) for p in files}})
+                atomic_torch(checkpoint,state(r))
+                if r in anchors: atomic_torch(out/f'probe_round_{r:03d}.pt',state(r))
+                if stop_after is not None and r>=stop_after and r<bundle.cfg['rounds']: break
+            require(frozen_other_digest(bundle.model)==frozen_hash,'other frozen weights changed')
+            complete=metrics[-1]['round']==bundle.cfg['rounds']
+            atomic_json(out/'status.json',{'state':'completed' if complete else 'paused','completed_round':metrics[-1]['round']})
+            if mode=='bridge_full_alt' and bundle.source_path is not None:
+                last=metrics[-1]['round']
+                ref=rt.load_checkpoint(bundle.source_path.parent/f'probe_round_{last:03d}.pt')
+                checks={'adapter':all(torch.equal(v,core.adapter_state(bundle.model)[n]) for n,v in ref['adapter'].items()),
+                        'quality':all(x['accuracy']==y['accuracy'] and x['gpu_nll']==y['loss']
+                                      for x,y in zip(metrics,ref['metrics'])),
+                        'predictions':all(read(out/'rounds'/f'{r:03d}'/'record.json')['evaluation']['predictions']==
+                            read(bundle.source_path.parent/f'predictions_round_{r:03d}.json') for r in range(1,last+1))}
+                atomic_json(out/'parity.json',{'passed':all(checks.values()),'checks':checks})
+                require(all(checks.values()),'full_alt bridge parity failed')
+            return tensor_load(checkpoint)
+        except BaseException:
+            (out/'exception.txt').write_text(traceback.format_exc(),encoding='utf-8')
+            atomic_json(out/'status.json',{'state':'failed'});raise
