+def central_selector(bundle, mode, r, factor, opts):
+    from pcla_repair import core, runtime as rt
+    cfg, shape, q, m = bundle.cfg, bundle.shape, opts.central_layers, bundle.cfg['credits_per_layer']
+    def select(ds):
+        if mode == 'central_full_alt':
+            return torch.ones(shape, dtype=torch.bool), {}
+        if mode == 'central_random_rank':
+            return core.allocate('random', torch.zeros(shape, dtype=torch.float64), q, m,
+                                 core.keyed_seed(bundle.seed, 'allocation', 'random', r, 'central')), {}
+        if mode == 'central_replay_random_rank':
+            donor = torch.tensor(opts.replay_supports[r], dtype=torch.bool)
+            core.check_support(donor, shape, q*m)
+            support = core.allocate('replay_random_rank', torch.zeros(shape, dtype=torch.float64), q, m,
+                                    core.keyed_seed(bundle.seed, 'allocation', 'replay_random_rank', r, 'central'),
+                                    donor=donor)
+            require(torch.equal(support.sum(1), donor.sum(1)), 'central replay changed per-layer quotas')
+            return support, {'donor_record_sha256': opts.replay_record_hashes[r],
+                             'donor_layer_quotas': donor.sum(1).tolist()}
+        state, raw, seconds = opts.utility[factor], None, 0.
+        if state.importance is None or r-state.last_refresh >= cfg['refresh_rounds']:
+            raw, seconds = rt.probe(bundle.model, bundle.layout, ds, factor, cfg['score'],
+                                    core.keyed_seed(bundle.seed, 'probe', r, 'central'), cfg, bundle.device)
+            state.refresh(raw, r, cfg['ema'])
+        scores = state.score(r, cfg['beta'], cfg['gamma'])
+        support = core.allocate('pcla', scores, q, m, core.keyed_seed(bundle.seed, 'allocation', 'pcla', r, 'central'),
+                                visit=state.visits)
+        state.observe(support, r)
+        return support, {'score_refreshed': raw is not None, 'raw_probe_scores': None if raw is None else raw.tolist(),
+                         'scores': scores.tolist(), 'probe_seconds': seconds}
+    return select
+
