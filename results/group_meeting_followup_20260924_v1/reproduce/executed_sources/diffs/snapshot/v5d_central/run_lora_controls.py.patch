+def iid_draw(bundle, selected, r):
+    from pcla_repair.core import keyed_seed
+    population = sorted(bundle.clients)
+    n = sum(len(bundle.clients[c]) for c in selected)
+    size = sum(len(bundle.clients[c]) for c in population)
+    return population, sorted(random.Random(keyed_seed(bundle.seed, 'iid_round', r)).sample(range(size), n))
+
+
+def iid_readout(bundle, selected, population, chosen):
+    from pcla_repair.optimization_dev import dataset_labels
+    owners = [(c, s, int(y)) for c in population for s, y in
+              zip(bundle.partition['clients'][str(c)], dataset_labels(bundle.clients[c]).tolist())]
+    drawn = [owners[i] for i in chosen]
+    cohort = [y for c in selected for y in dataset_labels(bundle.clients[c]).tolist()]
+    return {'sample_multiset_sha256': fingerprint([s for _, s, _ in drawn]), 'iid_sample_count': len(drawn),
+            'iid_positive_fraction': sum(y for *_, y in drawn)/len(drawn),
+            'cohort_positive_fraction': sum(cohort)/len(cohort),
+            'iid_samples_from_cohort': sum(c in selected for c, *_ in drawn),
+            'iid_clients_represented': len({c for c, *_ in drawn})}
+
