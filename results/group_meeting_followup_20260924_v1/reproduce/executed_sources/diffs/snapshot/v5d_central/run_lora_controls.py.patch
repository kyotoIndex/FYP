+def personal_file(mode, seed, ids, labels, readouts, state):
+    rows = [readouts[k] for k in sorted(readouts, key=int)]
+    mean = lambda key: sum(key(x) for x in rows)/len(rows)
+    return {'mode': mode, 'seed': seed, 'state': state, 'test_identity_sha256': fingerprint([ids, labels]),
+            'clients': readouts, 'summary': {'clients': len(rows), 'mean_accuracy': mean(lambda x: x['accuracy']),
+            'mean_balanced_accuracy': mean(lambda x: x['balanced_accuracy']),
+            'mean_majority_accuracy': mean(lambda x: x['majority']['accuracy']),
+            'mean_majority_balanced_accuracy': mean(lambda x: x['majority']['balanced_accuracy'])}}
