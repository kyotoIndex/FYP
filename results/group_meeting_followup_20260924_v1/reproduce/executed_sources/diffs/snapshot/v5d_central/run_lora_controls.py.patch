+def majority(train_labels, test_labels):
+    guess = int(2*sum(train_labels) >= len(train_labels)); present = sorted(set(test_labels))
+    return {'guess': guess, 'accuracy': sum(y == guess for y in test_labels)/len(test_labels),
+            'balanced_accuracy': sum(sum(y == guess for y in test_labels if y == c)/test_labels.count(c)
+                                     for c in present)/len(present)}
