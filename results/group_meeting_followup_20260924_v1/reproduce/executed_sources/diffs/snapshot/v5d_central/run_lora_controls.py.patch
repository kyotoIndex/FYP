+def sign_convention(u, vh):
+    """Flip (U[:,j], V[:,j]) together so the largest-magnitude entry of U[:,j] is nonnegative."""
+    flip = u.gather(0, u.abs().argmax(0, keepdim=True)).squeeze(0) < 0
+    sign = 1-2*flip.to(u.dtype)
+    return u*sign, vh*sign[:, None]
+
+
+def svd_refactor(adapter, base, scalings):
+    """B'=U_r sqrt(S_r), A'=sqrt(S_r) V_r^T of M=BA (float64); s(M-B'A') after the cast goes into base."""
+    out, projections, rows = dict(adapter), {}, []
+    for n, s in scalings.items():
+        b, a = adapter[n+'.lora_b'], adapter[n+'.lora_a']
+        product = b.double()@a.double(); r = a.shape[0]
+        u, values, vh = torch.linalg.svd(product, full_matrices=False)
+        u, vh = sign_convention(u[:, :r], vh[:r]); root = values[:r].sqrt()
+        nb, na = (u*root).to(b.dtype), (root[:, None]*vh).to(a.dtype)
+        projections[n], record = exact_server_correction(base[n], nb, na, s, s*product)
+        out[n+'.lora_b'], out[n+'.lora_a'] = nb, na
+        rows.append({'module': n, 'singular_values': values[:r].tolist(),
+                     'refactor_residual_norm': record['residual_norm'], 'scaled_product_norm': record['target_norm'],
+                     'deployed_error_max_abs': record['deployed_error_max_abs'],
+                     'base_cast_error_max_abs': record['base_cast_error_max_abs']})
+    return out, projections, rows
+
+
+def svd_basis(model):
+    """A <- top-r right singular vectors of W0, scaled to the Frobenius norm of the random A it replaces."""
+    from pcla_repair import core
+    info = {}
+    with torch.no_grad():
+        for n, m in core.lora_modules(model).items():
+            random_a = m.lora_a.detach().cpu().double()
+            u, values, vh = torch.linalg.svd(m.base.weight.detach().cpu().double(), full_matrices=False)
+            u, vh = sign_convention(u[:, :m.rank], vh[:m.rank])
+            m.lora_a.copy_((vh*(random_a.norm()/vh.norm())).to(m.lora_a.dtype))
+            info[n] = {'random_a_frobenius_norm': float(random_a.norm()),
+                       'w0_top_singular_values': values[:m.rank].tolist()}
+    return info
+
+
+def server_update(accumulator, lr):
+    mean = accumulator.finish()
+    if lr == 1:
+        return mean, mean
+    return mean, {n: (b.double()+lr*(accumulator.sums[n]/accumulator.total_weight)).to(b.dtype)
+                  for n, b in accumulator.base.items()}
+
+
+def mean_personal_b(personal):
+    ids = sorted(personal); first = personal[ids[0]]
+    return {k: (sum(personal[c][k].double() for c in ids)/len(ids)).to(v.dtype) for k, v in first.items()}
+
