--- /dev/null
+++ b/selftest.py
@@ -0,0 +1,52 @@
+"""Run the included CPU/integration tests and issue a source-bound report for queue init."""
+from __future__ import annotations
+import argparse
+from pathlib import Path
+import os
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+
+from common import ROOT,atomic_json,source_files,sha256,require,verify_repo
+
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument('--out',required=True,help='new JSON report path; evidence files use the same prefix')
+    a=p.parse_args();out=Path(a.out).resolve()
+    require(not out.exists(),'do not overwrite a test report')
+    out.parent.mkdir(parents=True,exist_ok=True)
+    verify_repo(ROOT/'reference_snapshot')
+    before=source_files(); junit=out.with_suffix('.junit.xml');log=out.with_suffix('.log')
+    require(not junit.exists() and not log.exists(),'report sidecar already exists')
+    env=os.environ.copy()
+    env.update({'OMP_NUM_THREADS':'1','OPENBLAS_NUM_THREADS':'1','MKL_NUM_THREADS':'1',
+                'PYTHONDONTWRITEBYTECODE':'1','NO_COLOR':'1'})
+    command=[sys.executable,'-m','pytest','-q','tests','--ignore=tests/test_artifacts_queue.py',
+             '--color=no',f'--junitxml={junit}']
+    started=time.perf_counter()
+    run=subprocess.run(command,cwd=ROOT,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+    log.write_text(run.stdout,encoding='utf-8')
+    suites=ET.parse(junit).getroot().findall('testsuite') if junit.exists() else []
+    count=sum(int(s.get('tests',0)) for s in suites)
+    failures=sum(int(s.get('failures',0)) for s in suites)
+    errors=sum(int(s.get('errors',0)) for s in suites)
+    skipped=sum(int(s.get('skipped',0)) for s in suites)
+    unchanged=source_files()==before
+    import torch
+    report={'passed':run.returncode==0 and count>0 and failures==0 and errors==0 and skipped==0 and unchanged,
+        'tests_run':count,'failures':failures,'errors':errors,'skipped':skipped,
+        'source_files':before,'source_unchanged_during_tests':unchanged,
+        'reference_source_lock_sha256':sha256(ROOT/'SOURCE_LOCK.json'),
+        'reference_test_scope':'archived actual PCLA runtime, synthetic datasets/models; no real BERT/CUDA',
+        'python':sys.version,'torch':str(torch.__version__),'cuda_available':torch.cuda.is_available(),
+        'wall_seconds':time.perf_counter()-started,'command':command,
+        'log_sha256':sha256(log),'junit_sha256':sha256(junit) if junit.exists() else None,
+        'real_HPC_or_GPU_jobs_started':0}
+    atomic_json(out,report)
+    print(run.stdout,end='')
+    print('Source-bound CPU test report:',out)
+    raise SystemExit(0 if report['passed'] else 1)
+
+if __name__=='__main__':main()
