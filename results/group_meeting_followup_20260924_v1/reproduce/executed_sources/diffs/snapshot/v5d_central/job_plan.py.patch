--- /dev/null
+++ b/job_plan.py
@@ -0,0 +1,33 @@
+"""Five prespecified matched central rank-replay runs; donor is V5a C central PCLA."""
+from __future__ import annotations
+import argparse
+from common import BATCH, SEEDS, atomic_json, require
+
+
+def build():
+    return [dict(id=f'C_central_replay_random_rank_r30_s{seed}', family='lora_control', kind='control',
+                 cell='C', mode='central_replay_random_rank', seed=seed, stage='S1', pool='4090',
+                 depends=[], priority=4, rounds=30, server_lr=1.0, cohort='uniform', ema_readout=.8)
+            for seed in SEEDS]
+
+
+STAGE_DEPENDENCIES={'S1': []}
+DEFAULTS={'rounds':30,'server_lr':1.0,'cohort':'uniform','ema_readout':None}
+
+
+def job_params(job):
+    return {k:job.get(k,v) for k,v in DEFAULTS.items()}
+
+
+def validate(jobs):
+    require(jobs==build(), 'V5d central plan differs from the five prespecified jobs')
+    return True
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--out',required=True);a=p.parse_args();jobs=build();validate(jobs)
+    atomic_json(a.out,{'batch':BATCH,'jobs':jobs,'count':len(jobs),'stage_dependencies':STAGE_DEPENDENCIES,
+                       'gate_type':'integrity_only; no accuracy-based selection'})
+
+
+if __name__=='__main__':main()
