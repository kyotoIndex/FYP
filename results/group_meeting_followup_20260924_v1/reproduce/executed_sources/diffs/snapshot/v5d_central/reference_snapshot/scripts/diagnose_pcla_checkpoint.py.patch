--- /dev/null
+++ b/scripts/diagnose_pcla_checkpoint.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Measure actual one-step gains without using the global benchmark/dev set."""
+import argparse
+import json
+from pathlib import Path
+import sys
+import torch
+REPO=Path(__file__).resolve().parents[1];sys.path.insert(0,str(REPO))
+from pcla_repair.runtime import load_checkpoint,atomic_json
+from pcla_repair.core import load_adapter,tensor_digest,adapter_state
+from pcla_repair.diagnostics import diagnose,summarize_within_layer
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--checkpoint",type=Path,required=True)
+    p.add_argument("--config",default="configs/pcla_repair/decisive.json")
+    p.add_argument("--clients",default="0,10,20,30,40,49")
+    p.add_argument("--layers",default="0,4,8,11")
+    p.add_argument("--factor",choices=["a","b"],required=True)
+    p.add_argument("--repetitions",type=int,default=2)
+    p.add_argument("--device",default="cuda")
+    p.add_argument("--out",type=Path,required=True)
+    args=p.parse_args()
+    if args.out.exists(): raise FileExistsError("diagnostic output already exists")
+    checkpoint=load_checkpoint(args.checkpoint)
+    path=Path(args.config);path=path if path.is_absolute() else REPO/path
+    plan=json.loads(path.read_text(encoding="utf-8"));cfg=plan["training"]
+    from pcla_repair.bridge import prepare
+    seed=checkpoint["identity"]["seed"]
+    model,layout,clients,_,_,provenance,partition=prepare(REPO,plan,seed,torch.device(args.device))
+    for key in ("partition_sha256","initial_loaded_model_sha256","plan_sha256"):
+        if provenance[key]!=checkpoint["identity"]["provenance"][key]:
+            raise ValueError(f"checkpoint identity mismatch: {key}")
+    if cfg != checkpoint["identity"]["config"]:
+        raise ValueError("training protocol changed")
+    if tensor_digest(adapter_state(model))!=checkpoint["identity"]["initial_adapter_sha256"]:
+        raise ValueError("initial adapter identity changed")
+    all_rows=[];groups=[];splits=[]
+    for cid in map(int,args.clients.split(",")):
+        if cid not in clients: raise ValueError(f"unknown client {cid}")
+        for repetition in range(args.repetitions):
+            load_adapter(model,checkpoint["adapter"])
+            rows,split=diagnose(model,layout,clients[cid],cfg,seed*1009+cid,args.factor,
+                                list(map(int,args.layers.split(","))),repetition=repetition)
+            context={"seed":seed,"round":checkpoint["round"],"client":cid,"repetition":repetition,"factor":args.factor}
+            all_rows.extend([{**context,**r} for r in rows])
+            groups.extend([{**context,**r} for r in summarize_within_layer(rows)])
+            source_ids=partition["clients"][str(cid)]
+            splits.append({**context,**{key:[source_ids[i] for i in values] for key,values in split.items()}})
+    atomic_json(args.out,{"source_checkpoint":str(args.checkpoint),"identity_hash":checkpoint["identity_hash"],
+                          "scope":"within-layer, checkpoint-conditioned one-step local gain; not final-test evidence",
+                          "head":"frozen for counterfactual isolation only","rows":all_rows,"groups":groups,"splits":splits})
+
+if __name__=="__main__": main()
