--- /dev/null
+++ b/job_plan.py
@@ -0,0 +1,70 @@
+"""V5a open-question cells, a queue separate from the V4.1/S1 plans; technical smokes do not select favorable results."""
+from __future__ import annotations
+import argparse
+from common import BATCH,SEEDS,atomic_json,require
+
+DEFAULTS={'rounds':30,'server_lr':1.0,'cohort':'uniform','ema_readout':None}
+# (cell, mode, non-default parameters, readable suffix)
+CELLS=(('L1','fed_alt',{'rounds':100,'ema_readout':.8},'r100'),
+       ('L3','fed_both_mean',{'rounds':100,'ema_readout':.8},'r100'),
+       ('T1','fed_alt',{'rounds':100,'server_lr':.5,'ema_readout':.8},'r100_slr05'),
+       ('T2','fed_alt',{'rounds':100,'cohort':'label_stratified','ema_readout':.8},'r100_strat'),
+       ('V1','fed_svd_refactor',{},'r30'),
+       ('V2','alt_svd_refactor',{},'r30'),
+       ('V3','ffa_svd_basis',{},'r30'),
+       ('P3','fed_sa',{},'r30'),
+       ('P4','local_only',{},'e6'),
+       ('C','central_pcla',{'ema_readout':.8},'r30'),
+       ('C','central_random_rank',{'ema_readout':.8},'r30'),
+       ('C','central_full_alt',{'ema_readout':.8},'r30'))
+FED_ALT_FAMILY=('fed_alt','alt_svd_refactor')
+BRIDGE='smoke_bridge_full_alt_s7'
+
+
+def job_params(job):
+    return {k:job.get(k,v) for k,v in DEFAULTS.items()}
+
+
+def build():
+    jobs=[dict(id=BRIDGE,family='lora_control',kind='control',mode='bridge_full_alt',seed=7,
+               stop_after=5,stage='S0',pool='4090',depends=[],priority=1)]
+    for cell,mode,extra,suffix in CELLS:
+        name=f'{cell}_{mode}_{suffix}';params={} if mode=='local_only' else {**DEFAULTS,**extra}
+        smoke='smoke_'+name+'_s7'
+        jobs.append(dict(id=smoke,family='lora_control',kind='control',cell=cell,mode=mode,seed=7,
+                         stop_after=5,stage='S0',pool='technical',depends=[],priority=2,**params))
+        for seed in SEEDS:
+            jobs.append(dict(id=f'{name}_s{seed}',family='lora_control',kind='control',cell=cell,mode=mode,seed=seed,
+                             stage='S1',pool='4090',depends=[smoke]+([BRIDGE] if mode in FED_ALT_FAMILY else []),
+                             priority=3 if params.get('rounds',30)>30 else 4,**params))
+    require(len(jobs)==73 and len({j['id'] for j in jobs})==73,'job inventory differs')
+    return jobs
+
+
+STAGE_DEPENDENCIES={'S0':[],'S1':[]}
+
+
+def validate(jobs):
+    ids={j['id'] for j in jobs};require(len(ids)==len(jobs),'duplicate job IDs')
+    for j in jobs:
+        require(j['stage'] in STAGE_DEPENDENCIES and set(j['depends'])<=ids,'invalid dependencies')
+    visiting,done=set(),set()
+    lookup={j['id']:j for j in jobs}
+    def visit(key):
+        require(key not in visiting,'dependency cycle')
+        if key in done:return
+        visiting.add(key)
+        j=lookup[key]
+        deps=set(j['depends'])|{x['id'] for x in jobs if x['stage'] in STAGE_DEPENDENCIES[j['stage']]}
+        for dep in deps:visit(dep)
+        visiting.remove(key);done.add(key)
+    for key in ids:visit(key)
+    return True
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--out',required=True);a=p.parse_args();jobs=build();validate(jobs)
+    atomic_json(a.out,{'batch':BATCH,'jobs':jobs,'count':len(jobs),'stage_dependencies':STAGE_DEPENDENCIES,
+        'gate_type':'technical_and_integrity_only; no accuracy-threshold selection'})
+
+if __name__=='__main__':main()
