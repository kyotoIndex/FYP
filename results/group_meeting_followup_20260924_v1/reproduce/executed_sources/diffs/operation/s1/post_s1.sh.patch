--- /dev/null
+++ b/operations/s1/post_s1.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+# Materialize queue_s1, re-audit every S1 job independently, then run the pre-registered paired
+# readouts over main + S1 (identity-checked per seed). 4 CPU threads as in the in-job audits.
+set -u
+R=$HPC_HOME/pcla_aggregation_20260923_v41
+PY=$HPC_HOME/pcla_repair_20260918/venv/bin/python
+export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
+cd $R/handoff_s1
+$PY dispatch.py materialize --queue $R/queue_s1 --out $R/materialized_s1 > $R/evidence_s1/materialize_s1.log 2>&1; m=$?
+a=99
+if [ $m -eq 0 ]; then
+  $PY - > $R/evidence_s1/reaudit_s1.log 2>&1 <<PY
+import json,sys
+sys.path.insert(0,'.')
+from pathlib import Path
+from audit_run import audit
+from common import atomic_json
+root=Path('$R/materialized_s1');out=Path('$R/analysis_s1/audits');out.mkdir(parents=True,exist_ok=False)
+plan=json.loads((root/'plan.json').read_text());inv={x['job']:x for x in json.loads((root/'inventory.json').read_text())}
+n=0
+for j in plan['jobs']:
+    assert inv[j['id']]['state']=='completed',j['id']
+    r=audit(root/j['id']/'run','$HPC_HOME/pcla_repair_20260918/repo',require_complete=not bool(j.get('stop_after')))
+    atomic_json(out/(j['id']+'.json'),r);n+=1
+print(json.dumps({'reaudited':n}))
+PY
+  a=$?
+fi
+I=$R/analysis_extra_r2_inputs
+rm -rf $R/analysis_extra_main_s1
+$PY $I/extra_readouts_v2.py --materialized $R/materialized_r2 $R/materialized_s1 --out $R/analysis_extra_main_s1 \
+   --v3-rounds $I/per_round.csv --cohort $I/cohort_label_share.csv > $R/evidence_s1/extra_main_s1.log 2>&1; e=$?
+printf '{"materialize_exit":%d,"reaudit_exit":%d,"extra_exit":%d,"threads":4,"host":"%s","step":"%s.%s"}\n' \
+  $m $a $e "$(hostname)" "${SLURM_JOB_ID:-}" "${SLURM_STEP_ID:-}" > $R/evidence_s1/POST_S1_DONE.json
