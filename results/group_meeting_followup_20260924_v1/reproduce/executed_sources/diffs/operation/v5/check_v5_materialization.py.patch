--- /dev/null
+++ b/operations/v5/check_v5_materialization.py
@@ -0,0 +1,108 @@
+"""Cross-check the three frozen V5 queues against their extracted results."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+import math
+from pathlib import Path
+
+
+def load(path: Path) -> object:
+    return json.loads(path.read_text())
+
+
+def sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def run(root: Path) -> dict:
+    queues: dict[str, dict] = {}
+    failures: list[str] = []
+    for tag in "abc":
+        queue = root / f"queue_v5{tag}"
+        extracted = root / f"materialized_v5{tag}"
+        frozen = load(queue / "FROZEN.json")
+        plan = load(extracted / "plan.json")
+        inventory = load(extracted / "inventory.json")
+        jobs = {job["id"]: job for job in frozen["jobs"]}
+        if frozen != plan:
+            failures.append(f"{tag}: extracted plan differs from frozen queue")
+        if set(jobs) != {entry["job"] for entry in inventory}:
+            failures.append(f"{tag}: inventory job IDs differ from plan")
+        kind_counts: Counter[str] = Counter()
+        formal_count = 0
+        for entry in inventory:
+            job_id = entry["job"]
+            job = jobs[job_id]
+            folder = extracted / job_id
+            status = load(queue / "status" / f"{job_id}.json")
+            receipt_path = Path(status["receipt"])
+            receipt = load(folder / "receipt.json")
+            audit = load(folder / "audit.json")
+            actual_job = load(folder / "job.json")
+            extraction = load(folder / "EXTRACTION_RECEIPT.json")
+            technical = job_id.startswith(("smoke_", "parity_"))
+            if not technical:
+                formal_count += 1
+            kind_counts[str(audit.get("kind"))] += 1
+            if entry["state"] != "completed" or status["state"] != "completed":
+                failures.append(f"{tag}/{job_id}: incomplete queue status")
+            if receipt["state"] != "completed" or receipt["exit_code"] != 0:
+                failures.append(f"{tag}/{job_id}: bad receipt")
+            if actual_job != job or receipt["job"] != job:
+                failures.append(f"{tag}/{job_id}: job differs from frozen plan")
+            if sha256(receipt_path) != status["receipt_sha256"]:
+                failures.append(f"{tag}/{job_id}: receipt hash mismatch")
+            if receipt["source_files"] != frozen["source_files"]:
+                failures.append(f"{tag}/{job_id}: source-file hashes differ")
+            if len(extraction["archive_sha256"]) != 64:
+                failures.append(f"{tag}/{job_id}: extraction hash missing")
+            if not technical and audit.get("complete") is not True:
+                failures.append(f"{tag}/{job_id}: formal audit incomplete")
+            rows = audit.get("rows", [])
+            if audit.get("kind") == "personal_eval" or (job.get("cell") == "P4" and not technical):
+                expected_rows = 50
+            else:
+                expected_rows = job.get("stop_after", job.get("rounds"))
+            if expected_rows is not None and len(rows) != expected_rows:
+                failures.append(f"{tag}/{job_id}: {len(rows)} rows, expected {expected_rows}")
+            if not technical and job["family"] != "personal" and job.get("cell") != "P4":
+                if len(rows) != 30 and not (job.get("rounds") == 100 and len(rows) == 100):
+                    failures.append(f"{tag}/{job_id}: unexpected formal round count")
+                for row in rows:
+                    value = row.get("accuracy")
+                    if not isinstance(value, (int, float)) or not math.isfinite(value) or not 0 <= value <= 1:
+                        failures.append(f"{tag}/{job_id}: invalid accuracy")
+                        break
+        queues[tag] = {
+            "planned": len(jobs),
+            "completed": len(inventory),
+            "formal": formal_count,
+            "technical": len(inventory) - formal_count,
+            "kinds": dict(kind_counts),
+        }
+    return {"passed": not failures, "queues": queues, "failures": failures}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    report = run(args.root)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+    print(json.dumps({"passed": report["passed"], "queues": report["queues"],
+                      "failures": report["failures"][:10]}, ensure_ascii=False))
+    raise SystemExit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
