+def audit_fedex_bank(bank,agg,a,participants):
+    from pcla_repair.core import tensor_digest
+    require([c['client'] for c in bank['clients']]==participants,'bank clients differ')
+    require(tensor_digest(bank['parent'])==a['parent_adapter_sha256'] and tensor_digest(bank['post'])==a['post_adapter_sha256'],
+            'bank states differ from round record')
+    clients=[c['state'] for c in bank['clients']];eps=torch.finfo(torch.float32).eps
+    require(all(set(c)==set(bank['parent'])==set(bank['post']) for c in clients),'bank key inventory differs')
+    for k,v in bank['post'].items():
+        stack=torch.stack([c[k].double() for c in clients])
+        if agg=='ffa' and 'lora_A' in k:
+            require(torch.equal(v,bank['parent'][k]) and all(torch.equal(c[k],v) for c in clients),'FFA shared A changed')
+        else:
+            require(float((v.double()-stack.mean(0)).abs().max())<=16*eps*max(1.,float(stack.abs().max())),
+                    'aggregated tensor is not the client mean: '+k)
+    if agg in ('normal','ffa'):
+        require(not bank['base_delta'],'unexpected base update');return None
+    s=bank['scaling'];distinguishable=0
+    for n in bank['modules']:
+        A=torch.stack([c[n+'.lora_A.default.weight'].double() for c in clients])
+        B=torch.stack([c[n+'.lora_B.default.weight'].double() for c in clients])
+        M=(B@A).mean(0);R=s*(M-B.mean(0)@A.mean(0));want,alt=(R.T,R) if agg=='ours' else (R,R.T)
+        tol=64*eps*max(1.,bank['base_parent_maxabs'][n],s*float(M.abs().max()));d=bank['base_delta'][n].double()
+        require(float((d-want).abs().max())<=tol,'base residual does not follow '+agg+': '+n)
+        if float((want-alt).abs().max())>10*tol:
+            require(float((d-alt).abs().max())>tol,'residual orientation not identifiable');distinguishable+=1
+    return {'modules':len(bank['modules']),'orientation_distinguishable':distinguishable}
