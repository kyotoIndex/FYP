+"""Personalization readouts of frozen final global models: P0 majority, P1 global model, P2 one local epoch per client."""
+from __future__ import annotations
+from collections import namedtuple
+import copy
+import math
+import os
+from pathlib import Path
+import random
+import time
+import traceback
+
+import torch
+from torch.utils.data import Subset
+from common import require, read, atomic_json, atomic_torch, tensor_load, fingerprint, sha256, exclusive
+from context import base_study, write_evaluation_identity
+from job_plan import PERSONAL_SOURCES
+from run_lora_controls import projection_state, load_projections
+
+FORMAT = 'pcla-personal-v5c'
+CONTROL_FORMAT = 'pcla-control-v4.1'
+SYNTHETIC_TESTS = 16
+LocalTests = namedtuple('LocalTests', 'provider ids labels datasets baseline')
+
+
+def majority(train_labels, test_labels):
+    """Same rule as personal_split.majority_baseline, for label lists already resolved."""
+    per = {}
+    for k, ys in train_labels.items():
+        guess = int(sum(ys)*2 >= len(ys)); t = test_labels[k]
+        present = sorted(set(t))
+        per[k] = {'accuracy': sum(y == guess for y in t)/len(t),
+                  'balanced_accuracy': sum(sum(y == guess for y in t if y == c)/sum(1 for y in t if y == c)
+                                           for c in present)/len(present), 'guess': guess}
+    return per
+
+
+def synthetic_local_ids(partition, seed, n=SYNTHETIC_TESTS):
+    """Synthetic stand-in for personal_split: per-client draws matching the client's label proportion."""
+    from pcla_repair.core import keyed_seed
+    from pcla_repair.testing import TinyDataset
+    ids, labels = {}, {}
+    for k in sorted(partition['clients'], key=int):
+        train = TinyDataset(100+int(k), len(partition['clients'][k])).y.tolist()
+        pool = TinyDataset(300+int(k), 4*n).y.tolist()
+        pos = round(n*sum(train)/len(train)); rng = random.Random(keyed_seed(seed, 'synthetic_personal_test', int(k)))
+        chosen = []
+        for y, m in ((1, pos), (0, n-pos)):
+            candidates = [i for i, v in enumerate(pool) if v == y]
+            require(len(candidates) >= m, 'synthetic personal pool exhausted')
+            chosen += sorted(rng.sample(candidates, m))
+        ids[k] = [f'synthetic_personal:{k}:{i}' for i in chosen]; labels[k] = [pool[i] for i in chosen]
+    return ids, labels
+
+
+def synthetic_local_tests(bundle):
+    from pcla_repair.testing import TinyDataset
+    from pcla_repair.optimization_dev import dataset_labels
+    ids, labels = synthetic_local_ids(bundle.partition, bundle.seed)
+    datasets = {int(k): Subset(TinyDataset(300+int(k), 4*SYNTHETIC_TESTS), [int(x.split(':')[2]) for x in v])
+                for k, v in ids.items()}
+    train = {str(c): dataset_labels(ds).tolist() for c, ds in bundle.clients.items()}
+    return LocalTests('synthetic', ids, labels, datasets, majority(train, labels))
+
+
+def real_local_tests(bundle, repo):
+    import personal_split
+    from pcla_repair.bridge import checked_legacy
+    from transformers import AutoTokenizer
+    ids, labels = personal_split.local_test_ids(bundle.partition, bundle.seed, repo)
+    baseline = personal_split.majority_baseline(bundle.partition, repo, labels)
+    ds = bundle.provenance['base_config']['dataset']; repo = Path(repo)
+    path = Path(ds['train_file']); path = path if path.is_absolute() else repo/path
+    require(sha256(path) == bundle.provenance['train_file_sha256'], 'train TSV changed')
+    legacy = checked_legacy(repo); rows = legacy.read_text_rows(path, ds); csv_rows = personal_split.train_rows(repo)
+    reference = str(repo/ds['model']) if (repo/ds['model']).is_dir() else ds['model']
+    tokenizer = AutoTokenizer.from_pretrained(reference, local_files_only=ds.get('local_files_only', True))
+    datasets = {}
+    for k, v in ids.items():
+        index = [int(x.split(':')[1]) for x in v]
+        require([legacy.row_label(rows[i]) for i in index] == labels[k] and
+                all(legacy.row_texts(rows[i])[0].strip() == csv_rows[i][0].strip() for i in index),
+                'personal test rows differ between legacy and TSV readers')
+        datasets[int(k)] = legacy.TextClassificationDataset([rows[i] for i in index], tokenizer, ds['max_length'])
+    return LocalTests('personal_split', ids, labels, datasets, baseline)
+
+
+def local_tests(bundle, repo):
+    return synthetic_local_tests(bundle) if bundle.synthetic else real_local_tests(bundle, repo)
+
+
+def validate_control_checkpoint(path, mode, seed):
+    path = Path(path); cp = tensor_load(path); identity = cp['identity']
+    require(cp.get('format') == CONTROL_FORMAT and fingerprint(identity) == cp['identity_hash'], 'control checkpoint identity invalid')
+    require(identity['mode'] == mode and identity['seed'] == seed and cp['round'] == identity['config']['rounds'] and
+            [m['round'] for m in cp['metrics']] == list(range(1, cp['round']+1)), 'control checkpoint incomplete or wrong cell')
+    report = read(path.parent.parent/'audit.json')
+    require(report['complete'] is True and report['kind'] == 'lora_control' and report['mode'] == mode and
+            report['identity_hash'] == cp['identity_hash'] and report['checkpoint_sha256'] == sha256(path),
+            'control checkpoint lacks a matching complete audit')
+    return cp
+
+
+def load_input(bundle, source, path, study):
+    """Validate a frozen final global model against the same-seed bundle; return its state and own final dev readout."""
+    from pcla_repair import core, runtime as rt
+    path = Path(path); name = PERSONAL_SOURCES[source][1]
+    if source.startswith('old_'):
+        cp = rt.load_checkpoint(path); identity = cp['identity']
+        require(cp['policy'] == name and cp['round'] == identity['config']['rounds'] and identity['seed'] == bundle.seed and
+                cp['identity_hash'] == rt.fingerprint(identity), 'original checkpoint incomplete or wrong cell')
+        require(bundle.source_path is not None and Path(bundle.source_path).resolve() == path.resolve(),
+                'bundle was not prepared from this original checkpoint')
+        require(identity['config'] == bundle.cfg and identity['initial_adapter_sha256'] == study['initial_adapter_sha256'] and
+                identity['provenance']['partition_sha256'] == study['partition_sha256'], 'original checkpoint differs from bundle')
+        r = cp['round']; p = path.parent/f'predictions_round_{r:03d}.json'
+        reference = {'accuracy': cp['metrics'][-1]['accuracy'], 'loss': cp['metrics'][-1]['loss'],
+                     'predictions': read(p), 'file': p.name, 'file_sha256': sha256(p)}
+        return {'adapter': cp['adapter'], 'projections': None, 'identity_hash': cp['identity_hash'],
+                'format': cp['format'], 'round': r, 'reference': reference}
+    cp = validate_control_checkpoint(path, name, bundle.seed); identity = cp['identity']
+    require(identity['config'] == bundle.cfg and identity['synthetic'] == bundle.synthetic and
+            identity['partition_sha256'] == study['partition_sha256'] and
+            identity['initial_adapter_sha256'] == study['initial_adapter_sha256'] and
+            identity['initial_projections_sha256'] == core.tensor_digest(projection_state(bundle.model)) and
+            identity['source_original_identity'] == study['source_original_identity'], 'control checkpoint differs from bundle')
+    r = cp['round']; rel = f'rounds/{r:03d}/record.json'
+    require(sha256(path.parent/rel) == cp['metrics'][-1]['evidence'][rel], 'control final record changed')
+    ev = read(path.parent/rel)['evaluation']
+    reference = {k: ev[k] for k in ('accuracy', 'loss', 'predictions', 'logits')} | {'file': rel, 'file_sha256': sha256(path.parent/rel)}
+    return {'adapter': cp['adapter'], 'projections': cp['projections'], 'identity_hash': cp['identity_hash'],
+            'format': cp['format'], 'round': r, 'reference': reference}
+
+
+def items(clients, finetune):
+    return [['dev', None]]+[['p1', c] for c in clients]+([['p2', c] for c in clients] if finetune else [])
+
+
+def item_file(item):
+    return 'dev_check.json' if item[0] == 'dev' else f'clients/{item[1]:03d}/{item[0]}.json'
+
+
+def dev_check(evaluation, reference):
+    checks = {'predictions': evaluation['predictions'] == reference['predictions'],
+              'accuracy': evaluation['accuracy'] == reference['accuracy'],
+              'loss': abs(evaluation['loss']-reference['loss']) <= 1e-6*max(1., abs(reference['loss']))}
+    extra = {}
+    if 'logits' in reference:
+        extra['logits_max_abs_difference'] = max(abs(a-b) for x, y in zip(evaluation['logits'], reference['logits']) for a, b in zip(x, y))
+    return {'passed': all(checks.values()), 'checks': checks, **extra}
+
+
+def summarize(tests, stats, finetune, complete):
+    clients = {}
+    for k in sorted(tests['ids'], key=int):
+        row = {'test_ids_sha256': fingerprint(tests['ids'][k]), 'test_samples': len(tests['ids'][k]),
+               'test_positive': sum(tests['labels'][k]), 'P0': tests['baseline'][k]}
+        for phase in ('p1', 'p2'):
+            s = stats.get((phase, int(k)))
+            row[phase.upper()] = None if s is None else {'accuracy': s['accuracy'], 'balanced_accuracy': s['balanced_accuracy']}
+        clients[k] = row
+    macro = {}
+    for p in ('P0', 'P1', 'P2'):
+        values = [row[p] for row in clients.values() if row[p] is not None]
+        macro[p] = None
+        if values and len(values) == len(clients):
+            macro[p] = {m: math.fsum(v[m] for v in values)/len(values) for m in ('accuracy', 'balanced_accuracy')}
+    return {'complete': complete, 'finetune': finetune, 'clients': clients, 'macro': macro,
+            'macro_definition': 'unweighted mean over clients; every client has the same local test size'}
+
+
+def run_bundle(bundle, out, source, input_path, finetune, tests, stop_after=None, resume=False, recovery_reason=None):
+    from pcla_repair import core, runtime as rt
+    require(source in PERSONAL_SOURCES, 'unknown personal source')
+    out = Path(out); require(not out.exists() or resume, 'use new output directory')
+    out.mkdir(parents=True, exist_ok=True)
+    study = base_study(bundle); clients = sorted(bundle.clients); cfg = bundle.cfg
+    require(sorted(map(int, tests.ids)) == clients and set(tests.labels) == set(tests.ids) == set(tests.baseline),
+            'local tests do not cover every client')
+    glob = load_input(bundle, source, input_path, study)
+    projections = glob['projections'] if glob['projections'] is not None else projection_state(bundle.model)
+    local = {'provider': tests.provider, 'ids': tests.ids, 'labels': tests.labels, 'baseline': tests.baseline}
+    identity = {**study, 'kind': 'personal_eval', 'source': source, 'finetune': bool(finetune),
+                'config': cfg, 'provenance': bundle.provenance,
+                'bundle_source_path': str(bundle.source_path) if bundle.source_path else None,
+                'input': {'path': str(input_path), 'sha256': sha256(input_path), 'identity_hash': glob['identity_hash'],
+                          'format': glob['format'], 'round': glob['round']},
+                'global_adapter_sha256': core.tensor_digest(glob['adapter']),
+                'global_projections_sha256': core.tensor_digest(projections),
+                'local_tests_sha256': fingerprint(local),
+                'finetune_recipe': {'trained': 'all LoRA A/B ranks and classifier head', 'optimizer': 'new AdamW per client from cfg',
+                                    'start': 'final global model for every client', 'epochs': cfg['local_epochs'],
+                                    'batch_size': cfg['batch_size'], 'seed_key': ['personal_ft', 'client'],
+                                    'routine': 'pcla_repair.runtime.local_train'} if finetune else None}
+    identifier = fingerprint(identity); checkpoint = out/'checkpoint.pt'; plan = items(clients, finetune)
+    full = torch.ones(bundle.shape, dtype=torch.bool); completed = []
+
+    def install():
+        core.load_adapter(bundle.model, glob['adapter']); load_projections(bundle.model, projections)
+
+    with exclusive(out/'.run.lock', {'identity_hash': identifier}):
+        if resume:
+            require(recovery_reason and checkpoint.exists(), 'resume requires checkpoint and reason')
+            cp = tensor_load(checkpoint); require(cp['identity_hash'] == identifier, 'resume identity differs')
+            completed = cp['completed']
+            for x in completed:
+                for rel, h in x['evidence'].items(): require(sha256(out/rel) == h, 'committed record changed')
+            done = {item_file(x['item']) for x in completed}
+            for item in plan:
+                p = out/item_file(item)
+                if p.exists() and item_file(item) not in done:
+                    dest = out/'recovery'/str(time.time_ns())/item_file(item); dest.parent.mkdir(parents=True, exist_ok=True)
+                    p.rename(dest)
+        else:
+            atomic_json(out/'study.json', {'kind': 'personal_eval', 'identity': identity, 'identity_hash': identifier})
+            write_evaluation_identity(out, bundle)
+            atomic_json(out/'local_tests.json', local)
+        attempts_path = out/'execution_attempts.json'
+        attempts = read(attempts_path) if attempts_path.exists() else []
+        attempts.append({'pid': os.getpid(), 'host': os.uname().nodename, 'start_item': len(completed),
+                         'reason': recovery_reason, 'time': time.time()})
+        atomic_json(attempts_path, attempts)
+
+        def commit():
+            atomic_torch(checkpoint, {'format': FORMAT, 'identity': identity, 'identity_hash': identifier,
+                                      'completed': copy.deepcopy(completed)})
+        try:
+            if not completed: commit()
+            p2_done = sum(x['item'][0] == 'p2' for x in completed)
+            for item in plan[len(completed):]:
+                if stop_after is not None and item[0] == 'p2' and p2_done >= stop_after: break
+                install(); phase, c = item; path = out/item_file(item)
