+def close(a,b,tol=1e-12):
+    if isinstance(a,dict):return isinstance(b,dict) and set(a)==set(b) and all(close(a[k],b[k],tol) for k in a)
+    if isinstance(a,(list,tuple)):return isinstance(b,(list,tuple)) and len(a)==len(b) and all(close(x,y,tol) for x,y in zip(a,b))
+    if isinstance(a,float) or isinstance(b,float):return a is not None and b is not None and abs(a-b)<=tol
