+def module_layers(names):
+    import re
+    layers={}
+    for n in names:
+        match=re.search(r'(?:layer|blocks)\.(\d+)\.',n);require(match is not None,'cannot resolve layer identity')
+        layers[n]=int(match.group(1))
+    return layers
