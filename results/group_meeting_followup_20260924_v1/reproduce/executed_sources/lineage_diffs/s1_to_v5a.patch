+def svd_sign_ok(b,values):
+    top=float(values[0]) if len(values) else 0.
+    return all(float(b[:,j].max())>=float(-b[:,j].min())*(1-1e-6) for j in range(b.shape[1]) if float(values[j])>1e-9*top)
