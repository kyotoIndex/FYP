+def train_rows(repo):
+    with (Path(repo) / 'data/SST-2/train.tsv').open(encoding='utf-8-sig', newline='') as f:
+        return [(r['sentence'], int(r['label'])) for r in csv.DictReader(f, delimiter='\t')]
+
