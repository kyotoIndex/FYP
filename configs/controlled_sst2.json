{
  "name": "fedhello_core_controlled_sst2",
  "stage": "mechanism_reproduction",
  "dataset": {
    "name": "SST-2",
    "train_file": "data/SST-2/train.tsv",
    "dev_file": "data/SST-2/dev.tsv",
    "model": "prajjwal1/bert-mini",
    "local_files_only": true,
    "num_labels": 2,
    "max_length": 64,
    "metric": "accuracy",
    "eval_samples": 552
  },
  "federated": {
    "seeds": [7, 13, 21],
    "total_clients": 5,
    "selected_clients": 5,
    "samples_per_client": 512,
    "rounds": 12,
    "local_epochs": 1,
    "batch_size": 32,
    "eval_batch_size": 64,
    "learning_rate": 0.001,
    "client_selection": "all_clients"
  },
  "lora": {
    "target_modules": ["query", "value"],
    "rank": 16,
    "alpha": 16.0,
    "dropout": 0.1,
    "num_encoder_layers": 4
  },
  "resource_heterogeneity": {
    "capability_names": ["low", "medium", "high"],
    "layer_fractions": [0.5, 0.75, 1.0],
    "client_ratio": [0.6, 0.3, 0.1],
    "compute_factors": [1.8, 1.2, 0.7],
    "communication_factors": [1.3, 1.0, 0.8],
    "communication_time_per_mb": 1.5
  },
  "fedhello": {
    "importance_score": "fim_gradient_norm",
    "importance_source": "server_proxy",
    "proxy_samples": 320,
    "proxy_batch_size": 16,
    "proxy_batches": 8,
    "allocation": "probability_clustered_sampling_without_replacement",
    "random_seeded_allocation": true,
    "resource_levels_sorted_ascending": true,
    "rgd_pattern": "bottleneck",
    "rgd_hla_rounds": 1,
    "fim_update_interval": 1,
    "combined_schedule": "rgd_then_periodic_fim"
  },
  "baselines": [
    "fedlora",
    "resource_only",
    "fedra_random_partial",
    "fim_hla",
    "gd_hla_triangle",
    "gd_hla_inverted_triangle",
    "gd_hla_bottleneck",
    "gd_hla_uniform",
    "rgd_hla",
    "fedhello"
  ],
  "metrics": [
    "accuracy",
    "round_time",
    "cumulative_time",
    "round_comm_mb",
    "cumulative_comm_mb",
    "avg_waiting_time",
    "active_layers_per_client",
    "trainable_parameters_per_client"
  ],
  "target_accuracy": 0.7,
  "output_dir": "results/controlled_sst2"
}
