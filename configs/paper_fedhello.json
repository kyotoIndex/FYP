{
  "name": "fedhello_paper_protocol",
  "paper": {
    "title": "Fed-HeLLo: Efficient Federated Foundation Model Fine-Tuning with Heterogeneous LoRA Allocation",
    "arxiv": "2506.12213v1",
    "official_repository": "https://github.com/TNI-playground/Fed_HeLLo"
  },
  "common": {
    "client_selection": "uniform_random",
    "local_epochs": 1,
    "lora_target_modules": ["query", "value"],
    "lora_alpha": 16,
    "lora_dropout": 0.1,
    "resource_capabilities_as_layer_fraction": [0.5, 0.75, 1.0],
    "resource_ratios": {
      "6_3_1": [0.6, 0.3, 0.1],
      "1_1_1": [0.3333333333, 0.3333333333, 0.3333333333]
    },
    "hla_methods": ["straggler", "exclusive", "fedra", "fim_hla", "rgd_hla", "fedhello"],
    "geometric_patterns": ["triangle", "inverted_triangle", "bottleneck", "uniform"],
    "metrics": ["model_metric", "backward_compute_tflops", "memory_gb", "communication_mb_per_round", "training_time_sec_per_round"]
  },
  "classification": {
    "datasets": {
      "cifar100": {
        "model": "google/vit-base-patch16-224",
        "metric": "top1_accuracy",
        "total_clients": 100,
        "selected_clients": 10,
        "rounds": 500,
        "lora_rank": 16,
        "batch_size": 128,
        "proxy_samples_excluded_from_test": 100
      },
      "domainnet121": {
        "model": "google/vit-base-patch16-224",
        "metric": "top1_accuracy",
        "total_clients": 100,
        "selected_clients": 10,
        "rounds": 500,
        "lora_rank": 16,
        "batch_size": 32,
        "proxy_samples_excluded_from_test": 1000
      },
      "ledgar": {
        "model": "bert-base-uncased",
        "metric": "macro_f1",
        "total_clients": 100,
        "selected_clients": 10,
        "rounds": 500,
        "lora_rank": 16,
        "batch_size": 128,
        "proxy_samples_excluded_from_test": 50
      }
    },
    "data_settings": ["iid", "20_1.0", "10_1.0"],
    "fedhello_schedule": {
      "t_rgd": 50,
      "t_fim": 50
    },
    "fim_hla_schedule": {
      "t_rgd": 0,
      "t_fim": 1
    }
  },
  "instruction_tuning": {
    "datasets": {
      "natural_instruction": {
        "model": "DataJuicer-1B",
        "metric": "rouge_l",
        "total_clients": 50,
        "selected_clients": 10,
        "rounds": 25,
        "lora_rank": 8,
        "batch_size": 1,
        "proxy_samples_excluded_from_test": 50
      },
      "dolly_15k": {
        "model": "facebook/opt-1.3b",
        "metric": "rouge_l",
        "total_clients": 50,
        "selected_clients": 10,
        "rounds": 25,
        "lora_rank": 8,
        "batch_size": 1,
        "proxy_samples_excluded_from_test": 50
      }
    },
    "fedhello_schedule": {
      "t_rgd": 1,
      "t_fim": 2
    },
    "fim_hla_schedule": {
      "t_rgd": 0,
      "t_fim": 1
    }
  }
}
